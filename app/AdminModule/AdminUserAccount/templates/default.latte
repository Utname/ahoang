{block content}

<div class="col-md-6">
	<div class="panel panel-white">
		{form editAccountForm}
			<div class="panel-heading">
				<h3 class="panel-title">{_admin.account.title}</h3>
			</div>
			<div class="panel-body">
				<div class="row">
					<div class="col-sm-6">
						<div class="form-group">
							{label name /}
							{input name class => 'form-control'}
						</div>
						<div class="form-group">
							{label email /}
							{input email class => 'form-control'}
						</div>
						<div class="form-group-btns b-t p-v-sm clearfix">
							<button n:name="submit" class="btn btn-success btn-addon m-r-xs">
								<i class="far fa-check"></i> {_admin.account.button}
							</button>
						</div>
					</div>
				</div>
			</div>
		{/form}
	</div>
</div>

<div class="col-md-6">
	<div class="panel panel-white">
		{form editPasswordForm}
			<div class="panel-heading">
				<h3 class="panel-title">{_admin.changePassword.title}</h3>
			</div>
			<div class="panel-body">
				<div class="row">
					<div class="col-sm-6">
						<div class="form-group">
							{label old_password /}
							{input old_password class => 'form-control'}
						</div>
						<div class="form-group">
							{label new_password /}
							{input new_password class => 'form-control'}
						</div>
						<div class="form-group">
							{label new_password_verify /}
							{input new_password_verify class => 'form-control'}
						</div>
						<div class="form-group-btns b-t p-v-sm clearfix">
							<button n:name="submit" class="btn btn-success btn-addon m-r-xs">
								<i class="far fa-check"></i> {_admin.changePassword.button}
							</button>
						</div>
					</div>
				</div>
			</div>
		{/form}
	</div>
</div>