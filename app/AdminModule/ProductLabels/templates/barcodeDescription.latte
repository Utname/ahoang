<html>
    <head>
        <script n:if="!empty($windowClose)">
	        window.close();
        </script>
        <style>
            body { margin: 0; }

            .container-1 { margin: 14px 12px 14px 12px; width: calc(100% - 24px); height: calc(100% - 28px); display: inline-block; }
            .overlay-1 { border: 0; width: calc(33.333% - 18px); height: calc(16.666% - 12.5px); margin: 6px 6px 5.5px 6px; float: left; font-family: "Times New Roman", serif; font-weight: 500; text-align: left; display: inline-block; font-size: 11px; overflow: hidden; position: relative; }
            .overlay-1:nth-child(3n+1) { margin-right: 15px; }
			.overlay-1:nth-child(3n+3) { margin-left: 15px; }
            .overlay-1 .bottom-info-left { position: absolute; bottom: 0; left: 0; width: 100%; font-size: 9px; font-weight: 600; text-align: left; }
            .overlay-1 .bottom-info-right { position: absolute; bottom: 0; right: 0; width: 100%; font-size: 9px; font-weight: 600; text-align: right; }

            .overlay-2 { width: 182px; font-family: "Arial", serif; font-weight: 400; text-align: left; height: 125px; overflow: hidden; font-size: 8px; padding: 4px 8px; }

			.container-3 { margin: 49px 32px 44px 32px; width: calc(100% - 64px); height: calc(100% - 93px); display: inline-block; }
			.overlay-3 { border: 0; width: calc(33.333% - 18px); height: calc(12.5% - 12.5px); margin: 6px 6px 5.5px 6px; float: left; font-family: "Times New Roman", serif; font-weight: 500; text-align: left; display: inline-block; font-size: 10px; overflow: hidden; position: relative; }
			.overlay-3:nth-child(3n+1) { margin-right: 15px; }
			.overlay-3:nth-child(3n+3) { margin-left: 15px; }
			.overlay-3 .bottom-info-left { position: absolute; bottom: 0; left: 0; width: 100%; font-size: 9px; font-weight: 600; text-align: left; }
			.overlay-3 .bottom-info-right { position: absolute; bottom: 0; right: 0; width: 100%; font-size: 9px; font-weight: 600; text-align: right; }
        </style>
    </head>
    <body>
        {if $type == App\AdminModule\Presenters\ProductLabelsPresenter::TYPE_DESCRIPTION_1}
            {var $iter = 0}
            {foreach $presenter->getBarcodeDescriptionsList($type, TRUE) as $item}
                {var $itemData = $item->getData()}
                {var $itemDataDescription = $itemData->description ?? ''}
                {var $itemDataDescriptionCount = mb_strlen($itemDataDescription)}
                {var $itemLeftBottomData = []}
                {if $itemData->consumption}{var $itemLeftBottomData[] = $itemData->consumption}{/if}
                {if $itemData->isSeller}{var $itemLeftBottomData[] = 'Prodávající: Fikko market'}{/if}
                {if $itemData->productEan}{var $itemLeftBottomData[] = 'EAN: '.$itemData->productEan}{/if}

                {if $itemCount = ($itemData->count ?? 0)}
                    {for $i=1;$i<=$itemCount;$i++}
                        {var $iter = $iter + 1}
                        {if $iter % 18 == 1}<div class="container-1">{/if}
                            <div class="overlay-1"{if $itemDataDescriptionCount > 600} style="font-size: 8px;"{elseif $itemDataDescriptionCount > 400} style="font-size: 9px;"{/if}>
                                {if $itemData->productName}<strong>{$itemData->productName}</strong><br>{/if}
                                {$itemDataDescription}
                                <div n:if="count($itemLeftBottomData)" class="bottom-info-left">
                                    {foreach $itemLeftBottomData as $itemLeftBottomDataI}
                                        {$itemLeftBottomDataI}
                                        {sep}<br>{/sep}
                                    {/foreach}
                                </div>
                                <div n:if="$itemData->productCountry" class="bottom-info-right">
                                    Země původu: {$itemData->productCountry}
                                </div>
                            </div>
                        {if $iter % 18 == 0 || ($iterator->last && $i == $itemCount)}</div>{/if}
                    {/for}
                {/if}
            {/foreach}
        {elseif $type == App\AdminModule\Presenters\ProductLabelsPresenter::TYPE_DESCRIPTION_3}
            {var $iter = 0}
            {foreach $presenter->getBarcodeDescriptionsList($type, TRUE) as $item}
                {var $itemData = $item->getData()}
                {var $itemDataDescription = $itemData->description ?? ''}
                {var $itemDataDescriptionCount = mb_strlen($itemDataDescription)}
                {var $itemLeftBottomData = []}
                {if $itemData->consumption}{var $itemLeftBottomData[] = $itemData->consumption}{/if}
                {if $itemData->isSeller}{var $itemLeftBottomData[] = 'Prodávající: Fikko market'}{/if}
                {if $itemData->productEan}{var $itemLeftBottomData[] = 'EAN: '.$itemData->productEan}{/if}

                {if $itemCount = ($itemData->count ?? 0)}
                    {for $i=1;$i<=$itemCount;$i++}
                        {var $iter = $iter + 1}
                        {if $iter % 24 == 1}<div class="container-3">{/if}
                        <div class="overlay-3"{if $itemDataDescriptionCount > 600} style="font-size: 6px;"{elseif $itemDataDescriptionCount > 400} style="font-size: 7px;"{elseif $itemDataDescriptionCount > 300} style="font-size: 8px;"{/if}>
                            {if $itemData->productName}<strong>{$itemData->productName}</strong><br>{/if}
                                {$itemData->description ?? ''}
                            <div n:if="count($itemLeftBottomData)" class="bottom-info-left">
                                {foreach $itemLeftBottomData as $itemLeftBottomDataI}
                                    {$itemLeftBottomDataI}
                                    {sep}<br>{/sep}
                                {/foreach}
                            </div>
                            <div n:if="$itemData->productCountry" class="bottom-info-right">
                                Země původu: {$itemData->productCountry}
                            </div>
                        </div>
                        {if $iter % 24 == 0 || ($iterator->last && $i == $itemCount)}</div>{/if}
                    {/for}
                {/if}
            {/foreach}
        {elseif $type == App\AdminModule\Presenters\ProductLabelsPresenter::TYPE_DESCRIPTION_2}
            {foreach $presenter->getBarcodeDescriptionsList($type, TRUE) as $item}
                {var $itemData = $item->getData()}
                {var $itemDataTextCount = mb_strlen($itemData->productName.'. '.($itemData->description ?? '').($itemData->consumption ?? ''))}

                {if $itemCount = ($itemData->count ?? 0)}
                    <div n:for="$i=1;$i<=$itemCount;$i++" class="overlay-2"{if $itemDataTextCount > 600} style="font-size: 6px;"{elseif $itemDataTextCount > 450} style="font-size: 7px;"{/if}>
                        {$itemData->productName.'. '}{$itemData->description ?? ''}{$itemData->consumption ?? ''}
                    </div>
                {/if}
            {/foreach}
        {/if}
    </body>
    <script type="text/javascript">
	    window.print();
	    window.onfocus=function(){ window.close();}
    </script>
</html>