                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div role="tabpanel" class="tab-pane" id="tab4">
                                {form barcodeFruitForm class => 'ajax'}
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <div class="form-group">
                                                {label products_id /}
                                                {input products_id class => 'form-control select2'}
