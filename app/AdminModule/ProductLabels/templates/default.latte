{block content}
<div class="col-md-12">
    <div class="panel mosaic-list-panel">
        <div class="panel-body">
            <div>
                <div>
                    {form filters-form}
                        <div class="clearfix m-b-sm">
                            <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-240">
                                <div class="input-group pull-left">
                                    <span class="input-group-addon w-100">{_admin.terms.branch}:</span>
                                    <div class="pull-left w-140">
                                        <div class="form-group m-b-no">
                                            {input custom__branches class => 'select-default change-to-submit', style => 'border: 1px solid #ccc; height: 27px;'}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {/form}
                    <div role="tabpanel">
                        <!-- Nav tabs -->
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" class="active"><a href="#tab1" role="tab" data-toggle="tab">Cenové štítky</a></li>
                            <li role="presentation"><a href="#tab2" role="tab" data-toggle="tab">Popisné štítky</a></li>
                            <li role="presentation"><a href="#tab3" role="tab" data-toggle="tab">Cenové štítky ručně</a></li>
                        </ul>
                        <!-- Tab panes -->
                        <div class="tab-content">
                            <div role="tabpanel" class="tab-pane active" id="tab1">
                                {form barcodePriceForm class => 'ajax'}
                                    <div class="form-group">
                                        {label barcode /}
                                        {input barcode class => 'form-control enter-to-submit'}
                                    </div>
                                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                                        <i class="far fa-check"></i> {_admin.buttons.submit}
                                    </button>
                                {/form}

                                <div n:snippet="barcodePricesList" class="row">
                                    {var $barcodePricesListItems = $presenter->getBarcodePricesList()}
                                    <div class="col-xs-12">
                                        <div n:if="count($barcodePricesListItems)" class="table-responsive dataTables_wrapper m-t-lg">
                                            <table class="table table-striped table-hover js-filters">
                                                <thead>
                                                <tr>
                                                    <th class="w-40 text-center">
                                                        <div class="bulk-head-checkbox">
                                                            <input type="checkbox" class="bulk-check-all ignore mr-0">
                                                        </div>
                                                    </th>
                                                    <th colspan="2">
                                                        <div class="w-300">{_admin.terms.name}</div>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <a n:href="deleteBarcodes!" class="btn btn-xs btn-danger m-t-xxs delete-barcodes mr-0" data-message="{_admin.bulkActions.form.deleteConfirm}">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control js-filters-field">
                                                    </td>
                                                    <td class="w-100">
                                                        <a n:href="barcodePrice" target="_blank" class="btn btn-xs btn-primary m-t-xxs mr-0">
                                                            {_admin.actions.printAll}
                                                        </a>
                                                    </td>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr n:foreach="$barcodePricesListItems as $item" data-id="{$item->id}" class="js-filters-item">
                                                    {var $itemData = $item->getData()}
                                                    <td class="row-as-link-ignore text-center">
                                                        <input type="checkbox" class="bulk-checkbox mr-0">
                                                    </td>
                                                    <td colspan="2">
                                                        {foreach get_object_vars($itemData) as $itemDataKey => $itemDataVal}
                                                            {var $itemDataInsert = TRUE}
                                                            {switch $itemDataKey}
                                                                {case 'code'}
                                                                    {$itemDataVal}
                                                                {case 'productName'}
                                                                    <strong>{$itemDataVal}</strong>
                                                                {case 'weight'}
                                                                    {($itemDataVal / 1000)|number,3,'.',''} Kg
                                                                {case 'unitPrice'}
                                                                    {$itemDataVal|number,2,',',''} Kč/Kg
                                                                {case 'totalPrice'}
                                                                    {$itemDataVal|number,2,',',''} Kč
                                                                {default}
                                                                    {$itemDataInsert = FALSE}
                                                            {/switch}

                                                            {if $itemDataInsert}
                                                                {sep}, {/sep}
                                                            {/if}
                                                        {/foreach}
                                                    </td>
                                                </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div role="tabpanel" class="tab-pane" id="tab2">
                                {form barcodeDescriptionForm class => 'ajax'}
                                    <div class="row">
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                {label type /}
                                                <div>
                                                    {foreach $form["type"]->items as $key => $label}
                                                        <label n:name="type:$key" class="wp-100">
                                                            <input n:name="type:$key" class="descriptions-type toggle-trigger" data-target=".barcodeDescriptionFormType" data-url="{$presenter->link('changeDescriptionType!').'&type='.$key}"> {$label}
                                                        </label>
                                                    {/foreach}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2 barcodeDescriptionFormType" data-show-on="{\App\AdminModule\Presenters\ProductLabelsPresenter::TYPE_DESCRIPTION_1}|{\App\AdminModule\Presenters\ProductLabelsPresenter::TYPE_DESCRIPTION_3}">
                                            <div class="form-group">
                                                {label is_seller /}
                                                <div>{input is_seller class => 'form-control'}</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2 barcodeDescriptionFormType" data-show-on="{\App\AdminModule\Presenters\ProductLabelsPresenter::TYPE_DESCRIPTION_1}|{\App\AdminModule\Presenters\ProductLabelsPresenter::TYPE_DESCRIPTION_3}">
                                            <div class="form-group">
                                                {label is_consumption /}
                                                <div>{input is_consumption class => 'form-control'}</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                {label count /}
                                                {input count class => 'form-control'}
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="form-group">
                                                {label barcode /}
                                                {input barcode class => 'form-control'}
                                            </div>
                                        </div>
                                    </div>

                                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                                        <i class="far fa-check"></i> {_admin.buttons.submit}
                                    </button>
                                {/form}

                                <div class="row">
                                    <div class="col-sm-12 m-t-lg">
                                        <div role="tabpanel">
                                            <!-- Nav tabs -->
                                            <ul class="nav nav-tabs description-tabs" role="tablist">
                                                <li role="presentation" class="active">
                                                    <a n:snippet="barcodeDescriptionsPriceListHeader" href="#tab22" role="tab" data-toggle="tab" data-id="{$presenter::TYPE_DESCRIPTION_2}">
                                                        Cenový štítek ({count($presenter->getBarcodeDescriptionsList($presenter::TYPE_DESCRIPTION_2))})
                                                    </a>
                                                </li>
                                                <li role="presentation">
                                                    <a n:snippet="barcodeDescriptionsSheetListHeader" href="#tab21" role="tab" data-toggle="tab" data-id="{$presenter::TYPE_DESCRIPTION_1}">
                                                        Arch 3x6 ({count($presenter->getBarcodeDescriptionsList($presenter::TYPE_DESCRIPTION_1))})
                                                    </a>
                                                </li>
                                                <li role="presentation">
                                                    <a n:snippet="barcodeDescriptionsSheet2ListHeader" href="#tab23" role="tab" data-toggle="tab" data-id="{$presenter::TYPE_DESCRIPTION_3}">
                                                        Arch 3x8 ({count($presenter->getBarcodeDescriptionsList($presenter::TYPE_DESCRIPTION_3))})
                                                    </a>
                                                </li>
                                            </ul>
                                            <!-- Tab panes -->
                                            <div class="tab-content">
                                                <div role="tabpanel" class="tab-pane active" id="tab22">
                                                    <div n:snippet="barcodeDescriptionsPriceList" class="row">
                                                        {var $barcodeDescriptionsListItems = $presenter->getBarcodeDescriptionsList($presenter::TYPE_DESCRIPTION_2)}
                                                        <div class="col-xs-12">
                                                            <div n:if="count($barcodeDescriptionsListItems)" class="table-responsive dataTables_wrapper">
                                                                <table class="table table-striped table-hover js-filters">
                                                                    <thead>
                                                                    <tr>
                                                                        <th class="w-40 text-center">
                                                                            <div class="bulk-head-checkbox">
                                                                                <input type="checkbox" class="bulk-check-all ignore mr-0">
                                                                            </div>
                                                                        </th>
                                                                        <th colspan="2">
                                                                            <div class="w-300">{_admin.terms.name}</div>
                                                                        </th>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>
                                                                            <a n:href="deleteBarcodes!" class="btn btn-xs btn-danger m-t-xxs delete-barcodes mr-0" data-message="{_admin.bulkActions.form.deleteConfirm}">
                                                                                <i class="fa fa-trash"></i>
                                                                            </a>
                                                                        </td>
                                                                        <td>
                                                                            <input type="text" class="form-control js-filters-field">
                                                                        </td>
                                                                        <td class="w-100">
                                                                            <a n:href="barcodeDescription 2" target="_blank" class="btn btn-xs btn-primary m-t-xxs mr-0">
                                                                                {_admin.actions.printAll}
                                                                            </a>
                                                                        </td>
                                                                    </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                    <tr n:foreach="$barcodeDescriptionsListItems as $item" data-id="{$item->id}" class="js-filters-item">
                                                                        {var $itemData = $item->getData()}
                                                                        <td class="row-as-link-ignore text-center">
                                                                            <input type="checkbox" class="bulk-checkbox mr-0">
                                                                        </td>
                                                                        <td>
                                                                            {foreach get_object_vars($itemData) as $itemDataKey => $itemDataVal}
                                                                                {var $itemDataInsert = TRUE}
                                                                                {switch $itemDataKey}
                                                                                    {case 'code'}
                                                                                    {$itemDataVal}
                                                                                    {case 'productName'}
                                                                                    <strong>{$itemDataVal}</strong>
                                                                                    {case 'description'}
                                                                                    {$itemDataVal|truncate:200}
                                                                                    {default}
                                                                                    {$itemDataInsert = FALSE}
                                                                                {/switch}

                                                                                {if $itemDataInsert}
                                                                                    {sep}, {/sep}
                                                                                {/if}
                                                                            {/foreach}
                                                                        </td>
                                                                        <td class="text-right">
                                                                            {$itemData->count ?? 0}x
                                                                        </td>
                                                                    </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div role="tabpanel" class="tab-pane" id="tab21">
                                                    <div n:snippet="barcodeDescriptionsSheetList" class="row">
                                                        {var $barcodeDescriptionsListItems = $presenter->getBarcodeDescriptionsList($presenter::TYPE_DESCRIPTION_1)}
                                                        <div class="col-xs-12">
                                                            <div n:if="count($barcodeDescriptionsListItems)" class="table-responsive dataTables_wrapper">
                                                                <table class="table table-striped table-hover js-filters">
                                                                    <thead>
                                                                    <tr>
                                                                        <th class="w-40 text-center">
                                                                            <div class="bulk-head-checkbox">
                                                                                <input type="checkbox" class="bulk-check-all ignore mr-0">
                                                                            </div>
                                                                        </th>
                                                                        <th colspan="2">
                                                                            <div class="w-300">{_admin.terms.name}</div>
                                                                        </th>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>
                                                                            <a n:href="deleteBarcodes!" class="btn btn-xs btn-danger m-t-xxs delete-barcodes mr-0" data-message="{_admin.bulkActions.form.deleteConfirm}">
                                                                                <i class="fa fa-trash"></i>
                                                                            </a>
                                                                        </td>
                                                                        <td>
                                                                            <input type="text" class="form-control js-filters-field">
                                                                        </td>
                                                                        <td class="w-100">
                                                                            <a n:href="barcodeDescription 1" target="_blank" class="btn btn-xs btn-primary m-t-xxs mr-0">
                                                                                {_admin.actions.printAll}
                                                                            </a>
                                                                        </td>
                                                                    </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                    <tr n:foreach="$barcodeDescriptionsListItems as $item" data-id="{$item->id}" class="js-filters-item">
                                                                        {var $itemData = $item->getData()}
                                                                        <td class="row-as-link-ignore text-center">
                                                                            <input type="checkbox" class="bulk-checkbox mr-0">
                                                                        </td>
                                                                        <td>
                                                                            {foreach get_object_vars($itemData) as $itemDataKey => $itemDataVal}
                                                                                {var $itemDataInsert = TRUE}
                                                                                {switch $itemDataKey}
                                                                                    {case 'code'}
                                                                                    {$itemDataVal}
                                                                                    {case 'productName'}
                                                                                    <strong>{$itemDataVal}</strong>
                                                                                    {case 'description'}
                                                                                    {$itemDataVal|truncate:200}
                                                                                    {default}
                                                                                    {$itemDataInsert = FALSE}
                                                                                {/switch}

                                                                                {if $itemDataInsert}
                                                                                    {sep}, {/sep}
                                                                                {/if}
                                                                            {/foreach}
                                                                        </td>
                                                                        <td class="text-right">
                                                                            {$itemData->count ?? 0}x
                                                                        </td>
                                                                    </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div role="tabpanel" class="tab-pane" id="tab23">
                                                    <div n:snippet="barcodeDescriptionsSheet2List" class="row">
                                                        {var $barcodeDescriptionsListItems = $presenter->getBarcodeDescriptionsList($presenter::TYPE_DESCRIPTION_3)}
                                                        <div class="col-xs-12">
                                                            <div n:if="count($barcodeDescriptionsListItems)" class="table-responsive dataTables_wrapper">
                                                                <table class="table table-striped table-hover js-filters">
                                                                    <thead>
                                                                    <tr>
                                                                        <th class="w-40 text-center">
                                                                            <div class="bulk-head-checkbox">
                                                                                <input type="checkbox" class="bulk-check-all ignore mr-0">
                                                                            </div>
                                                                        </th>
                                                                        <th colspan="2">
                                                                            <div class="w-300">{_admin.terms.name}</div>
                                                                        </th>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>
                                                                            <a n:href="deleteBarcodes!" class="btn btn-xs btn-danger m-t-xxs delete-barcodes mr-0" data-message="{_admin.bulkActions.form.deleteConfirm}">
                                                                                <i class="fa fa-trash"></i>
                                                                            </a>
                                                                        </td>
                                                                        <td>
                                                                            <input type="text" class="form-control js-filters-field">
                                                                        </td>
                                                                        <td class="w-100">
                                                                            <a n:href="barcodeDescription 3" target="_blank" class="btn btn-xs btn-primary m-t-xxs mr-0">
                                                                                {_admin.actions.printAll}
                                                                            </a>
                                                                        </td>
                                                                    </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                    <tr n:foreach="$barcodeDescriptionsListItems as $item" data-id="{$item->id}" class="js-filters-item">
                                                                        {var $itemData = $item->getData()}
                                                                        <td class="row-as-link-ignore text-center">
                                                                            <input type="checkbox" class="bulk-checkbox mr-0">
                                                                        </td>
                                                                        <td>
                                                                            {foreach get_object_vars($itemData) as $itemDataKey => $itemDataVal}
                                                                                {var $itemDataInsert = TRUE}
                                                                                {switch $itemDataKey}
                                                                                    {case 'code'}
                                                                                    {$itemDataVal}
                                                                                    {case 'productName'}
                                                                                    <strong>{$itemDataVal}</strong>
                                                                                    {case 'description'}
                                                                                    {$itemDataVal|truncate:200}
                                                                                    {default}
                                                                                    {$itemDataInsert = FALSE}
                                                                                {/switch}

                                                                                {if $itemDataInsert}
                                                                                    {sep}, {/sep}
                                                                                {/if}
                                                                            {/foreach}
                                                                        </td>
                                                                        <td class="text-right">
                                                                            {$itemData->count ?? 0}x
                                                                        </td>
                                                                    </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div role="tabpanel" class="tab-pane" id="tab3">
                                {form barcodePriceManualForm class => 'ajax'}
                                    <div class="row">
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                {label is_consumption /}
                                                <div>
                                                    {foreach $form["is_consumption"]->items as $key => $label}
                                                        <label n:name="is_consumption:$key" n:class="btn, btn-outline-primary, wp-100" style="text-align: left;">
                                                            <input n:name="is_consumption:$key" class="toggle-trigger" data-target=".barcodePriceManualConsumption"> {$label}
                                                        </label>
                                                    {/foreach}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2 barcodePriceManualConsumption" data-show-on="{implode('|', array_keys($global['consumptionDateTypes']))}">
                                            <div class="form-group">
                                                {label date /}
                                                <div>{input date class => 'form-control date-picker'}</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                {label is_ingredients /}
                                                <div>{input is_ingredients class => 'form-control'}</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                {label weight /}
                                                <div>{input weight class => 'form-control'}</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="form-group">
                                                {label barcode /}
                                                {input barcode class => 'form-control'}
                                            </div>
                                        </div>
                                    </div>

                                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                                        <i class="far fa-check"></i> {_admin.buttons.submit}
                                    </button>
                                {/form}

                                <div n:snippet="barcodePricesManualList" class="row">
                                    {var $barcodePricesListItems = $presenter->getBarcodePricesManualList()}
                                    <div class="col-xs-12">
                                        <div n:if="count($barcodePricesListItems)" class="table-responsive dataTables_wrapper m-t-lg">
                                            <table class="table table-striped table-hover js-filters">
                                                <thead>
                                                <tr>
                                                    <th class="w-40 text-center">
                                                        <div class="bulk-head-checkbox">
                                                            <input type="checkbox" class="bulk-check-all ignore mr-0">
                                                        </div>
                                                    </th>
                                                    <th colspan="2">
                                                        <div class="w-300">{_admin.terms.name}</div>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <a n:href="deleteBarcodes!" class="btn btn-xs btn-danger m-t-xxs delete-barcodes mr-0" data-message="{_admin.bulkActions.form.deleteConfirm}">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control js-filters-field">
                                                    </td>
                                                    <td class="w-100">
                                                        <a n:href="barcodePriceManual" target="_blank" class="btn btn-xs btn-primary m-t-xxs mr-0">
                                                            {_admin.actions.printAll}
                                                        </a>
                                                    </td>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr n:foreach="$barcodePricesListItems as $item" data-id="{$item->id}" class="js-filters-item">
                                                    {var $itemData = $item->getData()}
                                                    <td class="row-as-link-ignore text-center">
                                                        <input type="checkbox" class="bulk-checkbox mr-0">
                                                    </td>
                                                    <td colspan="2">
                                                        {foreach get_object_vars($itemData) as $itemDataKey => $itemDataVal}
                                                            {var $itemDataInsert = TRUE}
                                                            {switch $itemDataKey}
                                                                {case 'code'}
                                                                {$itemDataVal}
                                                                {case 'productName'}
                                                                <strong>{$itemDataVal}</strong>
                                                                {case 'weight'}
                                                                {($itemDataVal / 1000)|number,3,'.',''} Kg
                                                                {case 'unitPrice'}
                                                                {$itemDataVal|number,2,',',''} Kč/Kg
                                                                {case 'totalPrice'}
                                                                {$itemDataVal|number,2,',',''} Kč
                                                                {case 'consumption'}
                                                                {$itemDataVal}
                                                                {case 'description'}
                                                                {$itemDataVal|truncate:200}
                                                                {default}
                                                                {$itemDataInsert = FALSE}
                                                            {/switch}

                                                            {if $itemDataInsert}
                                                                {sep}, {/sep}
                                                            {/if}
                                                        {/foreach}
                                                    </td>
                                                </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function() {
		setInterval(function() {
            if ($(".tab-pane.active input[name=barcode]").length) {
				var input = $(".tab-pane.active input[name=barcode]");
				if (!input.val().length && !$("input[type=text],input[type=number],select,.select2,.select2-container").is(':focus')) {
					input.focus();
                }
            }
        }, 1000);

	    $(window).on('focus', function() {
		    ajaxGet('?do=reload');
	    });
    })
</script>