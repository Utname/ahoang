                                                    {foreach $form["is_consumption"]->items as $key => $label}
                                                        <label n:name="is_consumption:$key" n:class="btn, btn-outline-primary, wp-100" style="text-align: left;">
                                                            <input n:name="is_consumption:$key" class="toggle-trigger" data-target=".barcodePriceManualConsumption"> {$label}
                                                        </label>
                                                    {/foreach}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2 barcodePriceManualConsumption" data-show-on="{implode('|', array_keys($global['consumptionDateTypes']))}">
                                            <div class="form-group">
                                                {label date /}
                                                <div>{input date class => 'form-control date-picker'}</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                {label is_ingredients /}
                                                <div>{input is_ingredients class => 'form-control'}</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="form-group">
                                                {label weight /}
                                                <div>{input weight class => 'form-control'}</div>
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="form-group">
                                                {label barcode /}
                                                {input barcode class => 'form-control'}
                                            </div>
                                        </div>
                                    </div>

                                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                                        <i class="far fa-check"></i> {_admin.buttons.submit}
                                    </button>
                                {/form}

                                <div n:snippet="barcodePricesManualList" class="row">
                                    {var $barcodePricesListItems = $presenter->getBarcodePricesManualList()}
                                    <div class="col-xs-12">
                                        <div n:if="count($barcodePricesListItems)" class="table-responsive dataTables_wrapper m-t-lg">
                                            <table class="table table-striped table-hover mosaic-table-compact js-filters">
                                                <thead>
                                                <tr>
                                                    <th class="w-40 text-center">
                                                        <div class="bulk-head-checkbox">
                                                            <input type="checkbox" class="bulk-check-all ignore mr-0">
                                                        </div>
                                                    </th>
                                                    <th colspan="2">
                                                        <div class="w-300">{_admin.terms.name}</div>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <a n:href="deleteBarcodes!" class="btn btn-xs btn-danger m-t-xxs delete-barcodes mr-0" data-message="{_admin.bulkActions.form.deleteConfirm}">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control js-filters-field">
                                                    </td>
                                                    <td class="w-100">
                                                        <a n:href="barcodePriceManual" target="_blank" class="btn btn-xs btn-primary m-t-xxs mr-0">
                                                            {_admin.actions.printAll}
                                                        </a>
                                                    </td>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr n:foreach="$barcodePricesListItems as $item" data-id="{$item->id}" class="js-filters-item">
                                                    {var $itemData = $item->getData()}
                                                    <td class="row-as-link-ignore text-center">
                                                        <input type="checkbox" class="bulk-checkbox mr-0">
                                                    </td>
                                                    <td colspan="2">
                                                        {foreach get_object_vars($itemData) as $itemDataKey => $itemDataVal}
                                                            {var $itemDataInsert = TRUE}
                                                            {switch $itemDataKey}
                                                                {case 'code'}
                                                                {$itemDataVal}
                                                                {case 'productName'}
                                                                <strong>{$itemDataVal}</strong>
                                                                {case 'weight'}
                                                                {($itemDataVal / 1000)|number,3,'.',''} Kg
                                                                {case 'unitPrice'}
                                                                {$itemDataVal|number,2,',',''} Kč/Kg
                                                                {case 'totalPrice'}
                                                                {$itemDataVal|number,2,',',''} Kč
                                                                {case 'consumption'}
                                                                {$itemDataVal}
                                                                {case 'description'}
                                                                {$itemDataVal|truncate:200}
                                                                {default}
                                                                {$itemDataInsert = FALSE}
                                                            {/switch}

                                                            {if $itemDataInsert}
                                                                {sep}, {/sep}
