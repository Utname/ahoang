{block content}
<div class="col-md-12">
    <div class="panel mosaic-list-panel">
        <div class="panel-body">
            <div>
                <div>
                    {form filters-form}
                        <div class="mosaic-filter-bar">
                            <div class="mosaic-filter-grid" style="grid-template-columns: 220px;">
                                <div>
                                    <label><i class="fa fa-store m-r-xxs text-primary"></i> {_admin.terms.branch}</label>
                                    {input custom__branches class => 'form-control change-to-submit'}
                                </div>
                            </div>
                        </div>
                    {/form}
                    <div role="tabpanel">
                        <script>
                        window.showAdminTab = function(link, tabId) {
                            if (!tabId) return;
                            try { localStorage.setItem('activeProductLabelTab', tabId); } catch(e){}

                            var pane = document.getElementById(tabId);
                            if (!pane) return;

                            var tabList = link ? link.closest('.nav-tabs') : document.querySelector('.nav-tabs');
                            if (tabList) {
                                var items = tabList.querySelectorAll('li');
                                for (var i = 0; i < items.length; i++) {
                                    items[i].classList.remove('active');
                                }
                                var targetLi = link ? link.closest('li') : tabList.querySelector('a[href="#' + tabId + '"]');
                                if (targetLi && targetLi.closest('li')) {
                                    targetLi.closest('li').classList.add('active');
                                }
                            }

                            var tabContent = pane.closest('.tab-content');
                            if (tabContent) {
                                var panes = tabContent.children;
                                for (var j = 0; j < panes.length; j++) {
                                    if (panes[j].classList && panes[j].classList.contains('tab-pane')) {
                                        panes[j].classList.remove('active', 'in');
                                        panes[j].style.display = 'none';
                                    }
                                }
                            }
                            pane.classList.add('active', 'in');
                            pane.style.display = 'block';

                            if (window.history && window.history.pushState) {
                                window.history.pushState(null, null, '#' + tabId);
                            } else {
                                window.location.hash = '#' + tabId;
                            }
                        };

                        function restoreActiveAdminTab() {
                            var hash = location.hash ? location.hash.replace('#', '') : (localStorage.getItem('activeProductLabelTab') || 'tab1');
                            if (hash && document.getElementById(hash)) {
                                var link = document.querySelector('.nav-tabs a[href="#' + hash + '"]');
                                window.showAdminTab(link, hash);
                            }
                        }

                        document.addEventListener('DOMContentLoaded', restoreActiveAdminTab);
                        window.addEventListener('hashchange', restoreActiveAdminTab);
                        </script>

                        <!-- Nav tabs -->
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" class="active"><a href="#tab1" onclick="window.showAdminTab(this, 'tab1'); return false;">Cenové štítky</a></li>
                            <li role="presentation"><a href="#tab2" onclick="window.showAdminTab(this, 'tab2'); return false;">Popisné štítky</a></li>
                            <li role="presentation"><a href="#tab3" onclick="window.showAdminTab(this, 'tab3'); return false;">Cenové štítky ručně</a></li>
                            <li role="presentation"><a href="#tab4" onclick="window.showAdminTab(this, 'tab4'); return false;">Štítky na ovoce</a></li>
                        </ul>
                        <!-- Tab panes -->
                        <div class="tab-content">
                            <div role="tabpanel" class="tab-pane active" id="tab1">
                                {form barcodePriceForm class => 'ajax'}
                                    <div class="form-group">
                                        {label barcode /}
                                        {input barcode class => 'form-control enter-to-submit'}
                                    </div>
                                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                                        <i class="far fa-check"></i> {_admin.buttons.submit}
                                    </button>
                                {/form}

                                <div n:snippet="barcodePricesList" class="row">
                                    {var $barcodePricesListItems = $presenter->getBarcodePricesList()}
                                    <div class="col-xs-12">
                                        <div n:if="count($barcodePricesListItems)" class="table-responsive dataTables_wrapper m-t-lg">
                                            <table class="table table-striped table-hover mosaic-table-compact js-filters">
                                                <thead>
                                                <tr>
                                                    <th class="w-40 text-center">
                                                        <div class="bulk-head-checkbox">
                                                            <input type="checkbox" class="bulk-check-all ignore mr-0">
                                                        </div>
                                                    </th>
                                                    <th colspan="2">
                                                        <div class="w-300">{_admin.terms.name}</div>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <a n:href="deleteBarcodes!" class="btn btn-xs btn-danger m-t-xxs delete-barcodes mr-0" data-message="{_admin.bulkActions.form.deleteConfirm}">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control js-filters-field">
                                                    </td>
                                                    <td class="w-100">
                                                        <a n:href="barcodePrice" target="_blank" class="btn btn-xs btn-primary m-t-xxs mr-0">
                                                            {_admin.actions.printAll}
                                                        </a>
                                                    </td>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr n:foreach="$barcodePricesListItems as $item" data-id="{$item->id}" class="js-filters-item">
                                                    {var $itemData = $item->getData()}
                                                    <td class="row-as-link-ignore text-center">
                                                        <input type="checkbox" class="bulk-checkbox mr-0">
                                                    </td>
                                                    <td colspan="2">
                                                        {foreach get_object_vars($itemData) as $itemDataKey => $itemDataVal}
                                                            {var $itemDataInsert = TRUE}
                                                            {switch $itemDataKey}
                                                                {case 'code'}
                                                                    {$itemDataVal}
                                                                {case 'productName'}
                                                                    <strong>{$itemDataVal}</strong>
                                                                {case 'weight'}
                                                                    {($itemDataVal / 1000)|number,3,'.',''} Kg
                                                                {case 'unitPrice'}
                                                                    {$itemDataVal|number,2,',',''} Kč/Kg
                                                                {case 'totalPrice'}
                                                                    {$itemDataVal|number,2,',',''} Kč
                                                                {default}
                                                                    {$itemDataInsert = FALSE}
                                                            {/switch}

                                                            {if $itemDataInsert}
                                                                {sep}, {/sep}
                                                            {/if}
                                                        {/foreach}
                                                    </td>
                                                </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div role="tabpanel" class="tab-pane" id="tab2">
                                {form barcodeDescriptionForm class => 'ajax'}
