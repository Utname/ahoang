<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>In tem hoa quả</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400..1000;1,400..1000&display=swap" rel="stylesheet">
    <script n:if="!empty($windowClose)">
        window.close();
    </script>
    <style>
        @page {
            size: A4;
            margin: 8mm 5mm;
        }
        
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            background: #ffffff;
            color: #111111;
        }

        .labels-container {
            width: 200mm;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            align-content: flex-start;
        }

        .fikko-fruit {
            box-sizing: border-box;
            width: 50mm;
            height: 35mm;
            max-height: 35mm;
            padding: 1.6mm 2mm;
            display: flex;
            flex-direction: column;
            gap: 0.6mm;
            overflow: hidden;
            background: #ffffff;
            color: #111111;
            border: 0.2mm dashed #bbbbbb;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        @media print {
            body { background: #ffffff !important; }
            .labels-container {
                width: 200mm !important;
                margin: 0 auto !important;
            }
            .fikko-fruit {
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }
        }

        .fikko-fruit .product-title {
            font-size: 2.8mm;
            font-weight: 800;
            line-height: 1.1;
            word-wrap: break-word;
            word-break: break-word;
        }
        .fikko-fruit .product-title.long-title {
            font-size: 2.3mm;
            line-height: 1.05;
        }

        .fikko-fruit .title-divider {
            border-top: 0.25mm solid #111111;
        }

        .fikko-fruit .middle-section {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 2mm;
            min-height: 0;
        }

        .fikko-fruit .weight-col {
            display: flex;
            flex-direction: column;
            gap: 0.6mm;
            flex: none;
        }

        .fikko-fruit .meta-item {
            display: flex;
            flex-direction: column;
        }

        .fikko-fruit .meta-label {
            font-size: 1.5mm;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            font-weight: 700;
            line-height: 1.1;
        }

        .fikko-fruit .meta-val {
            font-family: Nunito, sans-serif;
            font-weight: 900;
            font-style: italic;
            font-size: 2.9mm;
            line-height: 1.05;
        }

        .fikko-fruit .price-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            min-width: 0;
        }

        .fikko-fruit .price-header-label {
            font-size: 1.6mm;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 0.8mm;
            line-height: 1;
        }

        .fikko-fruit .price-wrap {
            display: flex;
            align-items: flex-start;
            gap: 0.6mm;
        }

        .fikko-fruit .price-major {
            font-family: Nunito, sans-serif;
            font-weight: 900;
            font-style: italic;
            font-size: 8mm;
            line-height: 0.85;
            letter-spacing: -0.02em;
        }

        .fikko-fruit .price-side {
            display: flex;
            flex-direction: column;
            gap: 0.3mm;
        }

        .fikko-fruit .price-minor {
            font-family: Nunito, sans-serif;
            font-weight: 900;
            font-style: italic;
            font-size: 3.6mm;
            line-height: 0.9;
        }

        .fikko-fruit .price-currency {
            font-family: Nunito, sans-serif;
            font-weight: 900;
            font-style: italic;
            font-size: 2.4mm;
            line-height: 0.9;
        }

        .fikko-fruit .bottom-section {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 2mm;
        }

        .fikko-fruit .details-col {
            display: flex;
            flex-direction: column;
            gap: 0.2mm;
            font-size: 1.6mm;
            line-height: 1.2;
        }

        .fikko-fruit .barcode-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.2mm;
            flex: none;
        }

        .fikko-fruit .barcode-bars {
            display: flex;
            height: 4.5mm;
        }

        .fikko-fruit .barcode-ean {
            font-size: 1.4mm;
            letter-spacing: 0.06em;
            line-height: 1.1;
        }

        .fikko-fruit .footer-text {
            font-size: 1.4mm;
            line-height: 1.1;
            opacity: 0.85;
        }
    </style>
</head>
<body>
<div class="labels-container">
{foreach $presenter->getBarcodeFruitList(!empty($type) ? $type : NULL) as $item}
    {var $itemData = $item->getData()}
    {var $count = max(1, intval($itemData->count ?? 1))}
    {for $c = 0; $c < $count; $c++}
        {var $productTitle = (string)($itemData->productName ?? '')}
        {var $isLongTitle = mb_strlen($productTitle) > 30}
        {var $totalPrice = (float)($itemData->totalPrice ?? 0)}
        {var $priceFormatted = number_format($totalPrice, 2, ',', '')}
        {var $priceParts = explode(',', $priceFormatted)}
        {var $finalPriceMajor = $priceParts[0] ?? '0'}
        {var $finalPriceMinor = $priceParts[1] ?? '00'}
        {var $rawEan = !empty($itemData->productEan) ? (string)$itemData->productEan : (!empty($itemData->code) ? (string)$itemData->code : '10001')}
        {var $ean = \EanBarcodeHelper::formatFruitEan($rawEan, $totalPrice)}
        {var $bars = \EanBarcodeHelper::getBars($ean, 0.20)}
        {var $packedDate = date('d.m.Y')}
        {var $expiryDate = !empty($itemData->expiryDate) ? $itemData->expiryDate : date('d.m.Y', strtotime('+2 days'))}
        {var $countryName = !empty($itemData->productCountry) ? $itemData->productCountry : 'Thajsko'}
        {var $weightVal = !empty($itemData->note1) ? $itemData->note1 : ((!empty($itemData->weight) && $itemData->weight > 0) ? (number_format(($itemData->weight / 1000), 3, ',', '') . ' kg') : '0,486 kg')}
        {var $unitPriceVal = (!empty($itemData->unitPrice) && $itemData->unitPrice > 0) ? (number_format($itemData->unitPrice, 2, ',', '') . ' Kč') : '129,90 Kč'}
        {var $storageVal = !empty($itemData->note2) ? $itemData->note2 : '2–6 °C'}
        {var $storageText = str_starts_with($storageVal, 'Skladujte') ? $storageVal : ('Skladujte při ' . $storageVal)}
        {var $packerVal = !empty($itemData->note3) ? $itemData->note3 : 'Fikko Market · adresa provozovny'}
        {var $packerText = str_starts_with($packerVal, 'Balí') ? $packerVal : ('Balí: ' . $packerVal)}

        <section class="fikko-fruit" data-label-root="1" data-label="Etiketa 50×35">
            <div class="product-title{if $isLongTitle} long-title{/if}">{$productTitle}</div>
            <div class="title-divider"></div>

            <div class="middle-section">
                <div class="weight-col">
                    <div class="meta-item">
                        <span class="meta-label">Hmotnost</span>
                        <span class="meta-val">{$weightVal}</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Cena za 1 kg</span>
                        <span class="meta-val">{$unitPriceVal}</span>
                    </div>
                </div>

                <div class="price-col">
                    <span class="price-header-label">Cena</span>
                    <div class="price-wrap">
                        <span class="price-major">{$finalPriceMajor}</span>
                        <div class="price-side">
                            <span class="price-minor">,{$finalPriceMinor}</span>
                            <span class="price-currency">Kč</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bottom-section">
                <div class="details-col">
                    <div>Baleno dne: <b>{$packedDate}</b></div>
                    <div>Spotřebujte do: <b>{$expiryDate}</b></div>
                    <div>{$storageText}</div>
                    <div>Země původu: <b>{$countryName}</b></div>
                </div>

                <div class="barcode-col">
                    <div n:if="$bars" class="barcode-bars">
                        <div n:foreach="$bars as $bar" style="height:100%;background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
                    </div>
                    <div class="barcode-ean">{$ean}</div>
                </div>
            </div>

            <div class="footer-text">{$packerText}</div>
        </section>
    {/for}
{/foreach}
</div>
<script type="text/javascript">
    window.addEventListener('load', function() {
        window.print();
    });
</script>
</body>
</html>
</body>
</html>
