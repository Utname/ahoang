<a n:if="isset($blacklistEmails[$email])" n:href="removeBlacklistEmail! $email" class="row-as-link-ignore with-confirm text-danger pull-right" data-toggle="tooltip" title="{_admin.terms.removeFromBlacklist}" data-message="{_admin.terms.confirmRemoveBlackListEmail}">
    <i class="fas fa-ban"></i>
</a>
<a n:if="!isset($blacklistEmails[$email])" n:href="addBlacklistEmail! $email" class="row-as-link-ignore with-confirm text-default pull-right" data-toggle="tooltip" title="{_admin.terms.addToBlacklist}" data-message="{_admin.terms.confirmSetBlackListEmail}">
    <i class="fas fa-ban"></i>
</a>
