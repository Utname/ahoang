<div class="col-md-12">
	<div class="panel panel-white">
		{form moveForm}
			<div class="panel-body">

				<div role="tabpanel">
					<ul class="nav nav-tabs" role="tablist">
						<li role="presentation" class="active">
							<a href="#section-01" role="tab" data-toggle="tab">{_admin.actions.move}</a>
						</li>
					</ul>

					<div class="tab-content">
						<div role="tabpanel" class="tab-pane active clearfix" id="section-01">
							<div class="col-lg-4">
								<div class="row">
									<div class="col-sm-6">
										<div class="form-group">
											{label relationship /}
											{input relationship class => 'form-control'}
										</div>
									</div>
								</div>
								<div class="form-group">
									{input related_item class => 'form-control'}
								</div>
							</div>
						</div>
					</div>

					<div class="form-group-btns b-t p-v-sm clearfix">
						<button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
							<i class="far fa-check"></i> {_admin.buttons.move}
						</button>
						<a n:href="default" class="btn btn-default btn-addon">
							<i class="far fa-arrow-left"></i> {_admin.buttons.backToList}
						</a>
					</div>
				</div>

			</div>
		{/form}
	</div>
</div>