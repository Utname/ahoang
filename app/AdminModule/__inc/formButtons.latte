<div class="form-group-btns b-t p-v-sm clearfix mosaic-form-btns">
	<div class="m-t-xs">
		<button n:name="submit_close" class="btn mosaic-topbtn mosaic-topbtn-primary">
			<i class="far fa-check"></i> {_admin.buttons.saveAndClose}
		</button>
		<button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
			<i class="far fa-check"></i> {_admin.buttons.save}
		</button>
		<a n:href="default" class="btn btn-default mosaic-topbtn">
			<i class="far fa-arrow-left"></i> {_admin.buttons.backToList}
		</a>
	</div>
</div>