{block content}

<div class="col-md-12">
	<div class="panel panel-white">
		{form editForm}
			<div class="panel-body">

				<div role="tabpanel">
					<ul class="nav nav-tabs" role="tablist">
						<li role="presentation" class="active">
							<a href="#section-01" role="tab" data-toggle="tab">{_admin.tabs.basicInfo}</a>
						</li>
					</ul>

					<div class="tab-content">
						<div role="tabpanel" class="tab-pane active clearfix" id="section-01">
							<div class="col-lg-4">
								<div class="clearfix">
									<h4>{_admin.terms.mainInfo}</h4>
									<div class="form-group">
										{label name /}
									{input name class => 'form-control form-control-bigger'}
									</div>
									<div class="row">
										<div class="col-sm-6">
											<div class="form-group">
												{label id /}
											{input id class => 'form-control'}
											</div>
										</div>
									</div>
								</div>
								<div class="clearfix">
									<h4>{_admin.terms.details}</h4>
									<div class="row">
										<div class="col-sm-6">
											<div class="form-group">
												{label is_active /}
											{input is_active class => 'form-control'}
											</div>
										</div>
										<div class="col-sm-6">
											<div class="form-group">
												{label is_in_menu /}
											{input is_in_menu class => 'form-control'}
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					{include APP_DIR.'/AdminModule/__inc/formButtons.latte'}
				</div>

			</div>
		{/form}
	</div>
</div>
