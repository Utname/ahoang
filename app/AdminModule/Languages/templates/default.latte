{block topButtons}

	<a n:if="count($filters)" n:href="resetFilters!" class="btn btn-default mosaic-topbtn mosaic-topbtn-danger">
		<i class="far fa-times"></i> {_admin.filters.reset}
	</a>
	<a n:if="$aps->has('create')" n:href="new" class="btn mosaic-topbtn mosaic-topbtn-primary">
		<i class="far fa-plus"></i> {_admin.actions.new}
	</a>

{/block}


{block content}

	<div class="col-md-12">
		<div class="panel mosaic-list-panel">
			<div class="panel-body">
				<div class="clearfix m-b-sm">
					<div class="pull-left">
						<a href="#" class="btn btn-default slide-toggle" data-target=".export-container">
							{_admin.terms.export} <i class="fa fa-chevron-down"></i>
						</a>
						<a href="#" class="btn btn-default slide-toggle" data-target=".import-container">
							{_admin.terms.import} <i class="fa fa-chevron-down m-l-xxs"></i>
						</a>
					</div>
					<div class="pull-right">
						{control bulkActions:button}
					</div>
				</div>
				{include '_exportDropdown.latte'}
				{include '_importDropdown.latte'}
				{control bulkActions}
                {form filters-form}
					<div class="mosaic-list-table-wrap dataTables_wrapper">
						<table class="table table-striped table-hover mosaic-table-compact">
							<thead>
							<tr>
								<th class="w-40"></th>
								<th>
									<div class="w-300">{_admin.terms.name}</div>
								</th>
								<th class="w-100">
									<div class="w-100">{_admin.terms.shortcut}</div>
								</th>
								<th class="w-50 text-center">
									<i class="far fa-star" data-toggle="tooltip" title="{_admin.terms.isDefault}"></i>
								</th>
								<th class="w-50 text-center">
									<i class="far fa-eye" data-toggle="tooltip" title="{_admin.terms.isInMenu}"></i>
								</th>
								<th class="w-50 text-center">
									<i class="far fa-eye" data-toggle="tooltip" title="{_admin.terms.isActive}"></i>
								</th>
								<th class="w-40">
									<div class="w-30"></div>
								</th>
							</tr>
							<tr class="filters">
								<td>
									{control bulkActions:headCheckbox}
								</td>
								<td>
									{input name class => 'form-control w-300'}
								</td>
								<td>
									{input id class => 'form-control'}
								</td>
								<td></td>
								<td></td>
								<td></td>
								<td>
									<button type="submit" class="btn btn-default wp-100">
										<i class="far fa-filter"></i>
									</button>
								</td>
							</tr>
							</thead>
							<tbody n:snippet="list">
							<tr n:foreach="$items as $item" class="row-as-link" data-id="{$item->id}">
								<td class="row-as-link-ignore">
									{control bulkActions:checkbox $item}
								</td>
								<td>
									<span n:if="$aps->has('edit')" class="far fa-bars m-r-xxs move-handler text-default" data-toggle="tooltip" title="{_admin.actions.move}"></span>
									<strong>{$item->name}</strong>
								</td>
								<td>
									{$item->id}
								</td>
								<td class="text-center row-as-link-ignore">
									<a n:if="$aps->has('edit') && !$item->is_default" n:href="setAsDefault! $item->id" data-toggle="tooltip" title="{_admin.terms.setAsDefault}">
										<i class="far fa-times-circle text-danger"></i>
									</a>
									<span n:if="!$aps->has('edit') || $item->is_default" data-toggle="tooltip" title="{_}admin.globals.bool.{$item->is_default ? 'true' : 'false'}{/_}">
										<i n:class="'far', $item->is_default ? 'fa-check-circle text-success' : 'fa-times-circle text-danger'"></i>
									</span>
								</td>
								<td class="text-center row-as-link-ignore">
									{include APP_DIR.'/AdminModule/__inc/boolSwitch.latte', 'item' => $item, 'param' => 'is_in_menu'}
								</td>
								<td class="text-center row-as-link-ignore">
									{include APP_DIR.'/AdminModule/__inc/boolSwitch.latte', 'item' => $item, 'param' => 'is_active', 'disabled' => $item->is_default}
								</td>
								<td class="actions actions-small row-as-link-ignore">
									<div class="dropdown pull-left">
										<a class="dropdown-toggle btn btn-default mosaic-row-actions-btn" data-toggle="dropdown" href="#">
											<i class="fa fa-bars"></i>
										</a>
										<ul class="dropdown-menu dropdown-menu-right dropdown-list">
											{control baseActions $item, $iterator}
										</ul>
									</div>
								</td>
							</tr>
							</tbody>
						</table>

						{control paginator}
					</div>

				{/form}
			</div>
		</div>
	</div>

{/block}
