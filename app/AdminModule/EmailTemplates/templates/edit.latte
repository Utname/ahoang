{block content}

<div class="col-md-12">
	<div class="panel panel-white">
		{form editForm}
		<div class="panel-body">

			<div role="tabpanel">
				<ul class="nav nav-tabs" role="tablist">
					<li role="presentation" class="active">
						<a href="#section-01" role="tab" data-toggle="tab">{_admin.tabs.basicInfo}</a>
					</li>
				</ul>

				<div class="tab-content">
					<div role="tabpanel" class="tab-pane active clearfix" id="section-01">
						<div class="col-lg-4">
							<div class="clearfix">
								<div class="form-group">
									{label name /}
									{input name class => 'form-control form-control-bigger'}
								</div>
								<div class="form-group">
									{label subject /}
									{input subject class => 'form-control'}
								</div>
								<div class="form-group">
									{label email_from /}
									{input email_from class => 'form-control'}
								</div>
								<div class="form-group">
									{label email_to /}
									{input email_to class => 'form-control'}
								</div>
							</div>

							<div class="clearfix">
								<h4>{_admin.terms.attachments}</h4>
								{control files}
							</div>

							<div class="clearfix">
								<h4>{_admin.terms.systemSettings}</h4>
								<div class="form-group">
									{label system /}
									{input system class => 'form-control'}
								</div>
							</div>
						</div>

						<div class="col-lg-7 col-lg-offset-1">
							<div class="form-group">
								{label text /}
								{input text class => 'form-control wsw h-500'}
							</div>
						</div>
					</div>
				</div>

				{include APP_DIR.'/AdminModule/__inc/formButtons.latte'}
			</div>

		</div>
		{/form}
	</div>
</div>