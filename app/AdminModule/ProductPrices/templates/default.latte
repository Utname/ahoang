{block topButtons}
    <a n:if="count($filters)" n:href="resetFilters!" class="btn btn-default mosaic-topbtn mosaic-topbtn-danger">
        <i class="far fa-times"></i> {_admin.filters.reset}
    </a>
    <a n:href="Branches:new" n:if="$aps->has('Branches_create')" class="btn mosaic-topbtn mosaic-topbtn-primary m-l-xxs">
        <i class="far fa-plus"></i> {_admin.terms.newBranchesList}
    </a>

{/block}


{block content}
    <div class="col-md-12">
        <div class="panel mosaic-list-panel">
            <div class="panel-body">
                {form filters-form}

                    <div class="clearfix m-b-sm">
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-220">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-80">{_admin.terms.branch}:</span>
                                <div class="pull-left w-140">
                                    <div class="form-group m-b-no">
                                        {input custom__branches class => 'change-to-submit'}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-220">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-80">{_admin.terms.currency}:</span>
                                <div class="pull-left w-140">
                                    {input custom__currency class => 'change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-220">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-80">{_admin.terms.name}:</span>
                                <div class="pull-left w-140">
                                    {input custom__name class => 'form-control change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-220">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-80">{_admin.terms.ean}:</span>
                                <div class="pull-left w-140">
                                    {input custom__code_ean class => 'form-control change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-220">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-80">{_admin.terms.isAction}:</span>
                                <div class="pull-left w-140">
                                    {input custom__is_action class => 'change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-220">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-80">{_admin.terms.isActive}:</span>
                                <div class="pull-left w-140">
                                    {input custom__is_active class => 'change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-t-xxs m-b-xxs">
                            <a n:href="multiPrices!" class="btn btn-primary ajax-modal" data-target="#modal-multiPricesForm">
                                <i class="fa fa-files"></i>
                            </a>
                        </div>
                        <div class="pull-left m-t-xxs m-b-xxs">
                            <a n:href="product!" class="btn btn-primary ajax-modal" data-target="#modal-productsForm">
                                <i class="fa fa-circle-plus"></i>
                            </a>
                        </div>
                    </div>
                {/form}

                <div class="mosaic-list-table-wrap dataTables_wrapper m-t-lg">
                    {form pricesForm}
                        <table class="table table-striped table-hover mosaic-table-compact vertical-middle submit-on-change">
                            <thead>
                            <tr>
                                <th class="w-60"></th>
                                <th>
                                    <div class="w-300">
                                        {_admin.terms.name} / {_admin.terms.code}
                                    </div>
                                </th>
                                <th class="w-150 text-center">
                                    {_admin.terms.price}
                                </th>
                                <th class="w-60 text-center">
                                    {_admin.terms.action}
                                </th>
                                <th class="w-140 text-center">
                                    {_admin.terms.actionPrice}
                                </th>
                                <th class="w-140 text-center">
                                    {_admin.terms.actionFrom}
                                </th>
                                <th class="w-140 text-center">
                                    {_admin.terms.actionTo}
                                </th>
                            </tr>
                            </thead>
                            <tbody n:snippet="list">

                            <tr n:foreach="$items as $product" data-id="{$product->id}">
                                {var $price = $product->getPrice($presenter->session->filters[$presenter->getName()]['custom__branches'], $currency)}
                                <td class="td-image">
                                    <img n:if="$image = $product->getImage()" src="{$image->file|image:adminGallery}" class="wp-100">
                                </td>
                                <td>
                                    <strong>{$product->name}</strong>
                                    <a n:if="$product" n:href="Products:edit $product->id" target="_blank" class="m-l-xxs" data-toggle="tooltip" title="{_admin.terms.goToDetail}"><i class="fa fa-edit"></i></a>
                                    <br>

                                    <small class="pull-left">
                                            {if $product->code_ean}
                                            {_admin.terms.ean}: {$product->code_ean}
                                        {/if}
                                    </small>
                                </td>
                                <td class="text-right">
                                    <div class="pull-left">
                                        <input type="number" data-item-id="{$price->id ?? NULL}" step="0.01" class="form-control text-right" name="price__{$product->id}" value="{$price && $price->price? $price->price : 0}">
                                    </div>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" data-item-id="{$price->id ?? NULL}" name="is_action__{$product->id}" {if $price && $price->is_action}checked=""{/if} disabled="disabled">
                                    <i class="fa fa-circle-info pull-right m-t-xxs text-info" data-toggle="tooltip" title="{$product->formatBranchTooltip($branchesPairs, 'is_action')}"></i>
                                </td>
                                <td class="text-right">
                                    <input type="number" data-item-id="{$price->id ?? NULL}" step="0.01" class="form-control text-right w-100 pull-left" name="price_action__{$product->id}" value="{$price && $price->price_action ? $price->price_action : ''}">
                                    <i class="fa fa-circle-info pull-right m-t-xs text-info" data-toggle="tooltip" title="{$product->formatBranchTooltip($branchesPairs, 'price_action')}"></i>
                                </td>
                                <td class="text-right">
                                    <input type="text" data-item-id="{$price->id ?? NULL}" class="form-control date-picker text-center w-100 pull-left" name="action_from__{$product->id}" value="{$price && $price->action_from ? $price->action_from->format('d.m.Y') : ''}">
                                    <i class="fa fa-circle-info pull-right m-t-xs text-info" data-toggle="tooltip" title="{$product->formatBranchTooltip($branchesPairs, 'action_from')}"></i>
                                </td>
                                <td class="text-right">
                                    <input type="text" data-item-id="{$price->id ?? NULL}" class="form-control date-picker text-center w-100 pull-left" name="action_to__{$product->id}" value="{$price && $price->action_to ? $price->action_to->format('d.m.Y') : ''}">
                                    <i class="fa fa-circle-info pull-right m-t-xs text-info" data-toggle="tooltip" title="{$product->formatBranchTooltip($branchesPairs, 'action_to')}"></i>
                                </td>
                            </tr>


                            </tbody>
                        </table>

                        <div class="text-right">
                            <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary m-l-xxs pull-right">
                                <i class="far fa-check"></i> {_admin.buttons.save}
                            </button>
                            <button n:if="$canChangePage" n:name="submit_next_page" class="btn mosaic-topbtn mosaic-topbtn-primary m-l-xxs pull-right">
                                <i class="far fa-check"></i> {_admin.buttons.saveAndGoToNextPage}
                            </button>
                        </div>
                    {/form}
                    {control paginator}
                </div>

            </div>
        </div>
    </div>


<div id="modal-multiPricesForm" class="modal fade">
    <div class="modal-dialog modal-md">
        <div n:snippet="multiPricesForm" class="modal-content">
            {form multiPricesForm}
                <div class="modal-header">
                    <h4>{_admin.terms.multiPricesChange}</h4>
                </div>
                <div class="modal-body clearfix">
                    <h4 class="m-t-no">{_admin.terms.branches}</h4>
                    <div class="row">
                        <div n:foreach="$branchesPairs as $branchesId => $branhesName" class="col-lg-2">
                            <div class="form-group">
                                {input 'branch__'.$branchesId}
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label is_action /}
                                {input is_action class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label price /}
                                {input price class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label price_action /}
                                {input price_action class => 'form-control'}
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label action_from /}
                                {input action_from class => 'form-control date-picker'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label action_to /}
                                {input action_to class => 'form-control date-picker'}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <a href="#" class="btn btn-default mosaic-topbtn" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}
        </div>
    </div>
</div>

<div id="modal-productsForm" class="modal fade">
    <div class="modal-dialog modal-lg-2">
        <div n:snippet="productsForm" class="modal-content">
            {form productsForm}
                <div class="modal-header">
                    <h4>{_admin.terms.newProduct}</h4>
                </div>
                <div class="modal-body clearfix">
                    <div class="col-lg-4">
                        <div class="clearfix">
                            <h4>{_admin.terms.mainInfo}</h4>

                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-group">
                                        {label code_ean /}
                                        {input code_ean class => 'form-control'}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                {label name /}
                                {input name class => 'form-control form-control-bigger url-source', data-target => '.webalize'}
                            </div>
                            <div class="form-group clearfix">
                                {label slug /}
                                {input slug class => 'form-control webalize'}
                            </div>
                            <div class="form-group">
                                {label country_origin /}
                                {input country_origin class => 'form-control'}
                            </div>
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label units_id /}
                                        {input units_id class => 'form-control'}
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label weight /}
                                        {input weight class => 'form-control'}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="clearfix">
                            <h4>{_admin.terms.details}</h4>

                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        {label is_active /}
											{input is_active class => 'form-control'}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7 col-lg-offset-1">
                        <h4>{_admin.terms.description}</h4>

                        <div class="form-group">
                            {label perex /}
                            {input perex class => 'form-control wsw h-100'}
                        </div>
                        <div class="form-group">
                            {label text /}
                            {input text class => 'form-control wsw h-400'}
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <a href="#" class="btn btn-default mosaic-topbtn" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}
        </div>
    </div>
</div>