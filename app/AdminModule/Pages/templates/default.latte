{block topButtons}

    <a n:if="count($filters)" n:href="resetFilters!" class="btn btn-danger btn-addon">
        <i class="far fa-times"></i> {_admin.filters.reset}
    </a>
    <a n:if="$aps->has('PageTypes_list')" n:href="PageTypes:" class="btn btn-primary btn-addon">
        <i class="far fa-list"></i> {_admin.modules.pageTypes|menu}
    </a>
    <a n:if="$aps->has('create')" n:href="new" class="btn btn-success btn-addon">
        <i class="far fa-plus"></i> {_admin.actions.new}
    </a>

{/block}


{block content}

    <div class="col-md-12">
        <div class="panel panel-white">
            <div class="panel-body">
                <div class="clearfix m-b-sm">
                    <div class="pull-right">
                        {control bulkActions:button}
                        <a href="#" class="btn btn-default slide-toggle" data-target=".custom-codes-container">
                            {_admin.permissions.custom_codes} <i class="fa fa-chevron-down m-l-xxs"></i>
                        </a>
                    </div>
                </div>
                {include '_customCodesForm.latte'}
                {control bulkActions}
                {form filters-form}
                    <div class="table-responsive dataTables_wrapper">
                        <table class="table table-striped table-hover">
                            <thead>
                            <tr>
                                <th class="w-40"></th>
                                <th>
                                    <div class="w-300">{_admin.terms.name}</div>
                                </th>
                                <th>
                                    <div class="w-400">{_admin.terms.url}</div>
                                </th>
                                <th class="w-300">
                                    <div class="w-300">{_admin.terms.pageType}</div>
                                </th>
                                <th class="w-70 text-center">
                                    <div class="w-70">{_admin.terms.isInMenu}</div>
                                </th>
                                <th class="w-70 text-center">
                                    <div class="w-70">{_admin.terms.isInFooter}</div>
                                </th>
                                <th class="w-50 text-center">
                                    <i class="far fa-eye" data-toggle="tooltip" title="{_admin.terms.isActive}"></i>
                                </th>
                                <th class="w-40">
                                    <div class="w-30"></div>
                                </th>
                            </tr>
                            <tr class="filters">
                                <td>
                                    {control bulkActions:headCheckbox}
                                </td>
                                <td class="w-400">
                                    {input name class => 'form-control w-400'}
                                </td>
                                <td></td>
                                <td>
                                    {input pages__page_types_id class => 'form-control'}
                                </td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>
                                    <button type="submit" class="btn btn-default wp-100">
                                        <i class="far fa-filter"></i>
                                    </button>
                                </td>
                            </tr>
                            </thead>
                            <tbody n:snippet="list">
                            <tr n:foreach="$items as $item" class="row-as-link" data-id="{$item->id}">
                                <td class="row-as-link-ignore">
                                    {control bulkActions:checkbox $item}
                                </td>
                                <td>
                                    <a n:if="$aps->has('create')" n:href="new $item->id" class="m-r-xxs text-default row-as-link-ignore" data-toggle="tooltip" title="{_admin.actions.createChild}">
                                        <i class="far fa-plus-circle"></i>
                                    </a>
                                    <a n:if="$aps->has('edit')" n:href="move $item->id" class="m-r-xxs text-default row-as-link-ignore" data-toggle="tooltip" title="{_admin.actions.move}">
                                        <i class="far fa-arrows"></i>
                                    </a>
                                    <strong>{$item->getOffsetName()}</strong>
                                </td>
                                <td>
                                    <a href="{$item->full_url}" target="_blank" class="row-as-link-ignore">{$item->full_url}</a>
                                </td>
                                <td>
                                    {$item->getType()?->name}
                                </td>
                                <td class="text-center row-as-link-ignore">
                                    {include APP_DIR.'/AdminModule/__inc/boolSwitch.latte', 'item' => $item, 'param' => 'is_in_menu'}
                                </td>
                                <td class="text-center row-as-link-ignore">
                                    {include APP_DIR.'/AdminModule/__inc/boolSwitch.latte', 'item' => $item, 'param' => 'is_in_footer'}
                                </td>
                                <td class="text-center row-as-link-ignore">
                                    {include APP_DIR.'/AdminModule/__inc/boolSwitch.latte', 'item' => $item, 'param' => 'is_active'}
                                </td>
                                <td class="actions actions-small row-as-link-ignore">
                                    <div class="dropdown pull-left">
                                        <a class="dropdown-toggle btn btn-default" data-toggle="dropdown" href="#">
                                            <i class="fa fa-bars"></i>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-right dropdown-list">
                                            {control baseActions $item, $iterator}
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>

                {/form}
            </div>
        </div>
    </div>

{/block}
