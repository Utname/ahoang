{block topButtons}

    <a n:if="count($filters)" n:href="resetFilters!" class="btn btn-danger btn-addon">
        <i class="far fa-times"></i> {_admin.filters.reset}
    </a>
    <a n:if="$aps->has('create')" n:href="new" class="btn btn-success btn-addon">
        <i class="far fa-plus"></i> {_admin.actions.new}
    </a>
    <a n:if="$aps->has('create')" n:href="installA4Preset!" class="btn btn-default btn-addon">
        <i class="far fa-file-import"></i> {_admin.terms.printTemplateInstallA4}
    </a>
    <a n:if="$aps->has('create')" n:href="installA5Preset!" class="btn btn-default btn-addon">
        <i class="far fa-file-import"></i> {_admin.terms.printTemplateInstallA5}
    </a>
    <a n:if="$aps->has('create')" n:href="installVel1Preset!" class="btn btn-default btn-addon">
        <i class="far fa-file-import"></i> {_admin.terms.printTemplateInstallVel1}
    </a>
    <a n:if="$aps->has('create')" n:href="installVel3Preset!" class="btn btn-default btn-addon">
        <i class="far fa-file-import"></i> {_admin.terms.printTemplateInstallVel3}
    </a>

{/block}


{block content}

    <div class="col-md-12">
        <div class="panel panel-white">
            <div class="panel-body">
                <div class="clearfix m-b-sm">
                    <div class="pull-right">
                        {control bulkActions:button}
                    </div>
                </div>
                {control bulkActions}
                {form filters-form}
                    <div class="table-responsive dataTables_wrapper">
                        <table class="table table-striped table-hover">
                            <thead>
                            <tr>
                                <th class="w-40"></th>
                                <th>
                                    <div class="w-260">{_admin.terms.name}</div>
                                </th>
                                <th class="w-120">
                                    <div class="w-120">{_admin.terms.printTemplateSize}</div>
                                </th>
                                <th class="w-120">
                                    <div class="w-120">{_admin.terms.printTemplateLabelType}</div>
                                </th>
                                <th class="w-140">
                                    <div class="w-140">{_admin.terms.printTemplateVariant}</div>
                                </th>
                                <th class="w-50 text-center">
                                    <i class="far fa-star" data-toggle="tooltip" title="{_admin.terms.printTemplateIsDefault}"></i>
                                </th>
                                <th class="w-40">
                                    <div class="w-30"></div>
                                </th>
                            </tr>
                            <tr class="filters">
                                <td>
                                    {control bulkActions:headCheckbox}
                                </td>
                                <td>
                                    {input name class => 'form-control w-260'}
                                </td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>
                                    <button type="submit" class="btn btn-default wp-100">
                                        <i class="far fa-filter"></i>
                                    </button>
                                </td>
                            </tr>
                            </thead>
                            <tbody n:snippet="list">
                            <tr n:foreach="$items as $item" class="row-as-link" data-id="{$item->id}">
                                <td class="row-as-link-ignore">
                                    {control bulkActions:checkbox $item}
                                </td>
                                <td>
                                    <strong>{$item->name}</strong>
                                </td>
                                <td>
                                    {$item->width_mm} &times; {$item->height_mm} mm
                                </td>
                                <td>
                                    {$global['productLabelTypes'][$item->getValue('product_label_type_id')] ?? '-'}
                                </td>
                                <td>
                                    {$printTemplateVariantsPairs[$item->variant] ?? $item->variant}
                                </td>
                                <td class="text-center row-as-link-ignore">
                                    <a n:if="$aps->has('edit') && !$item->is_default" n:href="setAsDefault! $item->id" data-toggle="tooltip" title="{_admin.terms.setAsDefault}">
                                        <i class="far fa-times-circle text-danger"></i>
                                    </a>
                                    <span n:if="!$aps->has('edit') || $item->is_default" data-toggle="tooltip" title="{_}admin.globals.bool.{$item->is_default ? 'true' : 'false'}{/_}">
                                        <i n:class="'far', $item->is_default ? 'fa-check-circle text-success' : 'fa-times-circle text-danger'"></i>
                                    </span>
                                </td>
                                <td class="actions actions-small row-as-link-ignore">
                                    <div class="dropdown pull-left">
                                        <a class="dropdown-toggle btn btn-default" data-toggle="dropdown" href="#">
                                            <i class="fa fa-bars"></i>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-right dropdown-list">
                                            <li>
                                                <a n:href="downloadPdf! $item->id" target="_blank">
                                                    <i class="far fa-eye"></i> {_admin.actions.preview}
                                                </a>
                                            </li>
                                            {control baseActions $item, $iterator}
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table>

                        {control paginator}
                    </div>

                {/form}
            </div>
        </div>
    </div>

{/block}
