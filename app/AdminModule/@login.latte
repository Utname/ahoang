{extends none}

{* See @layout.latte for why this is filemtime()-based, not hour-based. *}
{var $antiCache = max(
	@filemtime(WWW_DIR.'/css/admin/custom.css') ?: 0,
	@filemtime(WWW_DIR.'/js/admin/custom.js') ?: 0,
	@filemtime(WWW_DIR.'/css/admin/modern.css') ?: 0,
	@filemtime(WWW_DIR.'/js/admin/modern.js') ?: 0
) ?: date('YmdH')}

<!DOCTYPE html>

<html>

<head>
	<title>
		{_admin.project.name}
	</title>

	<meta content="width=device-width, initial-scale=1" name="viewport"/>
	<meta charset="UTF-8">
	<meta name="description" content=""/>
	<meta name="keywords" content=""/>
	<meta name="author" content="Pro-idea s.r.o. | www.pro-idea.cz"/>
	{isset($settings->favicon) ? \SettingsEntity::getFaviconCode($settings->favicon) : ''|noescape}

	<link href='https://fonts.googleapis.com/css?family=Open+Sans:400,300,600' rel='stylesheet' type='text/css'>
	<link href="/plugins/uniform/css/uniform.default.min.css" rel="stylesheet"/>
	<link href="/plugins/bootstrap/css/bootstrap.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/fontawesome/css/all.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/line-icons/simple-line-icons.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/slidepushmenus/css/component.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/select2/css/select2.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/bootstrap-datepicker/css/datepicker3.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/bootstrap-colorpicker/css/colorpicker.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/dropzone/dropzone.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/image-cropper/cropper.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/jquery-ui/jquery-ui.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/magnific-popup/magnific-popup.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/chartsjs/Chart.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/datatables/css/jquery.datatables.min.css" rel="stylesheet" type="text/css">
	<link href="/plugins/fontawesome-iconpicker/css/fontawesome-iconpicker.min.css" rel="stylesheet" type="text/css"/>

	<link href="/css/admin/modern.css?v={$antiCache}" rel="stylesheet" type="text/css"/>
	<link href="/css/admin/themes/white.css" class="theme-color" rel="stylesheet" type="text/css"/>
	<link href="/css/admin/alertify.core.css" rel="stylesheet" type="text/css"/>
	<link href="/css/admin/alertify.default.css" rel="stylesheet" type="text/css"/>
	<link href="/css/admin/custom.css?v={$antiCache}" rel="stylesheet" type="text/css"/>

	<script src="/plugins/jquery/jquery-2.1.3.min.js"></script>

	<!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
	<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
	<!--[if lt IE 9]>
	<script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
	<script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
	<![endif]-->
</head>

<body class="page-login mosaic-login-page">

<main class="page-content">
	<!-- Language Switcher on Top-Right -->
	<div n:if="count($locales) > 1" class="mosaic-login-lang">
		<div class="dropdown">
			<a href="#" class="dropdown-toggle mosaic-login-lang-btn" data-toggle="dropdown">
				<i class="fas fa-globe text-slate"></i>
				<span>{if $locale == 'vi_VN'}Tiếng Việt{elseif $locale == 'cs_CZ'}Čeština{else}{$locale}{/if}</span>
				<i class="fas fa-chevron-down mosaic-arrow-icon"></i>
			</a>
			<ul class="dropdown-menu dropdown-menu-right mosaic-dropdown-menu" role="menu">
				<li n:foreach="$locales as $l" role="presentation">
					<a n:href="switchLocale! $l" n:class="$locale == $l ? 'active'">
						<span class="mosaic-lang-code">{$l|upper|substr:0,2}</span>
						<span>{_'admin.locales.'.$l}</span>
						<i n:if="$locale == $l" class="fas fa-check mosaic-active-check"></i>
					</a>
				</li>
			</ul>
		</div>
	</div>

	<div class="mosaic-login-container">
		<div class="mosaic-login-card">
			<!-- Branding / Logo -->
			<div class="mosaic-login-brand">
				<div class="mosaic-login-logo-badge">
					<i class="fas fa-shapes"></i>
				</div>
				<h1 class="mosaic-login-title">{_admin.project.name}</h1>
				<span class="mosaic-login-subtitle">{_admin.ui.loginSubtitle}</span>
			</div>

			<div class="mosaic-login-content">
				{include content}
			</div>

			<div class="mosaic-login-footer">
				<p>{date('Y')} &copy; {_admin.project.copyright}. All rights reserved.</p>
			</div>
		</div>
	</div>
</main>

<div style="display: none;" n:snippet="flashMessages">
	<div n:foreach="$flashes as $flash" n:class="'flash-messages', $flash->type" style="display: none;">{$flash->message}</div>
</div>

<script src="/plugins/jquery-ui/jquery-ui.min.js"></script>
<script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
<script src="/plugins/uniform/jquery.uniform.min.js"></script>
<script src="/plugins/select2/js/select2.min.js"></script>
<script src="/plugins/ckeditor/ckeditor.js"></script>
<script src="/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="/plugins/bootstrap-datepicker/js/locales/bootstrap-datepicker.cs.js"></script>
<script src="/plugins/bootstrap-datetimepicker/js/bootstrap-datetimepicker.js"></script>
<script src="/plugins/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.cs.js"></script>
<script src="/plugins/bootstrap-colorpicker/js/bootstrap-colorpicker.js"></script>
<script src="/plugins/dropzone/dropzone.min.js"></script>
<script src="/plugins/image-cropper/cropper.min.js"></script>
<script src="/plugins/image-cropper/jquery-cropper.js"></script>
<script src="/plugins/magnific-popup/jquery.magnific-popup.min.js"></script>
<script src="/js/admin/alertify.js"></script>
<script src="/js/admin/live-form-validation.js"></script>
<script src="/plugins/fontawesome-iconpicker/js/fontawesome-iconpicker.min.js"></script>
<script src="/js/admin/modern.js?v={$antiCache}"></script>
<script src="/js/admin/custom.js?v={$antiCache}"></script>

{if $GLOBALS['container']->isDevMode()}
{* Auto-translate CZ -> VI on load, local dev only (config/02-local.neon: devMode) *}
<div id="google_translate_element" style="display:none;"></div>
<div style="position:fixed;bottom:8px;right:8px;z-index:9999;background:#fff;border:1px solid #ccc;border-radius:4px;padding:4px 8px;font-size:12px;box-shadow:0 1px 4px rgba(0,0,0,.2);">
	<a href="#" onclick="document.cookie='googtrans=/cs/vi;path=/';document.cookie='googtrans=/cs/vi;path=/;domain='+location.hostname;location.reload();return false;">VI</a>
	|
	<a href="#" onclick="document.cookie='googtrans=/cs/cs;path=/';document.cookie='googtrans=/cs/cs;path=/;domain='+location.hostname;location.reload();return false;">CS</a>
</div>
<script n:syntax="off">
    {* Google's own "show original" toggle only affects the current DOM, not the googtrans cookie — it never survives a reload, hence the VI/CS links above giving explicit, persistent control instead. This only sets a default on the very first visit (no googtrans cookie yet); once either link is clicked the cookie always exists, so this never overrides that choice again. *}
    if (!/(?:^|; )googtrans=/.test(document.cookie)) {
        document.cookie = 'googtrans=/cs/vi; path=/';
        document.cookie = 'googtrans=/cs/vi; path=/; domain=' + location.hostname;
    }
    function googleTranslateElementInit() {
        new google.translate.TranslateElement({pageLanguage: 'cs', includedLanguages: 'vi', autoDisplay: false}, 'google_translate_element');
    }
</script>
<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
{/if}

</body>

</html>
