{block topButtons}

    <a n:if="count($filters)" n:href="resetFilters!" class="btn btn-default mosaic-topbtn mosaic-topbtn-danger">
        <i class="far fa-times"></i> {_admin.filters.reset}
    </a>
    <a n:if="$aps->has('Blacklist_emails')" n:href="Blog:" class="btn btn-default mosaic-topbtn">
        <i class="far fa-arrow-left"></i> {_admin.buttons.back}
    </a>
    <a n:if="$aps->has('create')" n:href="new" class="btn mosaic-topbtn mosaic-topbtn-primary">
        <i class="far fa-plus"></i> {_admin.actions.new}
    </a>

{/block}


{block content}

    <div class="col-md-12">
        <div class="panel mosaic-list-panel">
            <div class="panel-body">

                <div class="clearfix m-b-sm">
                    <div class="pull-right">

                    </div>
                </div>

                {form filters-form}
                    <div class="mosaic-list-table-wrap dataTables_wrapper">
                        <table class="table table-striped table-hover mosaic-table-compact">
                            <thead>
                            <tr>
                                <th class="w-150">
                                    <div class="w-150">{_admin.terms.date} {control sorting 'date_insert'}</div>
                                </th>
                                <th>
                                    <div>{_admin.terms.email} {control sorting 'email'}</div>
                                </th>
                                <th class="w-40 text-center"></th>
                            </tr>
                            <tr class="filters">
                                <td></td>
                                <td>
                                    {input email class => 'form-control w-300'}
                                </td>
                                <td></td>
                            </tr>
                            </thead>
                            <tbody n:snippet="list">
                            <tr n:foreach="$items as $item" class="row-as-link" data-id="{$item->id}">
                                <td>
                                    {$item->date_insert->format('d.m.Y H:i:s')}
                                </td>
                                <td>
                                    {$item->email}
                                </td>
                                <td class="actions-small text-center row-as-link-ignore">
                                    <div class="dropdown pull-left">
                                        <a class="dropdown-toggle btn btn-default mosaic-row-actions-btn" data-toggle="dropdown" href="#">
                                            <i class="fa fa-bars"></i>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-right dropdown-list">
                                            {control baseActions $item, $iterator}
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table>

                        {control paginator}
                    </div>

                {/form}
            </div>
        </div>
    </div>
{/block}