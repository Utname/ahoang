<div class="clearfix">
    <h4>{_admin.terms.categoriesClassification}</h4>

        {var $ids = isset($item) ? $item->getCategoriesIds() : []}
        <table n:if="!empty($categories)" class="table table-striped table-hover table-compact js-filters">
            <thead>
            <tr>
                <th>
                    <div class="w-150">{_admin.terms.category}</div>
                </th>
                <th class="w-50 text-center">
                </th>
                <th class="w-50 text-center">
                    <i class="far fa-eye" data-toggle="tooltip" title="{_admin.terms.isActive}"></i>
                </th>
            </tr>
            <tr class="filters">
                <td><input type="text" class="form-control js-filters-field w-400"></td>
                <td></td>
                <td></td>
            </tr>
            </thead>
            <tbody>
            <tr n:foreach="$categories as $i" class="js-filters-item">
                <td>
                   <label for="categories-{$i->id}">{$i->getOffsetName()}</label>
                </td>
                <td class="text-center">
                    <input type="checkbox" name="categories[{$i->id}]"{if in_array($i->id, $ids)} checked="checked"{/if} />
                </td>
                <td class="text-center row-as-link-ignore">
                    {include APP_DIR.'/AdminModule/__inc/boolSwitch.latte', 'item' => $i, 'param' => 'is_active', disabled => TRUE}
                </td>
            </tr>
            </tbody>
        </table>
        <div n:if="empty($categories)" class="alert alert-info">
            <p>
                {_admin.terms.noProductCategories}
            </p>
        </div>

        <div n:if="$presenter->getAction() != 'default'" class="row-links m-b-sm">
            {control categoriesQuickCreator:button}
        </div>
</div>
