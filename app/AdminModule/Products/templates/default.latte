{block topButtons}
    <div style="display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <a n:if="count($filters)" n:href="resetFilters!" class="btn btn-default mosaic-topbtn mosaic-topbtn-danger">
            <i class="far fa-times m-r-xxs"></i> {_'admin.filters.reset'}
        </a>
        <a href="#" class="btn btn-default mosaic-topbtn slide-toggle" data-target=".import-container">
            <i class="fa fa-file-import m-r-xxs text-muted"></i> {_'admin.terms.import'} <i class="fa fa-chevron-down m-l-xxs" style="font-size:10px;"></i>
        </a>
        <a n:href="Categories:" class="btn btn-default mosaic-topbtn">
            <i class="fa fa-folder-tree m-r-xxs text-primary"></i> {_'admin.terms.categories'}
        </a>
        <div class="dropdown" style="display:inline-block;">
            <button class="btn btn-default mosaic-topbtn dropdown-toggle" type="button" data-toggle="dropdown">
                <i class="fa fa-bolt m-r-xxs text-warning"></i> Thao tác giá <i class="fa fa-angle-down m-l-xxs"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-right dropdown-list" style="border-radius:10px;box-shadow:0 10px 25px rgba(0,0,0,0.1);padding:6px 0;min-width:210px;">
                <li>
                    <a n:href="prepareMultiSale!" class="ajax-modal" data-target="#modal-multiSaleForm">
                        <i class="fa fa-percent text-danger m-r-xs"></i> {_'admin.terms.multipleSale'}
                    </a>
                </li>
                <li>
                    <a n:href="multiPrices!" class="ajax-modal" data-target="#modal-multiPricesForm">
                        <i class="fa fa-file-invoice-dollar text-primary m-r-xs"></i> {_'admin.terms.multiplePrice'}
                    </a>
                </li>
            </ul>
        </div>
        <a n:if="$aps->has('create')" n:href="product!" class="btn mosaic-topbtn mosaic-topbtn-primary ajax-modal" data-target="#modal-productsForm" style="padding:7px 18px;">
            <i class="fa fa-plus m-r-xxs"></i> {_'admin.terms.newProduct'}
        </a>
    </div>
{/block}


{block content}

<style>
.product-price-fields input,
.product-date-fields input {
    border-radius: 6px !important;
    border: 1px solid #cbd5e1 !important;
    font-size: 11.5px !important;
    padding: 3px 6px !important;
    height: 28px !important;
    transition: all 0.15s ease;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02) !important;
}
.product-price-fields input:focus,
.product-date-fields input:focus {
    border-color: #0ea5e9 !important;
    box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.15) !important;
}
.product-price-fields label,
.product-date-fields label {
    font-size: 10px;
    color: #64748b;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 2px;
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.02em;
}
.td-image img {
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    object-fit: cover;
}
</style>

<div class="col-md-12">
    <div class="panel mosaic-list-panel">
        <div class="panel-body">
            {include '_importDropdown.latte'}
            {control bulkActions}

            {snippet topFilters}
                {form filters-form}
                    <div class="mosaic-filter-bar">
                        
                        <!-- Row 1: Search (Left) + Print Queue Toolbar (Right) -->
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:14px;">
                            <div class="mosaic-list-search-box">
                                <i class="fa fa-search search-icon"></i>
                                {input custom__name class => 'form-control autocomplete change-to-submit', 'data-url' => $presenter->link('productsAutocomplete!'), placeholder => 'Tìm theo tên hoặc mã EAN...'}
                            </div>

                            <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;margin-left:auto;">
                                <a n:href="toPrint!" class="btn btn-default" style="border-radius:8px;height:38px;padding:7px 14px;font-weight:600;font-size:12.5px;border:1px solid #cbd5e1;background:#fff;color:#334155;display:inline-flex;align-items:center;gap:6px;box-shadow:0 1px 2px rgba(0,0,0,0.03);" title="Chỉ lọc các sản phẩm đang có tem chờ in">
                                    <i class="fa fa-filter text-info"></i> {_'admin.terms.toPrint'}
                                </a>

                                <a n:href="clearAllPrintCounts!" class="btn btn-default ajax with-confirm" data-message="{_'admin.terms.reallyRemoveLabels'}" style="border-radius:8px;height:38px;padding:7px 12px;font-weight:600;font-size:12.5px;border:1px solid #fee2e2;background:#fff;color:#e11d48;display:inline-flex;align-items:center;gap:6px;box-shadow:0 1px 2px rgba(0,0,0,0.03);" title="Xóa toàn bộ hàng đợi in tem">
                                    <i class="fa fa-trash-alt"></i> {_'admin.terms.removeLabels'}
                                </a>

                                {snippet headerPrintBtn}
                                    <a href="#" class="btn" style="background:#0f172a;color:#fff;border-radius:8px;height:38px;padding:7px 16px;font-weight:700;font-size:13px;display:inline-flex;align-items:center;gap:8px;border:none;box-shadow:0 2px 6px rgba(15,23,42,0.25);" onclick="$('#modal-printPreview').modal('show'); return false;">
                                        <span>🖨 {_'admin.terms.downloadLabels'}</span>
                                        <span style="background:#14b8a6;color:#042f2e;border-radius:999px;padding:2px 8px;font-size:11px;font-weight:800;">{$totalLabels ?? 0}</span>
                                    </a>
                                {/snippet}
                            </div>
                        </div>

                        <!-- Row 2: 5 Filter dropdowns in a dedicated grid with labels -->
                        <div class="mosaic-filter-grid">
                            <div>
                                <label>
                                    <i class="fa fa-store m-r-xxs text-primary"></i> {_'admin.terms.branch' ?? 'Chi nhánh'}
                                </label>
                                {input custom__branches class => 'form-control change-to-submit'}
                            </div>

                            <div>
                                <label>
                                    <i class="fa fa-folder-tree m-r-xxs text-primary"></i> {_'admin.terms.category' ?? 'Danh mục'}
                                </label>
                                {input custom__category class => 'form-control change-to-submit'}
                            </div>

                            <div>
                                <label>
                                    <i class="fa fa-eye m-r-xxs text-info"></i> {_'admin.terms.isActive' ?? 'Trạng thái'}
                                </label>
                                {input custom__is_active class => 'form-control change-to-submit'}
                            </div>

                            <div>
                                <label>
                                    <i class="fa fa-percent m-r-xxs text-danger"></i> {_'admin.terms.isAction' ?? 'Khuyến mãi'}
                                </label>
                                {input custom__is_action class => 'form-control change-to-submit'}
                            </div>

                            <div>
                                <label>
                                    <i class="fa fa-tags m-r-xxs" style="color:#0d9488;"></i> {_'admin.terms.labels' ?? 'Tem nhãn'}
                                </label>
                                {input custom__labels class => 'form-control change-to-submit'}
                            </div>
                        </div>
                    </div>
                {/form}
            {/snippet}


                <div class="mosaic-list-table-wrap dataTables_wrapper m-t-md">
                        <table class="table table-striped table-hover mosaic-table-compact" style="margin-bottom:0;width:100%;">
                            <thead>
                            <tr>
                                <th class="w-40 text-center" style="width:40px;min-width:40px;"></th>
                                <th class="w-50 text-center" style="width:50px;min-width:50px;"></th>
                                <th style="min-width:240px;">
                                    <div>
                                        <strong>{_admin.terms.name} {control sorting 'name'} / {_admin.terms.code} {control sorting 'code'} / {_admin.terms.createdAt} {control sorting 'created_at'}</strong>
                                    </div>
                                </th>
                                <th class="visible-xxl w-200" style="min-width:180px;">
                                    <div class="w-200"><strong>{_admin.terms.category}</strong></div>
                                </th>
                                <th class="w-450 text-center" colspan="4" style="min-width:380px;">
                                    <div><strong>{_admin.terms.action}</strong></div>
                                </th>
                                <th class="w-380 text-center" style="min-width:370px;">
                                    <div class="w-380"><strong>{_admin.terms.labels}</strong> (A4 · A5 · Vel. 1 · Vel. 2 · Vel. 3)</div>
                                </th>
                                <th class="text-center" style="width:55px;min-width:55px;">
                                    <i class="far fa-eye" data-toggle="tooltip" title="{_admin.terms.isActive}"></i>
                                </th>
                                <th class="text-center" style="width:70px;min-width:70px;padding-right:12px;">
                                    <i class="fa fa-ellipsis-v text-muted" title="Thao tác"></i>
                                </th>
                            </tr>
                            <tr>
                                <th colspan="3"></th>
                                <th class="visible-xxl"></th>
                                <th class="w-180 text-center" style="width:140px;min-width:140px;">
                                    <div style="font-weight:700;">{_admin.terms.price}</div>
                                </th>
                                <th class="w-210 text-center" style="width:170px;min-width:170px;">
                                    <div style="font-weight:700;">{_admin.terms.date}</div>
                                </th>
                                <th class="w-40 text-center" style="width:40px;min-width:40px;">
                                    <div><i class="fa fa-save"></i></div>
                                </th>
                                <th class="w-40 text-center" style="width:40px;min-width:40px;">
                                    <div><i class="far fa-percent"></i></div>
                                </th>
                                <th></th>
                                <th colspan="2">
                                </th>
                            </tr>
                            </thead>
                            <tbody n:snippet="list">
                            {foreach $items as $item}
                                {var $price = $item->getPrice($presenter->session->filters[$presenter->getName()]['custom__branches'])}
                                <tr class="row-as-link" data-id="{$item->id}">
                                    <td class="row-as-link-ignore text-center">
                                        {control bulkActions:checkbox $item}
                                    </td>

                                    <td class="td-image text-center">
                                        <img n:if="$image = $item->getImage()" src="{$image->file|image:adminGallery}" />
                                    </td>
                                    <td>
                                        <small><i class="far fa-clock" title="{_admin.terms.createdAt}: {$item->created_at|date:'d.m.Y H:i'}" data-toggle="tooltip"></i></small>
                                        <strong>{$item->name}</strong><br />
                                        <small class="pull-left">
                                            {if $item->code_ean}
                                                {_admin.terms.ean}: {$item->code_ean}
                                            {/if}
                                        </small>
                                    </td>
                                    <td class="visible-xxl">
                                        {foreach $item->getCategories() as $i}
                                            <span>{$i->name}</span>{sep}<br>{/sep}
                                        {/foreach}
                                    </td>
                                    <td class="row-as-link-ignore product-price-fields" style="width:140px;min-width:140px;vertical-align:middle;">
                                        <div style="margin-bottom:6px;">
                                            <label>{_admin.terms.basePrice}:</label>
                                            <div style="display:flex;align-items:center;gap:6px;">
                                                <input type="number" data-item-id="{$price->id ?? NULL}" step="0.01" class="form-control form-control-sm text-right" name="price__{$item->id}" value="{$price && $price->price? $price->price : 0}" style="flex:1;font-weight:600;color:#1e293b;">
                                                <a n:href="showPricesLog! $item->id, $presenter->session->filters[$presenter->getName()]['custom__branches']" class="ajax-modal" data-target="#modal-pricesLog" title="Lịch sử giá" style="color:#94a3b8;font-size:13px;display:flex;align-items:center;justify-content:center;width:18px;flex-shrink:0;">
                                                    <i class="far fa-clock"></i>
                                                </a>
                                            </div>
                                        </div>

                                        <div>
                                            <label>{_admin.terms.actionPriceAbb}:</label>
                                            <div style="display:flex;align-items:center;gap:6px;">
                                                <input type="number" data-item-id="{$price->id ?? NULL}" step="0.01" class="form-control form-control-sm text-right" name="price_action__{$item->id}" value="{$price && $price->price_action ? $price->price_action : ''}" placeholder="—" style="flex:1;font-weight:600;color:#e11d48;">
                                                <span style="display:flex;align-items:center;justify-content:center;width:18px;flex-shrink:0;">
                                                    <i class="far fa-circle-info text-muted" data-toggle="tooltip" title="{$item->formatBranchTooltip($branchesPairs, 'price_action')}" style="color:#94a3b8;font-size:13px;cursor:help;"></i>
                                                </span>
                                            </div>
                                        </div>

                                        {var $refPrice = $item->getRefPrice($presenter->session->filters[$presenter->getName()]['custom__branches'])}
                                        {if $refPrice}
                                            <div style="margin-top:4px;">
                                                <span class="label label-warning" style="font-weight: normal; font-size: 9.5px; display: block; white-space: normal; line-height: 1.2; padding: 2px 4px; border-radius: 4px;" data-toggle="tooltip" title="Na webu se jako přeškrtnutá cena zobrazí {$refPrice|price} (nejnižší cena za posledních 30 dní), nikoliv základní cena.">
                                                    <i class="fas fa-triangle-exclamation"></i> {$refPrice|price}
                                                </span>
                                            </div>
                                        {/if}
                                    </td>
                                    <td class="row-as-link-ignore product-date-fields" style="width:170px;min-width:170px;vertical-align:middle;">
                                        <div class="calendar-today-overlay" style="margin-bottom:6px;">
                                            <label>{_admin.terms.actionFrom}:</label>
                                            <div style="display:flex;align-items:center;gap:5px;">
                                                <input type="text" data-item-id="{$price->id ?? NULL}" class="form-control form-control-sm text-center date-picker" name="action_from__{$item->id}" value="{$price && $price->action_from ? $price->action_from->format('d.m.Y') : ''}" placeholder="dd.mm.yyyy" style="flex:1;font-weight:500;">
                                                <a href="#" class="calendar-today-btn btn btn-default btn-xs" title="Hôm nay" style="height:28px;width:28px;display:inline-flex;align-items:center;justify-content:center;border-radius:6px;border:1px solid #cbd5e1;background:#f8fafc;color:#475569;flex-shrink:0;padding:0;">
                                                    <i class="fa fa-calendar-day" style="font-size:11px;"></i>
                                                </a>
                                                <span style="display:flex;align-items:center;justify-content:center;width:18px;flex-shrink:0;">
                                                    <i class="far fa-circle-info text-muted" data-toggle="tooltip" title="{$item->formatBranchTooltip($branchesPairs, 'action_from')}" style="color:#94a3b8;font-size:13px;cursor:help;"></i>
                                                </span>
                                            </div>
                                        </div>

                                        <div class="calendar-today-overlay">
                                            <label>{_admin.terms.actionTo}:</label>
                                            <div style="display:flex;align-items:center;gap:5px;">
                                                <input type="text" data-item-id="{$price->id ?? NULL}" class="form-control form-control-sm text-center date-picker" name="action_to__{$item->id}" value="{$price && $price->action_to ? $price->action_to->format('d.m.Y') : ''}" placeholder="dd.mm.yyyy" style="flex:1;font-weight:500;">
                                                <a href="#" class="calendar-today-btn btn btn-default btn-xs" title="Hôm nay" style="height:28px;width:28px;display:inline-flex;align-items:center;justify-content:center;border-radius:6px;border:1px solid #cbd5e1;background:#f8fafc;color:#475569;flex-shrink:0;padding:0;">
                                                    <i class="fa fa-calendar-day" style="font-size:11px;"></i>
                                                </a>
                                                <span style="display:flex;align-items:center;justify-content:center;width:18px;flex-shrink:0;">
                                                    <i class="far fa-circle-info text-muted" data-toggle="tooltip" title="{$item->formatBranchTooltip($branchesPairs, 'action_to')}" style="color:#94a3b8;font-size:13px;cursor:help;"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="row-as-link-ignore text-center">
                                        <button type="button" class="btn btn-default btn-sm btn-save-prices hidden" title="{_admin.buttons.save}" data-products-id="{$item->id}" style="float: none; margin-right: 0;">
                                            <i class="fa fa-save"></i>
                                        </button>
                                    </td>
                                    <td class="row-as-link-ignore text-center">
                                        {control "productActions-$item->id"}
                                    </td>
                                    <td class="row-as-link-ignore text-center">
                                        {control "productLabels-$item->id"}
                                    </td>
                                    <td class="text-center row-as-link-ignore" style="width:55px;min-width:55px;vertical-align:middle;">
                                        {include APP_DIR.'/AdminModule/__inc/boolSwitch.latte', 'item' => $item, 'param' => 'is_active', 'isEye' => TRUE}
                                    </td>
                                    <td class="actions row-as-link-ignore text-center" style="width:70px;min-width:70px;padding-right:12px;vertical-align:middle;">
                                        <div class="dropdown" style="display:inline-block;">
                                            <a class="dropdown-toggle btn btn-default mosaic-row-actions-btn" data-toggle="dropdown" href="#" title="Thao tác">
                                                <i class="fa fa-bars"></i>
                                            </a>
                                            <ul class="dropdown-menu dropdown-menu-right dropdown-list" style="border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,0.12);padding:6px 0;min-width:180px;">
                                                {control baseActions $item, $iterator}
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {/foreach}
                            </tbody>
                        </table>

                    {control paginator}

                    {snippet printSummary}
                        <div class="print-summary-sticky-bar" style="position:sticky;bottom:10px;z-index:90;background:#fff;border:1px solid #14b8a6;border-radius:12px;padding:12px 20px;margin-top:20px;box-shadow:0 4px 18px rgba(0,0,0,0.12);display:flex;align-items:center;justify-content:space-between;gap:15px;">
                            <div style="font-size:13.5px;color:#5d6a7d;display:flex;align-items:center;gap:10px;">
                                <i class="fas fa-tags" style="color:#14b8a6;font-size:18px;"></i>
                                <span>{_admin.terms.selected} <strong style="color:#17202b;font-size:15px;">{$selectedProductsCount ?? 0}</strong> {_admin.terms.products} · <strong style="color:#042f2e;background:#ccfbf1;padding:3px 10px;border-radius:999px;font-size:14px;font-weight:800;">{$totalLabels ?? 0} {_admin.terms.labels}</strong></span>
                            </div>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <a n:href="clearAllPrintCounts!" class="btn btn-default ajax with-confirm" data-message="{_admin.terms.reallyRemoveLabels}" style="border:1px solid #d9e0e8;border-radius:8px;padding:7px 14px;font-weight:600;color:#5d6a7d;font-size:13px;">
                                    <i class="fa fa-trash-alt text-muted m-r-xxs"></i> {_admin.terms.clearAll}
                                </a>
                                <a href="#" class="btn" style="border:none;border-radius:8px;background:#14b8a6;color:#042f2e;padding:8px 20px;font-size:13.5px;font-weight:800;box-shadow:0 2px 6px rgba(20,184,166,0.3);text-decoration:none;display:inline-flex;align-items:center;gap:6px;" onclick="$('#modal-printPreview').modal('show'); return false;">
                                    {_admin.terms.previewAndPrint} →
                                </a>
                            </div>
                        </div>
                    {/snippet}
                </div>
        </div>
    </div>
</div>


<div id="modal-multiPricesForm" class="modal fade">
    <div class="modal-dialog modal-md">
        <div n:snippet="multiPricesForm" class="modal-content">
            {form multiPricesForm}
                <div class="modal-header">
                    <h4>{_admin.terms.multiPricesChange}</h4>
                </div>
                <div class="modal-body clearfix">
                    <h4 class="m-t-no">{_admin.terms.branches}</h4>
                    <div class="row">
                        <div n:foreach="$branchesPairs as $branchesId => $branhesName" class="col-lg-2">
                            <div class="form-group">
                                {input 'branch__'.$branchesId}
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label price /}
                                {input price class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label price_action /}
                                {input price_action class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label action_from /}
                                {input action_from class => 'form-control date-picker'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label action_to /}
                                {input action_to class => 'form-control date-picker'}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <a href="#" class="btn btn-default mosaic-topbtn" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}
        </div>
    </div>
</div>

<div id="modal-productsForm" class="modal fade">
    <div class="modal-dialog modal-xl">
        <div n:snippet="productsForm" class="modal-content">
            {form productsForm class => 'ajax ajax-modal-close'}
                <div class="modal-header">
                    <h4>{_admin.terms.newProduct}</h4>
                </div>
                <div class="modal-body clearfix">
                    <div class="col-lg-6">
                        <div class="clearfix">
                            <h4>{_admin.terms.mainInfo}</h4>
                            <div class="row">
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        {label is_active /}
                                        {input is_active class => 'form-control'}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label name /}
                                        {input name class => 'form-control form-control-bigger url-source', data-target => '.webalize'}
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group clearfix">
                                        {label slug /}
                                        {input slug class => 'form-control webalize'}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label country_origin /}
											{input country_origin class => 'form-control'}
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label code_ean /}
											{input code_ean class => 'form-control'}
                                    </div>
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label weight /}
                                        <div class="row">
                                            <div class="col-lg-6">
                                                {input weight class => 'form-control'}
                                            </div>
                                            <div class="col-lg-6">
                                                {input units_id class => 'form-control'}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label default_units_weight /}
                                        <div class="row">
                                            <div class="col-lg-6">
                                                {input default_units_weight class => 'form-control'}
                                            </div>
                                            <div class="col-lg-6">
                                                {input default_units_id class => 'form-control'}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h4>{_admin.terms.description}</h4>

                        <div class="form-group">
                            {label perex /}
                            {input perex class => 'form-control wsw h-100'}
                        </div>
                        <div class="form-group">
                            {label text /}
                            {input text class => 'form-control wsw h-400'}
                        </div>
                    </div>

                    <div class="col-lg-6">
                        {include '_formCategories.latte'}

                        {include '_formVariantsInfo.latte', 'variant' => NULL}

                        <div class="clearfix">
                            <h4>{_admin.terms.labels}</h4>
                            <div class="form-group">
                                {label label_note_1 /}
                                {input label_note_1 class => 'form-control'}
                            </div>
                            <div class="form-group">
                                {label label_note_2 /}
                                {input label_note_2 class => 'form-control'}
                            </div>
                            <div class="form-group">
                                {label label_note_3 /}
                                {input label_note_3 class => 'form-control'}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <button n:name="submit_and_edit" class="btn mosaic-topbtn mosaic-topbtn-primary">
                        <i class="fa fa-save"></i> {_admin.buttons.saveAndEdit}
                    </button>
                    <a href="#" class="btn btn-default mosaic-topbtn" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}
        </div>
    </div>
</div>

<div id="modal-labelsForm" class="modal fade">
    <div class="modal-dialog modal-md">
        <div n:snippet="labelsForm" class="modal-content">
            {form labelsForm class => 'ajax ajax-modal-close'}
                <div class="modal-header">
                    <h4>{_admin.terms.prductLabel}{$form['type_id']->getValue() && isset($global['productLabelTypes'][$form['type_id']->getValue()]) ? ' - '.$global['productLabelTypes'][$form['type_id']->getValue()] : ''}</h4>
                </div>
                <div n:if="!empty($productLabel)" class="modal-body clearfix">
                    <div class="hidden">
                        {input products_id}
                        {input branches_id}
