{block topButtons}

    <a n:if="count($filters)" n:href="resetFilters!" class="btn btn-danger btn-addon">
        <i class="far fa-times"></i> {_admin.filters.reset}
    </a>
    <a n:if="$aps->has('create')" n:href="new" class="btn btn-success btn-addon">
        <i class="far fa-plus"></i> {_admin.actions.new}
    </a>
{/block}


{block content}

<div class="col-md-12">
    <div class="panel panel-white">
        <div class="panel-body">
            <div class="clearfix m-b-sm">
                <div class="pull-left">
                    <a href="#" class="btn btn-default slide-toggle" data-target=".import-container">
                        {_admin.terms.import} <i class="fa fa-chevron-down m-l-xxs"></i>
                    </a>
                    {control bulkActions:button}
                </div>
                <div class="pull-right">
                    <a n:href="Categories:" class="btn btn-primary btn-addon">
                        <i class="fa fa-list"></i> {_admin.terms.categories}
                    </a>
                </div>
            </div>
            {include '_importDropdown.latte'}
            {control bulkActions}

            {snippet topFilters}
                {form filters-form}
                    <div class="clearfix m-b-sm">
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-240">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-100">{_admin.terms.branch}:</span>
                                <div class="pull-left w-140">
                                    <div class="form-group m-b-no">
                                        {input custom__branches class => 'change-to-submit'}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-240">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-100">{_admin.terms.isActive}:</span>
                                <div class="pull-left w-140">
                                    {input custom__is_active class => 'change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-240">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-100">{_admin.terms.isAction}:</span>
                                <div class="pull-left w-140">
                                    {input custom__is_action class => 'change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-240">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-100">{_admin.terms.labels}:</span>
                                <div class="pull-left w-140">
                                    {input custom__labels class => 'form-control change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-right m-t-xxs m-b-xxs">
                            <a n:href="product!" class="btn btn-primary btn-addon ajax-modal" data-target="#modal-productsForm">
                                <i class="fa fa-circle-plus"></i> {_admin.terms.newProduct}
                            </a>
                        </div>
                        <div class="pull-right m-t-xxs m-b-xxs m-r-xxs">
                            <a n:href="multiPrices!" class="btn btn-primary btn-addon ajax-modal" data-target="#modal-multiPricesForm">
                                <i class="fa fa-files"></i> {_admin.terms.multiplePrice}
                            </a>
                        </div>
                        <div class="pull-right m-t-xxs m-b-xxs m-r-xxs">
                            <a n:href="prepareMultiSale!" class="btn btn-primary btn-addon ajax-modal" data-target="#modal-multiSaleForm">
                                <i class="fa fa-percent"></i> {_admin.terms.multipleSale}
                            </a>
                        </div>
                    </div>
                    <div class="clearfix m-b-sm">
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-240">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-100">{_admin.terms.category}:</span>
                                <div class="pull-left w-140">
                                    {input custom__category class => 'form-control change-to-submit'}
                                </div>
                            </div>
                        </div>
                        <div class="pull-left m-r-xs m-t-xxs m-b-xxs w-500">
                            <div class="input-group pull-left">
                                <span class="input-group-addon w-100">{_admin.terms.name}/{_admin.terms.ean}:</span>
                                <div class="pull-left w-390">
                                    {input custom__name class => 'form-control autocomplete change-to-submit', 'data-url' => $presenter->link('productsAutocomplete!')}
                                </div>
                            </div>
                        </div>
                        <div class="pull-right m-t-xxs m-r-xxs">
                            <a n:href="removePrint!" class="btn btn-primary btn-addon with-confirm" data-message="{_admin.terms.reallyRemoveLabels}">
                                <i class="fa fa-trash"></i> {_admin.terms.removeLabels}
                            </a>
                        </div>
                        <div class="pull-right m-t-xxs m-r-xxs">
                            <a n:href="downloadPdf!" target="_blank" class="btn btn-primary btn-addon">
                                <i class="fa fa-file-download"></i> {_admin.terms.downloadLabels}
                            </a>
                        </div>
                        <div class="pull-right m-t-xxs m-r-xxs">
                            <a n:href="toPrint!" class="btn btn-default btn-addon">
                                <i class="fa fa-filter"></i> {_admin.terms.toPrint}
                            </a>
                        </div>
                    </div>
                {/form}
            {/snippet}


                <div class="table-responsive dataTables_wrapper m-t-lg">
                        <table class="table table-striped table-hover table-compact">
                            <thead>
                            <tr>
                                <th class="w-40"></th>
                                <th class="w-50"></th>
                                <th>
                                    <div class="w-300">
                                        <strong>{_admin.terms.name} {control sorting 'name'} / {_admin.terms.code} {control sorting 'code'} / {_admin.terms.createdAt} {control sorting 'created_at'}</strong>
                                    </div>
                                </th>
                                <th class="visible-xxl w-200">
                                    <div class="w-200"><strong>{_admin.terms.category}</strong></div>
                                </th>
                                <th class="w-450 text-center" colspan="4">
                                    <div class="w-450"><strong>{_admin.terms.action}</strong></div>
                                </th>
                                <th class="w-330 text-center">
                                    <div class="w-330"><strong>{_admin.terms.labels}</strong></div>
                                </th>
                                <th class="w-60 text-center">
                                    <i class="far fa-eye" data-toggle="tooltip" title="{_admin.terms.isActive}"></i>
                                </th>
                                <th class="w-20">
                                    <div class="w-20"></div>
                                </th>
                            </tr>
                            <tr>
                                <th colspan="3"></th>
                                <th class="visible-xxl"></th>
                                <th class="w-180 text-center">
                                    <div class="w-180">{_admin.terms.price}</div>
                                </th>
                                <th class="w-210 text-center">
                                    <div class="w-210">{_admin.terms.date}</div>
                                </th>
                                <th class="w-40 text-center">
                                    <div class="w-40"><i class="fa fa-save"></i></div>
                                </th>
                                <th class="w-40 text-center">
                                    <div class="w-40"><i class="far fa-percent"></i></div>
                                </th>
                                <th></th>
                                <th colspan="2">
                                </th>
                            </tr>
                            </thead>
                            <tbody n:snippet="list">
                            {foreach $items as $item}
                                {var $price = $item->getPrice($presenter->session->filters[$presenter->getName()]['custom__branches'])}
                                <tr class="row-as-link" data-id="{$item->id}">
                                    <td class="row-as-link-ignore">
                                        {control bulkActions:checkbox $item}
                                    </td>

                                    <td class="td-image">
                                        <img n:if="$image = $item->getImage()" src="{$image->file|image:adminGallery}" />
                                    </td>
                                    <td>
                                        <small><i class="far fa-clock" title="{_admin.terms.createdAt}: {$item->created_at|date:'d.m.Y H:i'}" data-toggle="tooltip"></i></small>
                                        <strong>{$item->name}</strong><br />
                                        <small class="pull-left">
                                            {if $item->code_ean}
                                                {_admin.terms.ean}: {$item->code_ean}
                                            {/if}
                                        </small>
                                    </td>
                                    <td class="visible-xxl">
                                        {foreach $item->getCategories() as $i}
                                            <span>{$i->name}</span>{sep}<br>{/sep}
                                        {/foreach}
                                    </td>
                                    <td class="row-as-link-ignore product-price-fields">
                                        <div class="p-relative">
                                            <label class="pull-left w-70">{_admin.terms.basePrice}:</label>
                                            <input type="number" data-item-id="{$price->id ?? NULL}" step="0.01" class="form-control form-control-sm pull-left w-90 text-right" name="price__{$item->id}" value="{$price && $price->price? $price->price : 0}">
                                        </div>
                                        <a n:href="showPricesLog! $item->id, $presenter->session->filters[$presenter->getName()]['custom__branches']" class="pull-right ajax-modal" data-target="#modal-pricesLog">
                                            <i class="far fa-clock"></i>
                                        </a>
                                        <div class="clearfix m-b-xxs"></div>
                                        <div class="p-relative">
                                            <label class="pull-left w-70">{_admin.terms.actionPriceAbb}:</label>
                                            <input type="number" data-item-id="{$price->id ?? NULL}" step="0.01" class="form-control form-control-sm pull-left w-90 text-right" name="price_action__{$item->id}" value="{$price && $price->price_action ? $price->price_action : ''}">
                                        </div>
                                        <i class="far fa-circle-info pull-right text-default" data-toggle="tooltip" title="{$item->formatBranchTooltip($branchesPairs, 'price_action')}" style="margin-top: 2px;"></i>
                                        {var $refPrice = $item->getRefPrice($presenter->session->filters[$presenter->getName()]['custom__branches'])}
                                        {if $refPrice}
                                            <div class="clearfix"></div>
                                            <span class="label label-warning" style="font-weight: normal; font-size: 10px; display: inline-block; margin-top: 2px;" data-toggle="tooltip" title="Na webu se jako přeškrtnutá cena zobrazí {$refPrice|price} (nejnižší cena za posledních 30 dní), nikoliv základní cena.">
                                                <i class="fas fa-triangle-exclamation"></i> Přeškrtnutá cena: {$refPrice|price}
                                            </span>
                                        {/if}
                                    </td>
                                    <td class="row-as-link-ignore product-date-fields">
                                        <div class="calendar-today-overlay">
                                            <div class="p-relative">
                                                <label class="pull-left w-70">{_admin.terms.actionFrom}:</label>
                                                <input type="text" data-item-id="{$price->id ?? NULL}" class="form-control form-control-sm pull-left w-90 text-center date-picker" name="action_from__{$item->id}" value="{$price && $price->action_from ? $price->action_from->format('d.m.Y') : ''}">
                                            </div>
                                            <a href="#" class="pull-left m-l-xxs calendar-today-btn"><i class="fa fa-calendar-day"></i></a>
                                        </div>
                                        <i class="far fa-circle-info pull-right text-default" data-toggle="tooltip" title="{$item->formatBranchTooltip($branchesPairs, 'action_from')}" style="margin-top: 2px;"></i>
                                        <div class="clearfix m-b-xxs"></div>
                                        <div class="calendar-today-overlay">
                                            <div class="p-relative calendar-today-overlay">
                                                <label class="pull-left w-70">{_admin.terms.actionTo}:</label>
                                                <input type="text" data-item-id="{$price->id ?? NULL}" class="form-control form-control-sm pull-left w-90 text-center date-picker" name="action_to__{$item->id}" value="{$price && $price->action_to ? $price->action_to->format('d.m.Y') : ''}">
                                            </div>
                                            <a href="#" class="pull-left m-l-xxs calendar-today-btn"><i class="fa fa-calendar-day"></i></a>
                                        </div>
                                        <i class="far fa-circle-info pull-right text-default" data-toggle="tooltip" title="{$item->formatBranchTooltip($branchesPairs, 'action_to')}" style="margin-top: 2px;"></i>
                                    </td>
                                    <td class="row-as-link-ignore text-center">
                                        <button type="button" class="btn btn-default btn-sm btn-save-prices hidden" title="{_admin.buttons.save}" data-products-id="{$item->id}" style="float: none; margin-right: 0;">
                                            <i class="fa fa-save"></i>
                                        </button>
                                    </td>
                                    <td class="row-as-link-ignore text-center">
                                        {control "productActions-$item->id"}
                                    </td>
                                    <td class="row-as-link-ignore text-center">
                                        {control "productLabels-$item->id"}
                                    </td>
                                    <td class="text-center row-as-link-ignore">
                                        {include APP_DIR.'/AdminModule/__inc/boolSwitch.latte', 'item' => $item, 'param' => 'is_active', 'isEye' => TRUE}
                                    </td>
                                    <td class="actions row-as-link-ignore">
                                        <div class="dropdown pull-left">
                                            <a class="dropdown-toggle btn btn-default m-r-no" data-toggle="dropdown" href="#">
                                                <i class="fa fa-bars"></i>
                                            </a>
                                            <ul class="dropdown-menu dropdown-menu-right dropdown-list">
                                                {control baseActions $item, $iterator}
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {/foreach}
                            </tbody>
                        </table>

                    {control paginator}
                </div>
        </div>
    </div>
</div>


<div id="modal-multiPricesForm" class="modal fade">
    <div class="modal-dialog modal-md">
        <div n:snippet="multiPricesForm" class="modal-content">
            {form multiPricesForm}
                <div class="modal-header">
                    <h4>{_admin.terms.multiPricesChange}</h4>
                </div>
                <div class="modal-body clearfix">
                    <h4 class="m-t-no">{_admin.terms.branches}</h4>
                    <div class="row">
                        <div n:foreach="$branchesPairs as $branchesId => $branhesName" class="col-lg-2">
                            <div class="form-group">
                                {input 'branch__'.$branchesId}
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label price /}
                                {input price class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label price_action /}
                                {input price_action class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label action_from /}
                                {input action_from class => 'form-control date-picker'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label action_to /}
                                {input action_to class => 'form-control date-picker'}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn btn-success btn-addon">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <a href="#" class="btn btn-default btn-addon" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}
        </div>
    </div>
</div>

<div id="modal-productsForm" class="modal fade">
    <div class="modal-dialog modal-xl">
        <div n:snippet="productsForm" class="modal-content">
            {form productsForm class => 'ajax ajax-modal-close'}
                <div class="modal-header">
                    <h4>{_admin.terms.newProduct}</h4>
                </div>
                <div class="modal-body clearfix">
                    <div class="col-lg-6">
                        <div class="clearfix">
                            <h4>{_admin.terms.mainInfo}</h4>
                            <div class="row">
                                <div class="col-sm-4">
                                    <div class="form-group">
                                        {label is_active /}
                                        {input is_active class => 'form-control'}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label name /}
                                        {input name class => 'form-control form-control-bigger url-source', data-target => '.webalize'}
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group clearfix">
                                        {label slug /}
                                        {input slug class => 'form-control webalize'}
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label country_origin /}
											{input country_origin class => 'form-control'}
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label code_ean /}
											{input code_ean class => 'form-control'}
                                    </div>
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label weight /}
                                        <div class="row">
                                            <div class="col-lg-6">
                                                {input weight class => 'form-control'}
                                            </div>
                                            <div class="col-lg-6">
                                                {input units_id class => 'form-control'}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        {label default_units_weight /}
                                        <div class="row">
                                            <div class="col-lg-6">
                                                {input default_units_weight class => 'form-control'}
                                            </div>
                                            <div class="col-lg-6">
                                                {input default_units_id class => 'form-control'}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h4>{_admin.terms.description}</h4>

                        <div class="form-group">
                            {label perex /}
                            {input perex class => 'form-control wsw h-100'}
                        </div>
                        <div class="form-group">
                            {label text /}
                            {input text class => 'form-control wsw h-400'}
                        </div>
                    </div>

                    <div class="col-lg-6">
                        {include '_formCategories.latte'}

                        {include '_formVariantsInfo.latte', 'variant' => NULL}

                        <div class="clearfix">
                            <h4>{_admin.terms.labels}</h4>
                            <div class="form-group">
                                {label label_note_1 /}
                                {input label_note_1 class => 'form-control'}
                            </div>
                            <div class="form-group">
                                {label label_note_2 /}
                                {input label_note_2 class => 'form-control'}
                            </div>
                            <div class="form-group">
                                {label label_note_3 /}
                                {input label_note_3 class => 'form-control'}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn btn-success btn-addon">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <button n:name="submit_and_edit" class="btn btn-success btn-addon">
                        <i class="fa fa-save"></i> {_admin.buttons.saveAndEdit}
                    </button>
                    <a href="#" class="btn btn-default btn-addon" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}
        </div>
    </div>
</div>

<div id="modal-labelsForm" class="modal fade">
    <div class="modal-dialog modal-md">
        <div n:snippet="labelsForm" class="modal-content">
            {form labelsForm class => 'ajax ajax-modal-close'}
                <div class="modal-header">
                    <h4>{_admin.terms.prductLabel}{$form['type_id']->getValue() && isset($global['productLabelTypes'][$form['type_id']->getValue()]) ? ' - '.$global['productLabelTypes'][$form['type_id']->getValue()] : ''}</h4>
                </div>
                <div n:if="!empty($productLabel)" class="modal-body clearfix">
                    <div class="hidden">
                        {input products_id}
                        {input branches_id}
                        {input type_id class => 'toggle-trigger', 'data-target' => '.labelType'}
                    </div>
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="form-group">
                                {label product_label_headers_id /}
                                {input product_label_headers_id class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="form-group">
                                {label count /}
                                {input count class => 'form-control'}
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        {label name /}
                        {input name class => 'form-control form-control-bigger'}
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label sale_percent /}
                                {input sale_percent class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label price_text /}
                                {input price_text class => 'form-control toggle-trigger', 'data-target' => '.labelPriceText'}
                            </div>
                        </div>
                        <div class="col-lg-6 labelPriceText" data-show-on="{\ProductLabelsEntity::PRICE_TYPE_CZK_100g}">
                            <div class="form-group">
                                {label default_units_weight /}
                                <div class="row">
                                    <div class="col-lg-6">
                                        {input default_units_weight class => 'form-control'}
                                    </div>
                                    <div class="col-lg-6">
                                        {input default_units_id class => 'form-control'}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label is_more_species /}
                                {input is_more_species class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                {label origin_countries_id /}
                                {input origin_countries_id class => 'form-control'}
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        {label sale_text /}
                        <div class="row">
                            <div class="col-lg-6">
                                <select class="change-handler" data-handler="{link setLabelActionType!}&form=labelsForm&productsId={$form['products_id']->getValue()}&idItem=">
                                    <option>- Vyberte -</option>
                                    <option n:foreach="$productLabelActionTypesPairs as $labelActionTypeId => $labelActionTypeName" value="{$labelActionTypeId}">{$labelActionTypeName}</option>
                                </select>
                            </div>
                            <div class="col-lg-6">
                                {input sale_text class => 'form-control'}
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        {label note_1 /}
                        {input note_1 class => 'form-control'}
                    </div>
                    <div class="form-group">
                        {label note_2 /}
                        {input note_2 class => 'form-control'}
                    </div>
                    <div class="form-group">
                        {label note_3 /}
                        {input note_3 class => 'form-control'}
                    </div>
                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn btn-success btn-addon">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <a href="#" class="btn btn-default btn-addon" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}
        </div>
    </div>
</div>


<div id="modal-multiLabelsForm" class="modal fade">
    <div class="modal-dialog modal-lg-2">
        <div n:snippet="multiLabelsForm" class="modal-content">
            {form multiLabelsForm class => 'ajax ajax-modal-close'}
                <div class="modal-header">
                    <h4>{_admin.terms.prductLabel}</h4>
                </div>
                <div n:if="!empty($productLabel)" class="modal-body clearfix">
                    <div class="hidden">
                        {input products_id}
                        {input branches_id}
                    </div>
                    <div class="row">
                        <div class="col-lg-9">
                            <h3 class="m-t-no">&nbsp;</h3>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        {label product_label_headers_id /}
                                        {input product_label_headers_id class => 'form-control'}
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                {label name /}
                                {input name class => 'form-control form-control-bigger'}
                            </div>
                            <div class="row">
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        {label sale_percent /}
                                        {input sale_percent class => 'form-control'}
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        {label price_text /}
                                        {input price_text class => 'form-control toggle-trigger', 'data-target' => '.multiLabelPriceText'}
                                    </div>
                                </div>
                                <div class="col-lg-6 multiLabelPriceText" data-show-on="{\ProductLabelsEntity::PRICE_TYPE_CZK_100g}">
                                    <div class="form-group">
                                        {label default_units_weight /}
                                        <div class="row">
                                            <div class="col-lg-6">
                                                {input default_units_weight class => 'form-control'}
                                            </div>
                                            <div class="col-lg-6">
                                                {input default_units_id class => 'form-control'}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        {label is_more_species /}
                                        {input is_more_species class => 'form-control'}
                                    </div>
                                </div>
                                <div class="col-lg-3">
                                    <div class="form-group">
                                        {label origin_countries_id /}
                                        {input origin_countries_id class => 'form-control'}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                {label sale_text /}
                                <div class="row">
                                    <div class="col-lg-6">
                                        <select class="change-handler" data-handler="{link setLabelActionType!}&form=multiLabelsForm&productsId={$form['products_id']->getValue()}&idItem=">
                                            <option>- Vyberte -</option>
                                            <option n:foreach="$productLabelActionTypesPairs as $labelActionTypeId => $labelActionTypeName" value="{$labelActionTypeId}">{$labelActionTypeName}</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-6">
                                        {input sale_text class => 'form-control'}
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                {label note_1 /}
                                {input note_1 class => 'form-control'}
                            </div>
                            <div class="form-group">
                                {label note_2 /}
                                {input note_2 class => 'form-control'}
                            </div>
                            <div class="form-group">
                                {label note_3 /}
                                {input note_3 class => 'form-control'}
                            </div>
                        </div>
                        <div class="col-lg-2 col-lg-offset-1">
                            <h3 class="m-t-no">{_admin.terms.numberOfPrints}</h3>
                            <div n:foreach="$global['productLabelTypes'] as $productLabelTypeId => $productLabelType" class="form-group">
                                {label 'label_type_count__'.$productLabelTypeId /}
                                {input 'label_type_count__'.$productLabelTypeId class => 'form-control'}
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn btn-success btn-addon">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <a href="#" class="btn btn-default btn-addon" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}
        </div>
    </div>
</div>


<div id="modal-multiSaleForm" class="modal fade">
    <div class="modal-dialog modal-lg-2">
        <div n:snippet="multiSaleForm" class="modal-content">
            {form multiSaleForm class => 'ajax ajax-modal-close'}
                <div class="modal-header">
                    <h4>{_admin.terms.sale}</h4>
                </div>
                <div class="modal-body clearfix">
                    {var $multiSaleProducts = $presenter->getMultiSaleProducts()}
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label>{_admin.terms.ean}</label>
                                <input type="text" class="form-control enter-to-change change-to-ajax" id="multiSale-ean" data-url="{link addMultiSaleProduct!}&ean=-1">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                {label branches_ids /}
                                {input branches_ids class => 'form-control change-to-ajax', 'data-url' => $presenter->link('setMultiSaleBranches!').'&branchesIds=-1'}
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                {label action_from /}
                                <div class="input-group calendar-today-overlay">
                                    {input action_from class => 'form-control date-picker change-to-ajax', 'data-url' => $presenter->link('setMultiSaleDate!', 'action_from').'&value=-1'}
                                    <span class="input-group-btn">
                                        <a href="#" class="calendar-today-btn btn btn-default"><i class="fa fa-calendar-day"></i></a>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                {label action_to /}
                                <div class="input-group calendar-today-overlay">
                                    {input action_to class => 'form-control date-picker change-to-ajax', 'data-url' => $presenter->link('setMultiSaleDate!', 'action_to').'&value=-1'}
                                    <span class="input-group-btn">
                                        <a href="#" class="calendar-today-btn btn btn-default"><i class="fa fa-calendar-day"></i></a>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div n:if="!empty($multiSaleProducts) && count($multiSaleProducts)" class="row">
                        <div class="col-sm-12">
                            <div class="table-responsive dataTables_wrapper">
                                <table class="table table-striped table-hover table-compact">
                                    <thead>
                                    <tr>
                                        <th class="w-50"></th>
                                        <th>
                                            <div class="w-300">
                                                <strong>{_admin.terms.name} / {_admin.terms.code}</strong>
                                            </div>
                                        </th>
                                        <th class="w-180 text-center">
                                            <div class="w-180">{_admin.terms.price}</div>
                                        </th>
                                        <th class="w-180 text-center">
                                            <div class="w-180">{_admin.terms.date}</div>
                                        </th>
                                        <th class="w-20">
                                            <div class="w-20"></div>
                                        </th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {foreach $multiSaleProducts as $multiSaleProduct}
                                        {var $multiSaleProductPrice = $multiSaleProduct->getPrice($presenter->session->filters[$presenter->getName()]['custom__branches'])}
                                        <tr>
                                            <td class="td-image">
                                                <img n:if="$multiSaleProductImage = $multiSaleProduct->getImage()" src="{$multiSaleProductImage->file|image:adminGallery}" />
                                            </td>
                                            <td>
                                                <small><i class="far fa-clock" title="{_admin.terms.createdAt}: {$multiSaleProduct->created_at|date:'d.m.Y H:i'}" data-toggle="tooltip"></i></small>
                                                <strong>{$multiSaleProduct->name}</strong><br />
                                                <small class="pull-left">
                                                    {if $multiSaleProduct->code_ean}
                                                        {_admin.terms.ean}: {$multiSaleProduct->code_ean}
                                                    {/if}
                                                </small>
                                            </td>
                                            <td class="row-as-link-ignore">
                                                <div class="p-relative">
                                                    <label class="pull-left w-70">{_admin.terms.basePrice}:</label>
                                                    <input type="number" data-item-id="{$multiSaleProductPrice->id ?? NULL}" step="0.01" class="form-control form-control-sm pull-left w-90 text-right multi-sale-price" data-id="{$multiSaleProduct->id}" name="price__{$multiSaleProduct->id}" value="{$presenter->getMultiSaleProductPrice($multiSaleProduct->id) ?? ($multiSaleProductPrice && $multiSaleProductPrice->price? $multiSaleProductPrice->price : 0)}">
                                                </div>
                                                <div class="clearfix m-b-xxs"></div>
                                                <div class="p-relative">
                                                    <label class="pull-left w-70">{_admin.terms.actionPriceAbb}:</label>
                                                    <input type="number" data-item-id="{$multiSaleProductPrice->id ?? NULL}" step="0.01" class="form-control form-control-sm pull-left w-90 text-right multi-sale-action-price" data-id="{$multiSaleProduct->id}" name="price_action__{$multiSaleProduct->id}" value="{$presenter->getMultiSaleProductActionPrice($multiSaleProduct->id) ?? ($multiSaleProductPrice && $multiSaleProductPrice->price_action ? $multiSaleProductPrice->price_action : '')}">
                                                </div>
                                                <i class="far fa-circle-info pull-right text-default" data-toggle="tooltip" title="{$multiSaleProduct->formatBranchTooltip($branchesPairs, 'price_action')}" style="margin-top: 2px;"></i>
                                            </td>
                                            <td class="row-as-link-ignore">
                                                <div class="calendar-today-overlay">
                                                    <div class="p-relative">
                                                        <label class="pull-left w-70">{_admin.terms.actionFrom}:</label>
                                                        <input type="text" data-item-id="{$multiSaleProductPrice->id ?? NULL}" class="form-control form-control-sm pull-left w-90 text-center date-picker" readonly="readonly" value="{$multiSaleProductPrice && $multiSaleProductPrice->action_from ? $multiSaleProductPrice->action_from->format('d.m.Y') : ''}">
                                                    </div>
                                                </div>
                                                <i class="far fa-circle-info pull-right text-default" data-toggle="tooltip" title="{$multiSaleProduct->formatBranchTooltip($branchesPairs, 'action_from')}" style="margin-top: 2px;"></i>
                                                <div class="clearfix m-b-xxs"></div>
                                                <div class="calendar-today-overlay">
                                                    <div class="p-relative calendar-today-overlay">
                                                        <label class="pull-left w-70">{_admin.terms.actionTo}:</label>
                                                        <input type="text" data-item-id="{$multiSaleProductPrice->id ?? NULL}" class="form-control form-control-sm pull-left w-90 text-center date-picker" readonly="readonly" value="{$multiSaleProductPrice && $multiSaleProductPrice->action_to ? $multiSaleProductPrice->action_to->format('d.m.Y') : ''}">
                                                    </div>
                                                </div>
                                                <i class="far fa-circle-info pull-right text-default" data-toggle="tooltip" title="{$multiSaleProduct->formatBranchTooltip($branchesPairs, 'action_to')}" style="margin-top: 2px;"></i>
                                            </td>
                                            <td class="text-center">
                                                <a n:href="removeMultiSaleProduct! $multiSaleProduct->id" class="icon-md ajax"><i class="fa fa-times-circle text-danger"></i></a>
                                            </td>
                                        </tr>
                                    {/foreach}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div n:if="empty($multiSaleProducts) || !count($multiSaleProducts)" class="alert alert-info m-t-lg">
                        Zatím nebyly načteny žádné produkty
                    </div>
                </div>
                <div class="modal-footer">
                    <button n:name="submit" class="btn btn-success btn-addon">
                        <i class="fa fa-save"></i> {_admin.buttons.save}
                    </button>
                    <a href="#" class="btn btn-default btn-addon" data-dismiss="modal">
                        <i class="fa fa-times"></i> {_admin.buttons.close}
                    </a>
                </div>
            {/form}

            <script>
                $(function() {
					$("#multiSale-ean").focus();
                })
            </script>
        </div>
    </div>
</div>

{snippet javascripts}
    <script n:if="!empty($newProductModal)">
        $(function() {
	        ajaxGet("?do=product{if !empty($newProductModalEan)}&ean={$newProductModalEan|noescape}{/if}{if !empty($newProductModalIsMultiSale)}&isMultiSale={$newProductModalIsMultiSale|noescape}{/if}", function() {
		        $("#modal-productsForm").modal('show');
	        })
        })
    </script>
    <script n:if="!empty($editProductWindowId)">
	    window.open('/admin/products/edit/{$editProductWindowId}?ct=1', '_blank');
    </script>
{/snippet}

{snippetArea modalWrapper}
	{include APP_DIR . '/AdminModule/Products/templates/__inc/pricesLogModal.latte'}
{/snippetArea}