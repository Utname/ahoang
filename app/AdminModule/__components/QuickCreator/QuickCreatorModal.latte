<div id="modal-quickCreator-{$control->getName()}" class="modal fade" tabindex="-1">
	<div class="modal-dialog modal-sm-2">
		<div class="modal-content">
			{form form class => 'ajax ajax-modal-close'}
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal"><span>×</span></button>
					<h4 class="modal-title">{if $control->getModalTitle()}{$control->getModalTitle()}{else}{_admin.actions.new}{/if}</h4>
				</div>
				{snippet form}
					<div class="modal-body clearfix">
						<div class="row">
							{var $isFirst = TRUE}
							{foreach $control['form']->getComponents() as $key => $component}
								{var $attributes = isset($inputParentHtmlAttributes[$key]) ? $inputParentHtmlAttributes[$key] : []}
								{if $component instanceof Nette\Forms\Controls\TextInput || $component instanceof Nette\Forms\Controls\TextArea || $component instanceof Nette\Forms\Controls\SelectBox || $component instanceof Nette\Forms\Controls\UploadControl}
									<div {foreach $attributes as $attribute => $value}{$attribute|noescape}="{$value|noescape}"{sep} {/sep}{/foreach} {if !isset($attributes['class'])}class="{$control::DEFAULT_PARENT_CLASS}"{/if}>
										{label $key /}
										{input $key class => isset($component->getControl()->attrs['class']) ? $component->getControl()->attrs['class'] : ($isFirst ? $control::DEFAULT_FIRST_INPUT_CLASS : $control::DEFAULT_INPUT_CLASS)}
									</div>
									{var $isFirst = FALSE}
								{/if}
							{/foreach}
						</div>
					</div>
				{/snippet}
				<div class="modal-footer">
					<div class="btns">
						<button n:name="submit" class="btn btn-success btn-addon">
							<i class="far fa-check"></i> {_admin.buttons.save}
						</button>
						<button type="button" class="btn btn-default btn-addon" data-dismiss="modal">
							<i class="far fa-times"></i> {_admin.buttons.close}
						</button>
					</div>
				</div>
			{/form}
		</div>
	</div>
</div>
