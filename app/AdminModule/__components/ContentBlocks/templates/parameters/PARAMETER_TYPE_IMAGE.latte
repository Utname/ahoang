<div class="form-group">
	<label n:if="$label">{$label}</label>
	<input type="file" name="types_id-{$sectionTypeKey}-{$parameterKey}" class="form-control {$customClass}" />
	{control attachment:image, $block, $parameterKey, 'admin'}
	<p n:if="$helpBlockText" class="help-block">{$helpBlockText}</p>
</div>
