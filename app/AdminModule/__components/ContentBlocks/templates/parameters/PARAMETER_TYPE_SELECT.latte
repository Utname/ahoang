<div class="form-group">
	{var $options = $control->getInputOptions($parameter)}
	<label n:if="$label">{$label}</label>
	<select name="types_id-{$sectionTypeKey}-{$parameterKey}" class="{$customClass}">
		<option n:foreach="$options as $optionKey => $optionName" value="{$optionKey}"{if $value == $optionKey} selected="selected"{/if}>{isset($parameter[\ContentBlocksDefinition::OPTIONS]) ? $control->getTranslator()->translate($optionName) : $optionName}</option>
	</select>
	<p n:if="$helpBlockText" class="help-block">{$helpBlockText}</p>
</div>
