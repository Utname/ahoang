<div id="modal-{$control->getName()}-sectionForm" class="modal fade">
	<div class="modal-dialog">
		<div class="modal-content" n:snippet="sectionForm">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" title="{_admin.buttons.close}">
					<span aria-hidden="true">×</span>
				</button>
				<h4>{_admin.terms.contents_section}</h4>
			</div>
			{form sectionForm class => 'ajax ajax-modal-close'}
				<div class="modal-body clearfix">
					<div class="form-group">
						{label name /}
						{input name class => "form-control"}
					</div>
					<div class="form-group">
						{label types_id /}
						{input types_id class => "form-control toggle-trigger", data-target => ".toggle-content-types_id"}
					</div>
					<div n:foreach="$control->getSectionTypes() as $sectionTypeKey => $sectionType" class="toggle-content-types_id" data-show-on="{$sectionTypeKey}">
						<div n:foreach="$sectionType[\ContentSectionsDefinition::PARAMETERS] as $parameterKey => $parameter">
							{include '_parameterField.latte', 'sectionTypeKey' => $sectionTypeKey, 'parameterKey' => $parameterKey, 'parameter' => $parameter, 'value' => $selectedSection ? $selectedSection->getValue($parameterKey) : NULL}
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button n:name="submit" class="btn btn-success btn-addon">
						<i class="far fa-check"></i> {_admin.buttons.save}
					</button>
					<button type="button" class="btn btn-default btn-addon" data-dismiss="modal">
						<i class="far fa-times"></i> {_admin.buttons.close}
					</button>
				</div>
			{/form}
		</div>
	</div>
</div>
