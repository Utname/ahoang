{* "Admin - Produkty v2" row parts, see ProductLabelsControl::renderPrice/Chips/Panel(). *}
{if $part === 'price' || $part === 'all'}
{snippet price}
    {var $item = $control->getItem()}
    {var $branchesId = $control->getBranchesId()}
    {var $price = $item ? $item->getPrice($branchesId) : NULL}
    {var $status = \App\AdminModule\Presenters\ProductLabelsControl::getActionStatus($price)}
    {var $running = $status === \App\AdminModule\Presenters\ProductLabelsControl::STATUS_RUNNING}
    {var $unit = $item ? $item->getPriceUnit() : 'Kč'}
    {var $types = \ProductLabelsEntity::TYPES_ARR}
    {var $typeNames = $GLOBALS['global']['productLabelTypes']}
    {var $hdrPlaceholder = 999999}
    {if $item}
        <button type="button" class="pv-cellbtn pv-open-price" data-id="{$item->id}">
            {* a price row without a regular price (NULL, e.g. from a quick create) counts as no price *}
            {if !$price || $price->price === NULL}
                <span class="pv-muted">{_admin.pv.noPrice}</span>
            {elseif $running}
                <span class="pv-strike">{$price->price|number:2,',',' '} <span class="pv-unit-txt">{$unit}</span></span>
                <span class="pv-main"><b class="pv-akce-price">{$price->price_action|number:2,',',' '} <span class="pv-unit-txt">{$unit}</span></b><span class="pv-pct">−{=round(((float)$price->price - (float)$price->price_action) / (float)$price->price * 100)} %</span></span>
            {else}
                <span class="pv-main"><b>{$price->price|number:2,',',' '} <span class="pv-unit-txt">{$unit}</span></b></span>
            {/if}
        </button>
        <button type="button" class="pv-cellbtn pv-open-price" data-id="{$item->id}">
            <span class="pv-status pv-st-{$status}">{_"admin.pv.status.$status"}</span>
            {* the typed action price also when the action is not running (no "od" date, planned, ended) *}
            <span n:if="!$running && $price && (float)$price->price_action > 0" class="pv-akce-line">{$price->price_action|number:2,',',' '} <span class="pv-unit-txt">{$unit}</span></span>
            <span class="pv-range">
                {if $price && ($price->action_from || $price->action_to)}
                    {* saved dates always show; without a lower action price they do nothing *}
                    {$price->action_from ? ($price->action_from|date:'d.m.') : '…'} – {$price->action_to ? ($price->action_to|date:'d.m.Y') : '…'}
                {else}
                    {_admin.pv.setAkce}
                {/if}
            </span>
            {if $status === \App\AdminModule\Presenters\ProductLabelsControl::STATUS_NONE && $price && ($price->action_from || $price->action_to)}
                <span class="pv-missing">{(float)$price->price_action <= 0 ? ('admin.pv.missingAkcePrice'|translate) : ((float)$price->price_action >= (float)$price->price ? ('admin.pv.hint.badPrice'|translate) : ('admin.pv.missingFrom'|translate))}</span>
            {elseif $price && (float)$price->price_action > 0 && !$price->action_from && !$price->action_to}
                <span class="pv-missing">{_admin.pv.missingFrom}</span>
            {/if}
        </button>
    {/if}
{/snippet}
{/if}

{if $part === 'chips' || $part === 'all'}
{snippet chips}
    {var $item = $control->getItem()}
    {var $branchesId = $control->getBranchesId()}
    {var $price = $item ? $item->getPrice($branchesId) : NULL}
    {var $status = \App\AdminModule\Presenters\ProductLabelsControl::getActionStatus($price)}
    {var $running = $status === \App\AdminModule\Presenters\ProductLabelsControl::STATUS_RUNNING}
    {var $unit = $item ? $item->getPriceUnit() : 'Kč'}
    {var $types = \ProductLabelsEntity::TYPES_ARR}
    {var $typeNames = $GLOBALS['global']['productLabelTypes']}
    {var $hdrPlaceholder = 999999}
    {if $item}
        {var $labels = $control->getLabels()}
        {var $counts = $control->getCounts()}
        {var $headers = $control->getHeaderPairs()}
        <div class="pv-chips">
            {if !$price}
                <span class="pv-muted">{_admin.terms.noBasicPrice}</span>
            {/if}
            {* std / spec chips first, Akce last (as in the design) *}
            {foreach [FALSE, TRUE] as $akcePass}
                {foreach $types as $typeId => $def}
                    {continueIf empty($counts[$typeId]) || \ProductLabelsEntity::isAkceType($typeId) !== $akcePass}
                    {var $label = $labels[$typeId] ?? NULL}
                    {var $hdrId = $label && $label->product_label_headers_id ? (int)$label->product_label_headers_id : $control->getDefaultHeaderId($typeId)}
                    <span class="pv-chip" title="{$typeNames[$typeId]} ×{$counts[$typeId]} · {$headers[$hdrId] ?? ''}">
                        <span n:class="pv-chip-badge, $akcePass ? pv-akce">
                            <span class="pv-chip-l">{$typeNames[$typeId]}</span>
                            <span class="pv-chip-n">×{$counts[$typeId]}</span>
                        </span>
                        <select class="pv-hdr select-default" title="{_admin.pv.header}" data-url="{link setHeader! $typeId, $hdrPlaceholder}">
                            <option n:foreach="$headers as $hid => $hname" value="{$hid}" n:attr="selected: $hid === $hdrId">{$hname}</option>
                        </select>
                        <span class="pv-chip-btns">
                            <a href="{link decrement! $typeId}" class="ajax pv-mini" title="{_admin.pv.less}">−</a><a href="{link increment! $typeId}" class="ajax pv-mini" title="{_admin.pv.more}">+</a>
                            <span class="pv-flex"></span>
                            <a href="{plink label! $item->id, $typeId}" class="ajax-modal pv-mini pv-mini-edit" data-target="#modal-labelsForm" title="{_admin.pv.editLabel}">✎</a><a href="{plink downloadSingleProductLabelPdf! $item->id, $typeId, 0}" target="_blank" class="pv-mini" title="{_admin.pv.preview}">◉</a>
                        </span>
                    </span>
                {/foreach}
            {/foreach}
            <button n:if="$price" type="button" class="pv-labels-btn pv-open-labels" data-id="{$item->id}">{_admin.pv.labelsBtn} ▾</button>
        </div>
    {/if}
{/snippet}
{/if}

{if $part === 'panel' || $part === 'all'}
{snippet panel}
    {var $item = $control->getItem()}
    {var $branchesId = $control->getBranchesId()}
    {var $price = $item ? $item->getPrice($branchesId) : NULL}
    {var $status = \App\AdminModule\Presenters\ProductLabelsControl::getActionStatus($price)}
    {var $running = $status === \App\AdminModule\Presenters\ProductLabelsControl::STATUS_RUNNING}
    {var $unit = $item ? $item->getPriceUnit() : 'Kč'}
    {var $types = \ProductLabelsEntity::TYPES_ARR}
    {var $typeNames = $GLOBALS['global']['productLabelTypes']}
    {var $hdrPlaceholder = 999999}
    {if $item && $price}
        {var $labels = $control->getLabels()}
        {var $counts = $control->getCounts()}
        {var $headers = $control->getHeaderPairs()}
        {var $total = array_sum($counts)}
        <div class="pv-lpanel-head">
            <span class="pv-lpanel-title">{_admin.pv.panelTitle}</span>
            <a href="{plink multiLabel! $item->id}" class="ajax-modal pv-btn pv-btn-dark" data-target="#modal-multiLabelsForm">☰ {_admin.pv.bulkEdit}</a>
            <a href="{plink downloadProductAllLabelsPdf! $item->id, 0}" target="_blank" class="pv-btn">◉ {_admin.pv.previewAll}</a>
            <a n:if="$total" href="{plink downloadProductAllLabelsPdf! $item->id, 1}" target="_blank" class="pv-btn">⤓ {_admin.pv.downloadAll} ({$total})</a>
            <span n:if="!$total" class="pv-btn pv-btn-off">⤓ {_admin.pv.downloadAll} (0)</span>
        </div>
        {foreach [\ProductLabelsEntity::GROUP_STD, \ProductLabelsEntity::GROUP_SPEC, \ProductLabelsEntity::GROUP_AKCE] as $group}
            {var $akceWarn = $group === \ProductLabelsEntity::GROUP_AKCE && !$running}
            <div class="pv-group">
                <div class="pv-group-head">
                    <span class="pv-group-title">{_"admin.pv.group.$group.title"}</span>
                    <span n:class="pv-group-note, $akceWarn ? pv-warn-text">{$akceWarn ? ('admin.pv.akceMissing'|translate) : ("admin.pv.group.$group.note"|translate)}</span>
                </div>
                <div class="pv-cards">
                    {foreach $types as $typeId => $def}
                        {continueIf $def['group'] !== $group}
                        {var $label = $labels[$typeId] ?? NULL}
                        {var $n = $counts[$typeId] ?? 0}
                        {var $locked = \ProductLabelsEntity::isLockedType($typeId)}
                        {var $hdrId = $label && $label->product_label_headers_id ? (int)$label->product_label_headers_id : $control->getDefaultHeaderId($typeId)}
                        <div n:class="pv-card, $n ? pv-card-on, $locked ? pv-card-locked" title="{$locked ? ('admin.pv.locked'|translate) : ''}">
                            <div class="pv-card-top">
                                <div class="pv-card-name"><b>{$typeNames[$typeId]}</b><small>{$def['dims']}</small></div>
                                <div class="pv-stepper">
                                    {if $n}<a href="{link decrement! $typeId}" class="ajax">−</a>{else}<span class="pv-off">−</span>{/if}
                                    <span class="pv-stepper-n">{$n}</span>
                                    {if $locked}
                                        <span class="pv-off">+</span>
                                    {else}
                                        <a href="{link increment! $typeId}" n:class="ajax, $group === \ProductLabelsEntity::GROUP_AKCE && !$running && !$n ? pv-warn-click" data-msg="{$typeNames[$typeId]}: {_admin.pv.akceMissingToast}">+</a>
                                    {/if}
                                </div>
                            </div>
                            {if $locked}
                                <div class="pv-card-locked-note">{_admin.pv.locked}</div>
                            {else}
                                <select class="pv-hdr pv-hdr-card select-default" title="{_admin.pv.header}" data-url="{link setHeader! $typeId, $hdrPlaceholder}">
                                    <option n:foreach="$headers as $hid => $hname" value="{$hid}" n:attr="selected: $hid === $hdrId">{$hname}</option>
                                </select>
                                <div class="pv-card-actions">
                                    <a href="{plink label! $item->id, $typeId}" class="ajax-modal pv-edit" data-target="#modal-labelsForm">✎ {_admin.pv.edit}{if $control->isEdited($label)} •{/if}</a>
                                    <a href="{plink downloadSingleProductLabelPdf! $item->id, $typeId, 0}" target="_blank">◉ {_admin.pv.preview}</a>
                                    {if $n}
                                        <a href="{plink downloadSingleProductLabelPdf! $item->id, $typeId, 1}" target="_blank" class="pv-pdf">⤓ PDF</a>
                                    {else}
                                        <span class="pv-off" title="{_admin.terms.plNoQty}">⤓ PDF</span>
                                    {/if}
                                </div>
                            {/if}
                        </div>
                    {/foreach}
                </div>
            </div>
        {/foreach}
    {/if}
{/snippet}
{/if}
