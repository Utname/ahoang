{snippet list}
    {var $item = $control->getItem()}
    {var $price = $item ? $item->getPrice($control->getBranchesId()) : NULL}
    {var $labels = $item ? $item->getProductLabels($control->getBranchesId()) : []}

    <span n:if="!$price" class="text-danger" style="font-size:11px;">{_admin.terms.noBasicPrice}</span>
    {if $price}
        <div class="product-labels-steppers-container" style="display:inline-flex;align-items:center;gap:5px;flex-wrap:nowrap;">
            {foreach $GLOBALS['global']['productLabelTypes'] as $labelTypeId => $term}
                {var $label = $labels[$labelTypeId] ?? NULL}
                {var $count = ($label && $label->isToPrint()) ? (int)$label->count : 0}
                {var $hasCount = $count > 0}
                <div class="label-stepper-item" style="display:inline-flex;flex-direction:column;align-items:center;min-width:62px;">
                    <div class="label-stepper-box" style="display:inline-flex;align-items:stretch;border:1px solid {$hasCount ? '#14b8a6' : '#d9e0e8'|noescape};border-radius:7px;overflow:hidden;background:#fff;height:24px;box-shadow:{$hasCount ? '0 0 0 1px #14b8a6' : 'none'|noescape};">
                        <a href="{link decrement! $labelTypeId, $label ? $label->id : NULL}" 
                           class="ajax label-stepper-btn label-stepper-dec" 
                           style="width:19px;display:flex;align-items:center;justify-content:center;background:#fff;color:#5d6a7d;text-decoration:none;font-size:12px;font-weight:700;line-height:1;border-right:1px solid #eef1f5;cursor:pointer;" 
                           title="−">−</a>
                        
                        <div class="label-stepper-val" style="min-width:22px;padding:0 3px;height:100%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:{$hasCount ? '800' : '500'};color:{$hasCount ? '#042f2e' : '#8794a5'};background:{$hasCount ? '#ccfbf1' : '#fff'};">
                            {$count}
                        </div>

                        <a href="{link increment! $labelTypeId, $label ? $label->id : NULL}" 
                           class="ajax label-stepper-btn label-stepper-inc" 
                           style="width:19px;display:flex;align-items:center;justify-content:center;background:#fff;color:#5d6a7d;text-decoration:none;font-size:12px;font-weight:700;line-height:1;border-left:1px solid #eef1f5;cursor:pointer;" 
                           title="+">+</a>
                    </div>
                    <span style="font-size:10px;color:#8794a5;margin-top:2px;font-weight:600;letter-spacing:0.02em;">{$term}</span>
                </div>
            {/foreach}
            
            <div class="dropdown m-l-xxs" style="margin-top:-14px;">
                <a class="dropdown-toggle btn btn-xs btn-default" data-toggle="dropdown" href="#" title="Tùy chọn in & sửa" style="padding:2px 6px;border-radius:5px;border:1px solid #d9e0e8;background:#fff;">
                    <i class="fa fa-ellipsis-v"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right" style="width:320px;padding:12px;border-radius:10px;box-shadow:0 10px 25px rgba(0,0,0,0.15);border:1px solid #e2e8f0;background:#fff;">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid #eef2f6;">
                        <span style="font-weight:700;font-size:12px;color:#0f172a;">Tùy chọn in & sửa</span>
                        <a href="{plink multiLabel! $item->id}" class="ajax-modal btn btn-xs btn-primary" data-target="#modal-multiLabelsForm" style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:5px;">
                            <i class="fa fa-sliders-h m-r-xxs"></i> {_'admin.terms.editMultipleLabels'}
                        </a>
                    </div>
                    
                    <table class="table table-condensed m-b-no" style="font-size:11.5px;margin-bottom:0;">
                        <thead>
                            <tr style="color:#64748b;font-size:10.5px;text-transform:uppercase;background:#f8fafc;">
                                <th style="padding:5px 6px;border-bottom:1px solid #e2e8f0;">Khổ tem</th>
                                <th style="padding:5px 4px;text-align:center;border-bottom:1px solid #e2e8f0;">Sửa</th>
                                <th style="padding:5px 4px;text-align:center;border-bottom:1px solid #e2e8f0;">Xem trước</th>
                                <th style="padding:5px 4px;text-align:center;border-bottom:1px solid #e2e8f0;">Tải PDF</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $GLOBALS['global']['productLabelTypes'] as $labelTypeId => $term}
                                {var $lbl = $labels[$labelTypeId] ?? NULL}
                                {var $lblCount = ($lbl && $lbl->isToPrint()) ? (int)$lbl->count : 0}
                                <tr style="border-bottom:1px solid #f1f5f9;">
                                    <td style="padding:6px 6px;font-weight:700;color:#1e293b;vertical-align:middle;">
                                        {$term}
                                    </td>
                                    <td style="padding:4px;text-align:center;vertical-align:middle;">
                                        <a href="{plink label! $item->id, $labelTypeId}" class="ajax-modal btn btn-xs btn-default" data-target="#modal-labelsForm" title="Sửa chi tiết {$term}" style="padding:3px 7px;font-size:11px;border-radius:5px;">
                                            <i class="fas fa-pencil text-muted"></i>
                                        </a>
                                    </td>
                                    <td style="padding:4px;text-align:center;vertical-align:middle;">
                                        <a href="{plink downloadSingleProductLabelPdf! $item->id, $labelTypeId, 0}" target="_blank" class="btn btn-xs btn-default" title="Xem trước mẫu tem {$term} trong tab mới" style="padding:3px 7px;font-size:11px;border-radius:5px;color:#0284c7;background:#f0f9ff;border:1px solid #bae6fd;">
                                            <i class="far fa-eye"></i> Xem
                                        </a>
                                    </td>
                                    <td style="padding:4px;text-align:center;vertical-align:middle;">
                                        {if $lblCount > 0}
                                            <a href="{plink downloadSingleProductLabelPdf! $item->id, $labelTypeId, 1}" target="_blank" class="btn btn-xs btn-default" title="Tải xuống {$lblCount} tem {$term}" style="padding:3px 8px;font-size:11px;border-radius:5px;color:#042f2e;background:#ccfbf1;border:1px solid #5eead4;font-weight:700;">
                                                <i class="fa fa-download text-success"></i> Tải ({$lblCount})
                                            </a>
                                        {else}
                                            <span class="btn btn-xs btn-default disabled" title="Bạn chưa chọn số lượng (SL = 0)" style="padding:3px 8px;font-size:11px;border-radius:5px;color:#94a3b8;background:#f8fafc;border:1px solid #e2e8f0;cursor:not-allowed;opacity:0.6;">
                                                <i class="fa fa-download"></i> Tải (0)
                                            </span>
                                        {/if}
                                    </td>
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {/if}
{/snippet}