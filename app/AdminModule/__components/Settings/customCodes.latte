{form customCodesForm}
	<div class="col-lg-4">
		<h4 class="m-t-no m-b-no">{_admin.terms.custom_code_header}</h4>
		<div class="help-block">{_admin.terms.customCodeHeaderTip}</div>
		<div class="form-group">
			{input custom_code_header class => 'form-control h-300'}
		</div>
	</div>
	<div class="col-lg-4 col-lg-offset-1">
		<h4 class="m-t-no m-b-no">{_admin.terms.custom_code_footer}</h4>
		<div class="help-block">{_admin.terms.customCodeFooterTip}</div>
		<div class="form-group">
			{input custom_code_footer class => 'form-control h-300'}
		</div>
	</div>
	<div class="col-lg-12">
		<div class="form-group-btns p-v-xs">
			<button n:name="submit" class="btn mosaic-topbtn mosaic-topbtn-primary m-r-xs">
				<i class="far fa-check"></i> {_admin.buttons.save}
			</button>
		</div>
	</div>
{/form}
