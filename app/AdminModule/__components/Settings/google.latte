{form googleForm}
	<div class="col-lg-3">
		<h4 class="m-t-no m-b-no">{_admin.terms.googleMaps}</h4>
		<div class="help-block">{_admin.terms.googleMapsTip}</div>
		<div class="form-group">
			{label google_maps_api_key /}
			{input google_maps_api_key class => 'form-control'}
		</div>
	</div>
	<div class="col-lg-12">
		<div class="form-group-btns p-v-xs">
			<button n:name="submit" class="btn btn-success btn-addon m-r-xs">
				<i class="far fa-check"></i> {_admin.buttons.save}
			</button>
		</div>
	</div>
{/form}
