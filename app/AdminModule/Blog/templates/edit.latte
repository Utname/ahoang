{block content}

{var $contentBlocksControl = isset($item) ? $presenter->getComponent('contentBlocks', FALSE) : NULL}

<div class="col-md-12">
	<div class="panel panel-white">
		{form editForm}
			<div class="panel-body">

				<div role="tabpanel">
					<ul class="nav nav-tabs" role="tablist">
						<li role="presentation" class="active">
							<a href="#section-01" role="tab" data-toggle="tab">{_admin.tabs.basicInfo}</a>
						</li>
						<li role="presentation">
							<a href="#section-02" role="tab" data-toggle="tab">{_admin.tabs.advanced}</a>
						</li>
					</ul>

					<div class="tab-content">
						<div role="tabpanel" class="tab-pane active clearfix" id="section-01">
							<div class="col-lg-4">
								<div class="clearfix">
									<h4>{_admin.terms.mainInfo}</h4>

									<div class="row">
										<div class="col-sm-4">
											<div class="form-group">
												{label date /}
												{input date class => 'form-control date-picker'}
											</div>
										</div>
									</div>

									<div class="form-group">
										{label name /}
										{input name class => 'form-control form-control-bigger url-source', data-target => '.webalize'}
									</div>

									<div class="form-group">
										{label slug /}
										{input slug class => 'form-control webalize'}
									</div>

									<div class="form-group">
										{label perex /}
										{input perex class => 'form-control h-100'}
									</div>

									{include APP_DIR.'/AdminModule/__inc/formImage.latte' field => 'image'}

									<div class="clearfix">
										<h4>{_admin.terms.details}</h4>
										{include APP_DIR.'/AdminModule/__inc/isActiveInputs.latte'}
									</div>
								</div>

							</div>

							<div class="col-lg-7 col-md-offset-1">
								{if $contentBlocksControl}
									<h4 class="m-b-no">{_admin.terms.content}</h4>
									{$contentBlocksControl->render()}
								{/if}

								{snippet categoriesList}
									{include '_formCategories.latte'}
								{/snippet}
							</div>
						</div>

						<div role="tabpanel" class="tab-pane clearfix" id="section-02">
							<div class="col-lg-4">
								{include APP_DIR.'/AdminModule/__inc/formMetaTags.latte'}
							</div>
						</div>
					</div>

					{include APP_DIR.'/AdminModule/__inc/formButtons.latte'}
				</div>

			</div>
		{/form}
	</div>
</div>

{if $contentBlocksControl}
	{$contentBlocksControl->renderModals()}
{/if}


{control categoriesQuickCreator}
