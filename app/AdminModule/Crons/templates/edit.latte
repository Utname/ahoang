{block content}

<div class="col-md-12">
	<div class="panel mosaic-list-panel">
		{form editForm}
		<div class="panel-body">

			<div role="tabpanel">
				<ul class="nav nav-tabs" role="tablist">
					<li role="presentation" class="active">
						<a href="#section-01" role="tab" data-toggle="tab">{_admin.tabs.basicInfo}</a>
					</li>
				</ul>

				<div class="tab-content">
					<div role="tabpanel" class="tab-pane active clearfix" id="section-01">
						<div class="col-lg-4">
							<div class="clearfix">
								<h4>{_admin.terms.mainInfo}</h4>

								<div class="form-group">
									{label name /}
									{input name class => 'form-control form-control-bigger'}
								</div>
								<div class="form-group">
									{label note /}
									{input note class => 'form-control h-50'}
								</div>
							</div>

							<div class="clearfix">
								<h4>{_admin.terms.details}</h4>

								<div class="row">
									<div class="col-sm-6">
										<div class="form-group">
											{label is_active /}
											{input is_active class => 'form-control'}
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="col-lg-7 col-lg-offset-1">
							<div class="clearfix">
								<h4>{_admin.terms.command}</h4>

								<div class="row">
									<div class="col-sm-6">
										<div class="form-group">
											{input command class => 'form-control'}
										</div>

										<div n:foreach="\CronsEntity::CRON_PART_DEFINITIONS as $expressionPartName => $expressionPartSettings" class="row">
											<div class="col-lg-12">
												<h4 class="m-b-xs">{_}{$expressionPartSettings['title']}{/_}</h4>
											</div>
											<div class="col-lg-6">
												{label 'part_'.$expressionPartName.'_type' /}
												{input 'part_'.$expressionPartName.'_type' class => 'form-control toggle-trigger', data-target => '.options-'.$expressionPartName}
											</div>
											<div class="col-lg-6 options-{$expressionPartName}" data-show-on="{\CronsEntity::PART_TYPE_FROM_VALUES}">
												{label 'part_'.$expressionPartName.'_value' /}
												{input 'part_'.$expressionPartName.'_value', class => 'form-control'}
											</div>
											<div class="col-lg-6 options-{$expressionPartName}" data-show-on="{\CronsEntity::PART_TYPE_RANGE}">
												<div class="row">
													<div class="col-lg-6">
														{label 'part_'.$expressionPartName.'_range_from' /}
														{input 'part_'.$expressionPartName.'_range_from', class => 'form-control'}
													</div>
													<div class="col-lg-6">
														{label 'part_'.$expressionPartName.'_range_to' /}
														{input 'part_'.$expressionPartName.'_range_to', class => 'form-control'}
													</div>
												</div>
											</div>
											<div class="col-lg-6 options-{$expressionPartName}" data-show-on="{\CronsEntity::PART_TYPE_CUSTOM_DEFINITION}">
												{label 'part_'.$expressionPartName.'_custom_value' /}
												{input 'part_'.$expressionPartName.'_custom_value', class => 'form-control'}
												<p class="help-block m-b-no">{_admin.terms.custom_expression_hint}</p>
											</div>
										</div>

									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				{include APP_DIR.'/AdminModule/__inc/formButtons.latte'}
			</div>

		</div>
		{/form}
	</div>
</div>
