<!DOCTYPE html>
<html>

{* Was date('YmdH') — only rotates once an hour, and modern.css/modern.js
   below had no cache-busting query string at all. Several edits to those
   exact files during this session's sidebar debugging were invisible in a
   real browser (that had already cached them) despite being live on disk
   and visible to a fresh Playwright context. filemtime() changes the
   moment any of these files are saved, so a plain reload always picks up
   the latest version of whichever one actually changed. *}
{var $antiCache = max(
	@filemtime(WWW_DIR.'/css/admin/custom.css') ?: 0,
	@filemtime(WWW_DIR.'/js/admin/custom.js') ?: 0,
	@filemtime(WWW_DIR.'/css/admin/modern.css') ?: 0,
	@filemtime(WWW_DIR.'/js/admin/modern.js') ?: 0
) ?: date('YmdH')}

<head>
	<title>
		{_admin.project.name}
		{isset($moduleName) && $moduleName ? ' - '.$moduleName : ''}
	</title>

	<meta content="width=device-width, initial-scale=1" name="viewport"/>
	{* iOS zooms the page into an input with text under 16px; maximum-scale stops that (pinch zoom
	   still works on iOS), so the phone layout can use smaller inputs. Android does not do it. *}
	<script>
		if (/iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
			document.querySelector('meta[name=viewport]').content = 'width=device-width, initial-scale=1, maximum-scale=1';
		}
	</script>
	<meta charset="UTF-8">
	<meta name="description" content=""/>
	<meta name="keywords" content=""/>
	<meta name="author" content="Pro-idea s.r.o. | www.pro-idea.cz"/>
	{isset($settings->favicon) ? \SettingsEntity::getFaviconCode($settings->favicon) : ''|noescape}

	<link href='https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap' rel='stylesheet' type='text/css'>
	<link href="/plugins/pace-master/themes/blue/pace-theme-flash.css" rel="stylesheet"/>
	<link href="/plugins/uniform/css/uniform.default.min.css" rel="stylesheet"/>
	<link href="/plugins/bootstrap/css/bootstrap.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/fontawesome/css/all.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/line-icons/simple-line-icons.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/slidepushmenus/css/component.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/select2/css/select2.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/bootstrap-datepicker/css/datepicker3.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/bootstrap-colorpicker/css/colorpicker.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/dropzone/dropzone.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/image-cropper/cropper.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/jquery-ui/jquery-ui.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/magnific-popup/magnific-popup.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/chartsjs/Chart.min.css" rel="stylesheet" type="text/css"/>
	<link href="/plugins/datatables/css/jquery.datatables.min.css" rel="stylesheet" type="text/css">
	<link href="/plugins/fontawesome-iconpicker/css/fontawesome-iconpicker.min.css" rel="stylesheet" type="text/css"/>

	<link href="/css/admin/modern.css?v={$antiCache}" rel="stylesheet" type="text/css"/>
	<link href="/css/admin/themes/white.css" class="theme-color" rel="stylesheet" type="text/css"/>
	<link href="/css/admin/alertify.core.css" rel="stylesheet" type="text/css"/>
	<link href="/css/admin/alertify.default.css" rel="stylesheet" type="text/css"/>
	<link href="/css/admin/custom.css?v={$antiCache}" rel="stylesheet" type="text/css"/>

	<script src="/plugins/jquery/jquery-2.1.3.min.js"></script>

	<!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
	<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
	<!--[if lt IE 9]>
	<script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
	<script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
	<![endif]-->
</head>

<body class="page-header-fixed page-sidebar-fixed compact-menu hover-menu">

<div class="overlay"></div>

<main class="page-content content-wrap">
	<!-- MOSAIC TOP NAVBAR -->
	<div class="navbar mosaic-navbar">
		<div class="navbar-inner">
			<!-- Logo on Top-Left -->
			<div class="logo-box mosaic-logo-box">
				<a n:href="Homepage:" class="mosaic-logo-link">
					<div class="mosaic-logo-badge">
						<i class="fas fa-shapes"></i>
					</div>
					<div class="mosaic-logo-text-group">
						<span class="mosaic-logo-title">{_admin.project.name}</span>
						<span class="mosaic-logo-subtitle">MANAGEMENT</span>
					</div>
				</a>
			</div>

			<div class="topmenu-outer mosaic-topmenu-outer">
				<div class="top-menu mosaic-top-menu">
					<!-- Left: Sidebar Toggle & Search Bar -->
					<div class="mosaic-header-left">
						<button type="button" class="push-sidebar mosaic-sidebar-toggle" title="{_admin.ui.toggleMenu}">
							<i class="fas fa-bars-staggered"></i>
						</button>

						<div class="mosaic-search-box" onclick="document.getElementById('mosaicQuickSearchInput').focus();">
							<i class="fas fa-search mosaic-search-icon"></i>
							<input type="text" id="mosaicQuickSearchInput" class="mosaic-search-input" placeholder="{_admin.ui.quickSearch}">
							<kbd class="mosaic-search-kbd">Ctrl K</kbd>
						</div>
					</div>

					<!-- Right: Actions, Language, User Dropdown -->
					<div class="mosaic-header-right">
						<!-- Store Preview -->
						<a href="/" target="_blank" class="mosaic-nav-icon-btn" title="{_admin.ui.viewWebsite}">
							<i class="fas fa-arrow-up-right-from-square"></i>
						</a>

						<!-- Locale Switcher -->
						<div n:if="count($locales) > 1" class="dropdown mosaic-dropdown">
							<a href="#" class="dropdown-toggle mosaic-lang-btn" data-toggle="dropdown">
								<i class="fas fa-globe text-slate"></i>
								<span class="mosaic-lang-current">{if $locale == 'vi_VN'}Tiếng Việt{elseif $locale == 'cs_CZ'}Čeština{elseif $locale == 'en_US'}English{else}{$locale}{/if}</span>
								<i class="fas fa-chevron-down mosaic-arrow-icon"></i>
							</a>
							<ul class="dropdown-menu dropdown-menu-right mosaic-dropdown-menu" role="menu">
								<li n:foreach="$locales as $l" role="presentation">
									<a n:href="switchLocale! $l" n:class="$locale == $l ? 'active'">
										<span class="mosaic-lang-code">{$l|upper|substr:0,2}</span>
										<span>{_'admin.locales.'.$l}</span>
										<i n:if="$locale == $l" class="fas fa-check mosaic-active-check"></i>
									</a>
								</li>
							</ul>
						</div>

						<div class="mosaic-divider-v"></div>

						<!-- User Profile Dropdown -->
						<div class="dropdown mosaic-dropdown">
							<a href="#" class="dropdown-toggle mosaic-user-btn" data-toggle="dropdown">
								<div class="mosaic-user-avatar">
									{var $initial = $adminUser->name ? substr($adminUser->name, 0, 1) : 'A'}
									<span>{$initial|upper}</span>
								</div>
								<div class="mosaic-user-info hidden-xs">
									<span class="mosaic-user-name">{$adminUser->name}</span>
									<span class="mosaic-user-role">{_admin.terms.admin}</span>
								</div>
								<i class="fas fa-chevron-down mosaic-arrow-icon hidden-xs"></i>
							</a>
							<ul class="dropdown-menu dropdown-menu-right mosaic-dropdown-menu mosaic-user-menu" role="menu">
								<li class="mosaic-user-menu-header">
									<div class="mosaic-user-menu-name">{$adminUser->name}</div>
									<div class="mosaic-user-menu-email">{isset($adminUser->email) ? $adminUser->email : ('admin.ui.administrator'|translate)}</div>
								</li>
								<li class="divider"></li>
								<li role="presentation">
									<a n:href="AdminUserAccount:"><i class="fas fa-user-circle"></i>{_admin.account.title}</a>
								</li>
								<li role="presentation">
									<a n:href="AdminUserAccount:"><i class="fas fa-key"></i>{_admin.changePassword.title}</a>
								</li>
								{if $aps->has('AdminUsers_list')}
									<li role="presentation">
										<a n:href="AdminUsers:"><i class="fas fa-users-gear"></i>{_admin.modules.adminUsers|menu}</a>
									</li>
								{/if}
								<li class="divider"></li>
								<li role="presentation">
									<a n:href="signOut!" class="mosaic-logout-link">
										<i class="fas fa-arrow-right-from-bracket"></i>
										<span>{_admin.logout.logout}</span>
									</a>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- MOSAIC SLATE SIDEBAR -->
	<div class="page-sidebar sidebar mosaic-sidebar">
		<div class="page-sidebar-inner">
			<ul class="menu accordion-menu">
				{renderMenu()|noescape}
			</ul>
		</div>
	</div>

	<div class="page-inner">
		<div class="page-title clearfix">
			<h3 n:ifset="$moduleName" class="pull-left">
				{$moduleName}{isset($moduleActionName) && $moduleActionName ? ': '.$moduleActionName : ''}
			</h3>

			<div n:ifset="#topButtons" class="buttons pull-right">
				{include #topButtons}
			</div>
		</div>

		<div id="main-wrapper">
			<div class="row">
				{include #content}
				{var $imageCropControl = $presenter->getComponent('imageCrop', FALSE)}
				{if $imageCropControl}
					{control imageCrop}
				{/if}
			</div>
		</div>

		<div class="page-footer">
			<p class="no-s">{date('Y')} &copy; {_admin.project.copyright}</p>
		</div>
	</div>
</main>

<div class="cd-overlay"></div>

<div style="display: none;" n:snippet="flashMessages">
	<div n:foreach="$flashes as $flash" n:class="'flash-messages', $flash->type" style="display: none;">{$flash->message|noescape}</div>
</div>

<script src="/plugins/jquery-ui/jquery-ui.min.js"></script>
<!--<script src="/plugins/pace-master/pace.min.js"></script>-->
<script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
<script src="/plugins/uniform/jquery.uniform.min.js"></script>
<script src="/plugins/select2/js/select2.min.js"></script>
<script src="/plugins/ckeditor/ckeditor.js"></script>
<script src="/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="/plugins/bootstrap-datepicker/js/locales/bootstrap-datepicker.cs.js"></script>
<script src="/plugins/bootstrap-datetimepicker/js/bootstrap-datetimepicker.js"></script>
<script src="/plugins/bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.cs.js"></script>
<script src="/plugins/bootstrap-colorpicker/js/bootstrap-colorpicker.js"></script>
<script src="/plugins/dropzone/dropzone.min.js"></script>
<script src="/plugins/image-cropper/cropper.min.js"></script>
<script src="/plugins/image-cropper/jquery-cropper.js"></script>
<script src="/plugins/magnific-popup/jquery.magnific-popup.min.js"></script>
<script src="/js/admin/alertify.js"></script>
<script src="/js/admin/live-form-validation.js"></script>
<script src="/plugins/fontawesome-iconpicker/js/fontawesome-iconpicker.min.js"></script>
<script src="/plugins/chartsjs/Chart.bundle.min.js"></script>
<script src="/js/admin/modern.js?v={$antiCache}"></script>
<script src="/js/admin/custom.js?v={$antiCache}"></script>

<script>
document.addEventListener('keydown', function(e) {
	if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
		e.preventDefault();
		var searchInput = document.getElementById('mosaicQuickSearchInput');
		if (searchInput) {
			searchInput.focus();
			searchInput.select();
		}
	}
});

document.addEventListener('DOMContentLoaded', function() {
	var searchInput = document.getElementById('mosaicQuickSearchInput');
	if (searchInput) {
		searchInput.addEventListener('keydown', function(e) {
			if (e.key === 'Enter') {
				var val = this.value.trim();
				if (val) {
					window.location.href = {plink Products:default} + '?search=' + encodeURIComponent(val);
				}
			}
		});
	}
});
</script>

</body>

</html>
