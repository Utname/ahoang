{extends ../../@login.latte}

{block content}

<p class="text-center m-t-md m-b-lg">
    {_admin.login.text}
</p>

{form signInForm}
    <div class="form-group">
        {label email /}
        {input email class => 'form-control'}
    </div>

    <div class="form-group">
        {label password /}
        {input password class => 'form-control'}
    </div>

    <div class="form-group clearfix">
        {input submit class => 'btn btn-success btn-block'}
    </div>

	<a n:href="forgotPassword" class="display-block text-center text-sm">
        {_admin.login.forgottenPassword}
    </a>
{/form}