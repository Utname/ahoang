{extends ../../@login.latte}

{block content}

<p class="text-center m-t-md m-b-lg">
    {_admin.forgottenPassword.text|noescape}
</p>

{form forgotPasswordForm}
    <div class="form-group">
        {label email /}
        {input email class => 'form-control'}
    </div>

    <div class="form-group clearfix">
        {input submit class => 'btn btn-success btn-block'}
    </div>

    <a n:href="in" class="display-block text-center text-sm">
        {_admin.forgottenPassword.backToLogin}
    </a>
{/form}