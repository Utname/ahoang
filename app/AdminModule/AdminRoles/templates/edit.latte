{block content}

<div class="col-md-12">
	<div class="panel mosaic-list-panel">
		{form editForm}
			<div class="panel-body">

				<div role="tabpanel">
					<ul class="nav nav-tabs" role="tablist">
						<li role="presentation" class="active">
							<a href="#section-01" role="tab" data-toggle="tab">{_admin.tabs.basicInfo}</a>
						</li>
					</ul>

					<div class="tab-content">
						<div role="tabpanel" class="tab-pane active clearfix" id="section-01">
							<div class="clearfix">
								<div class="col-lg-3">
									<div class="form-group">
										{label name /}
										{input name class => 'form-control form-control-bigger'}
									</div>
								</div>
							</div>

							<hr />

							<div class="clearfix permissions-checkboxes">
								<div class="col-lg-12">
									<div n:foreach="$modules as $moduleId => $modeuleInfo" class="form-group checkbox-group">
										<div class="permissions-group">
											<label for="module-{$moduleId}">
												<input type="checkbox" id="module-{$moduleId}" class="checkbox-group-trigger" />
												<strong>{$modeuleInfo['name']}</strong>
											</label>
										</div>
										<div class="permissions-items checkbox-group-items clearfix">
											<div n:foreach="$modeuleInfo['actions'] as $actionId" class="pull-left w-220">
												{input 'rel_values__admin_roles_admin_permissions_rel__'.$moduleId.'_'.$actionId class => 'form-control'}
												{label 'rel_values__admin_roles_admin_permissions_rel__'.$moduleId.'_'.$actionId /}
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					{include APP_DIR.'/AdminModule/__inc/formButtons.latte'}
				</div>

			</div>
		{/form}
	</div>
</div>