<!doctype html>
<html lang="{$language->id}">

{var $antiCache = date('YmdH').'-22'}

<head>
    {*META INFO*}
    {control metaInfo}

    {*FAVICON*}
    {\SettingsEntity::getFaviconCode(settings('favicon'))|noescape}

    {*TEMPLATE CSS*}
    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/front/custom-bootstrap.css">
    <link rel="stylesheet" href="/css/front/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css"/>
    <link rel="stylesheet" type="text/css" href="/css/front/lightbox.min.css">
    <link rel="stylesheet" type="text/css" href="/css/front/style.css?_v={$antiCache}">

    <link rel="stylesheet" href="/css/front/custom.css?_v={$antiCache}">
    {* "Landwind" look of the header, home blocks and footer *}
    <link rel="stylesheet" href="/css/front/landwind.css?_v={=@filemtime(WWW_DIR . '/css/front/landwind.css')}">


    {*CORE CSS*}
    <link rel="stylesheet" href="/css/front/core/alertify.core.css">
    <link rel="stylesheet" href="/css/front/core/alertify.default.css">
    <link rel="stylesheet" href="/css/front/core/custom.css?_v={$antiCache}">


    {*SCRIPTS, CUSTOM CODES*}
    {if $customCodeHeader = settings('custom_code_header')}
        {$customCodeHeader|noescape}
    {/if}
</head>

<body class="lw">

{include '__inc/header/top.latte'}

{include #content}

{snippetArea footerWrapper}
{include '__inc/footer/bottom.latte'}
{/snippetArea}

<div n:snippet="flashMessages" style="display: none;">
    <div n:foreach="$flashes as $flash" n:class="flash-messages, $flash->type">{$flash->message}</div>
</div>

{*CORE JS*}
<script src="/js/front/core/alertify.js" defer></script>
<script src="/js/front/core/custom.js?_v={$antiCache}" defer></script>

{*TEMPLATE JS*}
<script src="/js/front/jquery-3.6.1.min.js" crossorigin="anonymous"></script>
<script src="/js/front/popper.min.js" crossorigin="anonymous"></script>
<script src="/js/front/bootstrap.min.js" crossorigin="anonymous"></script>
<script src="/js/front/swiper-bundle.min.js"></script>

<script src="/js/front/lightbox.min.js"></script>
<script src="/js/front/scrollup.min.js"></script>
<script src="/js/front/script.js?_v={=@filemtime(WWW_DIR . '/js/front/script.js')}"></script>
<script src="/js/front/custom.js?_v={=@filemtime(WWW_DIR . '/js/front/custom.js')}"></script>
<script src="/js/front/landwind.js?_v={=@filemtime(WWW_DIR . '/js/front/landwind.js')}"></script>
<script async defer src="https://maps.googleapis.com/maps/api/js?key={settings('google_maps_api_key')}&callback=initMap&libraries=places"></script>

{*SCRIPTS, CUSTOM CODES*}
{if $customCodeFooter = settings('custom_code_footer')}
{$customCodeFooter|noescape}
{/if}

{if $GLOBALS['container']->isDevMode()}
{* Auto-translate CZ -> VI on load, local dev only (config/02-local.neon: devMode) *}
<div id="google_translate_element" style="display:none;"></div>
<div style="position:fixed;bottom:8px;right:8px;z-index:9999;background:#fff;border:1px solid #ccc;border-radius:4px;padding:4px 8px;font-size:12px;box-shadow:0 1px 4px rgba(0,0,0,.2);">
	<a href="#" onclick="document.cookie='googtrans=/cs/vi;path=/';document.cookie='googtrans=/cs/vi;path=/;domain='+location.hostname;location.reload();return false;">VI</a>
	|
	<a href="#" onclick="document.cookie='googtrans=/cs/cs;path=/';document.cookie='googtrans=/cs/cs;path=/;domain='+location.hostname;location.reload();return false;">CS</a>
</div>
<script n:syntax="off">
    {* Google's own "show original" toggle only affects the current DOM, not the googtrans cookie — it never survives a reload, hence the VI/CS links above giving explicit, persistent control instead. This only sets a default on the very first visit (no googtrans cookie yet); once either link is clicked the cookie always exists, so this never overrides that choice again. *}
    if (!/(?:^|; )googtrans=/.test(document.cookie)) {
        document.cookie = 'googtrans=/cs/vi; path=/';
        document.cookie = 'googtrans=/cs/vi; path=/; domain=' + location.hostname;
    }
    function googleTranslateElementInit() {
        new google.translate.TranslateElement({pageLanguage: 'cs', includedLanguages: 'vi', autoDisplay: false}, 'google_translate_element');
    }
</script>
<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
{/if}

</body>

</html>
