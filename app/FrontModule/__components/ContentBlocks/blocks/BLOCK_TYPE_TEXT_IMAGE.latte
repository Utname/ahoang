{var $title = $block->getValue('title')}
{var $text = $block->getValue('text')}

{var $btnText = $block->getValue('btnText')}
{var $btnLink = $block->getValue('btnLink')}

{var $images = $block->getContentImages('images')}

{* "Landwind" feature row, reversed (images left, text right): the first paragraph is the lead,
   the following ones become the check list, like "We invest in the world's potential". *}
{var $paragraphs = array_values(array_filter(array_map('trim', array_map('strip_tags', preg_split('#</p>|<br\s*/?>#i', (string)$text)))))}
{var $lead = array_shift($paragraphs)}

<section class="lw-section lw-section-gray" id="o-spolecnosti">
    <div class="lw-container lw-feature lw-feature-reverse">
        <div class="lw-feature-text">
            <h2 n:if="$title" class="lw-h2">{$title}</h2>
            <p n:if="$lead" class="lw-lead">{$lead}</p>
            <ul n:if="$paragraphs" class="lw-checklist">
                <li n:foreach="$paragraphs as $paragraph">{$paragraph}</li>
            </ul>
            <a n:if="$btnText && $btnLink" href="{$btnLink}" class="lw-btn lw-btn-primary">{$btnText}</a>
        </div>
        <div n:if="count($images)" class="lw-shots">
            <div n:foreach="array_slice($images, 0, 3) as $image" n:class="lw-shot, $iterator->first ? lw-shot-big">
                <img loading="lazy" decoding="async" src="{$image->file|image:($iterator->first ? 'textImageHeight' : 'textImageStandard')}" alt="{$image->file|imageTitle}">
            </div>
        </div>
    </div>
</section>
