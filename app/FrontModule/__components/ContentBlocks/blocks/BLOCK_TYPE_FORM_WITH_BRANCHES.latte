{var $title = $block->getValue('title')}
{var $text = $block->getValue('text')}

{var $formTitle = $block->getValue('formTitle')}
{var $formBtnText = $block->getValue('formBtnText')}

{var $branchesIds = $block->getValue('branches')}
{var $branches = $branchesIds ? getBranches($branchesIds) : getBranches([])}

{var $linksIds = $block->getValue('links')}
{var $links = $linksIds ? getLinks($linksIds) : getLinks([])}

{var $branchesPage = page('branches')}

<section class="contact-section light-bg mt-1 mt-md-4" id="kontakt">
	<div class="container">
		<h2 n:if="$title" class="h-line">{$title}</h2>
		<div class="contact-top-text">
			{($text ?? $text)|noescape}
		</div>
		<div class="row">
			<div class="col-12 contact-text-col">
				<div class="contact-text">
					<div n:foreach="$branches as $branch" class="contact-text-item">
						<h4 n:if="$branch->name">
							<a href="{$branchesPage->full_url}/{$branch->getUrl()}">{$branch->name}</a>
							<a n:if="$branch->google_profile_url" href="{$branch->google_profile_url}" target="_blank" class="google-icon">
								<img src="/images/front/google-icon.webp" />
							</a>
						</h4>
						<div class="branch-image">
							<img n:if="$branch->image" src="{$branch->image|image:branch}">
						</div>
						<p n:if="$branch->street && $branch->city && $branch->zip">
							{$branch->street},<br>{$branch->city} {$branch->zip}
						</p>
						{($branch->text ?? $branch->text)|noescape}
					</div>
					<div n:if="count($links)" class="contact-text-social">
						<a n:foreach="$links as $item" n:tag-if="$item->link" href="{$item->link}">
							<img n:if="$item->image" src="{$item->image|image:link}" alt="{$item->image|imageTitle}">
						</a>
					</div>
				</div>

			</div>
			<div class="col-12 contact-form-col">
				<div class="contact-form">
					<h2 n:if="$formTitle" class="h-line">{$formTitle}</h2>

					{var $namePlaceholder = $presenter->getContent('contact_form', 'name')." *"}
					{var $surnamePlaceholder = $presenter->getContent('contact_form', 'surname')." *"}
					{var $phonePlaceholder = $presenter->getContent('contact_form', 'phone')." *"}
					{var $emailPlaceholder = $presenter->getContent('contact_form', 'email')." *"}
					{var $messagePlaceholder = $presenter->getContent('contact_form', 'message')." *"}

					{form form class=>"ajax asp-form"}
						<div class="row">
							<div n:ifset="$form['name']" class="col-12 col-lg-6 form-group">
								{input name class=>"form-control", placeholder=>$namePlaceholder}
							</div>
							<div n:ifset="$form['surname']" class="col-12 col-lg-6 form-group">
								{input surname class=>"form-control", placeholder=>$surnamePlaceholder}
							</div>
							<div n:ifset="$form['phone']" class="col-12 col-lg-6 form-group">
								{input phone class=>"form-control", placeholder=>$phonePlaceholder}
							</div>
							<div n:ifset="$form['email']" class="col-12 col-lg-6 form-group">
								{input email class=>"form-control", placeholder=>$emailPlaceholder}
							</div>
							<div n:ifset="$form['text']" class="col-12 form-group">
								{input text class=>"form-control", placeholder=>$messagePlaceholder}
							</div>
						</div>

						<div n:ifset="$form['agree']" class="check-styled">
							{input agree class=>"agree-checkbox", id=>"gdpr"}
						</div>

						<div class="contact-form-bottom">
							<button n:name="send" id="basic_asp_button" type="submit" class="btn btn-primary basic_asp_button">{$formBtnText}</button>
						</div>

					{/form}
				</div>
			</div>
		</div>
	</div>
</section>