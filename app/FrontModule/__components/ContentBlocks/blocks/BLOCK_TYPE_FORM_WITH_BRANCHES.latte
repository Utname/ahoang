{var $title = $block->getValue('title')}
{var $text = $block->getValue('text')}

{var $formTitle = $block->getValue('formTitle')}
{var $formBtnText = $block->getValue('formBtnText')}

{var $branchesIds = $block->getValue('branches')}
{var $branches = $branchesIds ? getBranches($branchesIds) : getBranches([])}

{var $linksIds = $block->getValue('links')}
{var $links = $linksIds ? getLinks($linksIds) : getLinks([])}

{var $branchesPage = page('branches')}

{* cities of the branches ("Žatec 1" → "Žatec") for the numbers next to the title *}
{var $cities = []}
{foreach $branches as $branch}
	{var $city = trim(preg_replace('#\s*\d+$#', '', (string)$branch->city))}
	{if $city !== '' && !in_array($city, $cities, TRUE)}{var $cities[] = $city}{/if}
{/foreach}

{* 1) "Landwind" stats section ("Trusted by over 600 million users"): title + text left, numbers right *}
<section class="lw-section" id="kontakt">
	<div class="lw-container lw-stats">
		<div>
			<span class="lw-kicker">Fikko market</span>
			<h2 n:if="$title" class="lw-h2">{$title}</h2>
			<div n:if="$text" class="lw-lead">{$text|noescape}</div>
			<div n:if="count($links)" class="lw-social">
				<a n:foreach="$links as $item" n:tag-if="$item->link" href="{$item->link}">
					<img loading="lazy" decoding="async" n:if="$item->image" src="{$item->image|image:link}" alt="{$item->image|imageTitle}">
				</a>
			</div>
		</div>
		<div class="lw-stat-grid">
			<div class="lw-stat">
				<span class="lw-stat-icon"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 01.97.76l1 4A1 1 0 0117 9h-.17v7a1 1 0 01-1 1H4.17a1 1 0 01-1-1V9H3a1 1 0 01-.97-1.24l1-4A1 1 0 013 4zm3.17 5v5h2.5v-3h2.66v3h2.5V9H6.17z"/></svg></span>
				<h3><span data-count="{count($branches)}">{count($branches)}</span> prodejen</h3>
				<p>Fikko market</p>
			</div>
			<div class="lw-stat">
				<span class="lw-stat-icon"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a6 6 0 00-6 6c0 4.25 6 10 6 10s6-5.75 6-10a6 6 0 00-6-6zm0 8.5A2.5 2.5 0 1010 5.5a2.5 2.5 0 000 5z" clip-rule="evenodd"/></svg></span>
				<h3><span data-count="{count($cities)}">{count($cities)}</span> měst</h3>
				<p>{implode(', ', $cities)}</p>
			</div>
		</div>
	</div>
</section>

{* 2) branches as the template's pricing cards: centred head, details, full-width button *}
<section n:if="$branches" class="lw-section lw-section-gray lw-section-tight">
	<div class="lw-container">
		<div class="lw-grid lw-grid-3">
			<div n:foreach="$branches as $branch" class="lw-price-card">
				<a n:if="$branch->image" href="{$branchesPage->full_url}/{$branch->getUrl()}" class="lw-price-img">
					<img loading="lazy" decoding="async" src="{$branch->image|image:branch}" alt="{$branch->name}">
				</a>
				<h3 n:if="$branch->name" class="lw-price-title">
					{$branch->name}
					<a n:if="$branch->google_profile_url" href="{$branch->google_profile_url}" target="_blank" class="google-icon">
						<img src="/images/front/google-icon.webp" alt="Google" />
					</a>
				</h3>
				<p n:if="$branch->street && $branch->city && $branch->zip" class="lw-price-desc">{$branch->street}, {$branch->city} {$branch->zip}</p>
				<div class="lw-branch-text">{($branch->text ?? '')|noescape}</div>
				<a href="{$branchesPage->full_url}/{$branch->getUrl()}" class="lw-btn lw-btn-primary lw-btn-block">{content('branches', 'detail') ?: $branch->name}</a>
			</div>
		</div>
	</div>
</section>

{* 3) contact form as the template's closing call-to-action section *}
<section class="lw-section lw-cta">
	<div class="lw-container">
		<div n:if="$formTitle" class="lw-heading">
			<h2 class="lw-h2">{$formTitle}</h2>
		</div>
		<div class="lw-form-card contact-form">
			{var $namePlaceholder = $presenter->getContent('contact_form', 'name')." *"}
			{var $surnamePlaceholder = $presenter->getContent('contact_form', 'surname')." *"}
			{var $phonePlaceholder = $presenter->getContent('contact_form', 'phone')." *"}
			{var $emailPlaceholder = $presenter->getContent('contact_form', 'email')." *"}
			{var $messagePlaceholder = $presenter->getContent('contact_form', 'message')." *"}

			{form form class=>"ajax asp-form lw-form"}
				<div class="lw-form-grid">
					<div n:ifset="$form['name']" class="form-group">
						{input name class=>"form-control", placeholder=>$namePlaceholder}
					</div>
					<div n:ifset="$form['surname']" class="form-group">
						{input surname class=>"form-control", placeholder=>$surnamePlaceholder}
					</div>
					<div n:ifset="$form['phone']" class="form-group">
						{input phone class=>"form-control", placeholder=>$phonePlaceholder}
					</div>
					<div n:ifset="$form['email']" class="form-group">
						{input email class=>"form-control", placeholder=>$emailPlaceholder}
					</div>
					<div n:ifset="$form['text']" class="form-group lw-span-2">
						{input text class=>"form-control", placeholder=>$messagePlaceholder}
					</div>
				</div>

				<div n:ifset="$form['agree']" class="check-styled">
					{input agree class=>"agree-checkbox", id=>"gdpr"}
				</div>

				<div class="lw-form-bottom contact-form-bottom">
					<button n:name="send" id="basic_asp_button" type="submit" class="lw-btn lw-btn-primary basic_asp_button">{$formBtnText}</button>
				</div>
			{/form}
		</div>
	</div>
</section>
