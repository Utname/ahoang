{var $title = $block->getValue('title')}

{var $categoriesSlidersIds = $block->getValue('categoriesSlider')}
{var $categoriesSlider = $categoriesSlidersIds ? getCategories($categoriesSlidersIds, false, false) : getCategories([], false, false)}

{var $categoriesIds = $block->getValue('categories')}
{var $categories = $categoriesIds ? getCategories($categoriesIds, false, false) : getCategories([], false, false)}

{* "Landwind" feature row "Work with tools you already use": title and the categories as the
   check list on the left, the category photos as the screenshot grid on the right *}
{var $allCategories = array_merge(array_values($categoriesSlider ?: []), array_values($categories ?: []))}

<section n:if="$allCategories" class="lw-section" id="sortiment">
    <div class="lw-container lw-feature">
        <div class="lw-feature-text">
            <h2 n:if="$title" class="lw-h2">{$title}</h2>
            <ul class="lw-checklist">
                <li n:foreach="$allCategories as $category" n:if="$category->name">{$category->name}</li>
            </ul>
        </div>
        <div class="lw-shots">
            <div n:foreach="array_slice($allCategories, 0, 3) as $category" n:if="$category->image" n:class="lw-shot, lw-shot-caption, $iterator->first ? lw-shot-big">
                <img loading="lazy" decoding="async" src="{$category->image|image:categorySlider}" alt="{$category->image|imageTitle}">
                <span n:if="$category->name">{$category->name}</span>
            </div>
        </div>
    </div>
</section>
