{block content}

{var $actionPage = page('products')}
{var $branchesPage = page('branches')}

{* branch detail in the "Landwind" feature layout: details left, photo right, then map and gallery *}
<section class="lw-section lw-section-flush">
    <div class="lw-container lw-feature">
        <div class="lw-feature-text">
            <h2 n:if="$item->name" class="lw-h2 lw-title-icon">
                {$item->name}
                <a n:if="$item->google_profile_url" href="{$item->google_profile_url}" target="_blank" class="google-icon">
                    <img src="/images/front/google-icon.webp" alt="Google" />
                </a>
            </h2>
            <p n:if="$item->street && $item->city && $item->zip" class="lw-lead">{$item->street}, {$item->city} {$item->zip}</p>
            <div class="lw-info-card lw-branch-text">{($item->text ?? '')|noescape}</div>
            <div class="lw-hero-btns">
                <a n:if="$actionPage && $actionPage->full_url" href="{$actionPage->full_url}/{$item->slug}" class="lw-btn lw-btn-primary">Zobrazit akční nabídku</a>
                <a href="{$branchesPage->full_url}" class="lw-btn lw-btn-light">← Zpět na seznam poboček</a>
            </div>
        </div>
        <div n:if="$item->image_detail || $item->image" class="lw-shots">
            <div class="lw-shot lw-shot-big">
                <img loading="lazy" decoding="async" n:if="$item->image_detail" src="{$item->image_detail|image:branchDetail}" alt="{$item->name}">
                <img loading="lazy" decoding="async" n:if="!$item->image_detail" src="{$item->image|image:branch}" alt="{$item->name}">
            </div>
        </div>
    </div>
</section>

<section n:if="$item->detail_text" class="lw-section lw-section-flush">
    <div class="lw-container"><div class="lw-article">
        {$item->detail_text|noescape}
    </div></div>
</section>

<section n:if="$item->google_maps_link || ($item->lng && $item->lat)" class="lw-section lw-section-flush">
    <div class="lw-container">
        <div class="lw-map-frame">
            {if $item->google_maps_link}
                <iframe width="100%" height="460" style="border:0" loading="lazy" allowfullscreen src="{$item->getGoogleIframeSrc()}"></iframe>
            {else}
                <iframe width="100%" height="460" style="border:0" loading="lazy" allowfullscreen src="https://www.google.com/maps/embed/v1/place?q={$item->lat}%2C{$item->lng}&key=AIzaSyBwogBHWqId4gPaF5Mw92ckzFkcvz2k4bs"></iframe>
            {/if}
        </div>
    </div>
</section>

{var $branchImages = $item->getImages()}
<section n:if="count($branchImages)" class="lw-section lw-section-gray">
    <div class="lw-container">
        <div class="lw-gallery">
            <a n:foreach="$branchImages as $branchImage" href="{$branchImage->file|image:original}" data-lightbox="image-branch" class="lw-shot">
                <img loading="lazy" decoding="async" src="{$branchImage->file|image:branchImage}" alt="{$item->name}">
            </a>
        </div>
    </div>
</section>
