{block content}
{var $branchesPage = page('branches')}

<section class="product-list-section mt-2 mt-md-3 mb-2 mb-md-3">
	<div class="container">
		<div class="row branches-list">
			<div n:foreach="$items as $branch" class="col-12 col-sm-6 col-md-4 col-lg-3 contact-text-col">
				<div class="contact-text">
					<div class="contact-text-item">
						<h4 n:if="$branch->name">
							<a href="{$branchesPage->full_url}/{$branch->getUrl()}">{$branch->name}</a>
							<a n:if="$branch->google_profile_url" href="{$branch->google_profile_url}" target="_blank" class="google-icon">
								<img src="/images/front/google-icon.webp" />
							</a>
						</h4>
						<div class="branch-image">
							<img n:if="$branch->image" src="{$branch->image|image:branch}">
						</div>
						<p n:if="$branch->street && $branch->city && $branch->zip">
							{$branch->street},<br>{$branch->city} {$branch->zip}
						</p>
						{($branch->text ?? $branch->text)|noescape}
						<a href="{$branchesPage->full_url}/{$branch->getUrl()}" class="btn btn-primary m-t-20">
							{content('branches', 'detail')}
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>