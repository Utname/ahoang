{block content}
{var $branchesPage = page('branches')}

{* branch list as the "Landwind" pricing cards (same look as on the home page) *}
<section class="lw-section lw-section-flush">
	<div class="lw-container">
		<div class="lw-grid lw-grid-3">
			<div n:foreach="$items as $branch" class="lw-price-card">
				<a n:if="$branch->image" href="{$branchesPage->full_url}/{$branch->getUrl()}" class="lw-price-img">
					<img loading="lazy" decoding="async" src="{$branch->image|image:branch}" alt="{$branch->name}">
				</a>
				<h3 n:if="$branch->name" class="lw-price-title">
					{$branch->name}
					<a n:if="$branch->google_profile_url" href="{$branch->google_profile_url}" target="_blank" class="google-icon">
						<img src="/images/front/google-icon.webp" alt="Google" />
					</a>
				</h3>
				<p n:if="$branch->street && $branch->city && $branch->zip" class="lw-price-desc">{$branch->street}, {$branch->city} {$branch->zip}</p>
				<div class="lw-branch-text">{=\ArticleLayout::fixLinks($branch->text)|noescape}</div>
				<a href="{$branchesPage->full_url}/{$branch->getUrl()}" class="lw-btn lw-btn-primary lw-btn-block">{content('branches', 'detail')}</a>
			</div>
		</div>
	</div>
</section>
