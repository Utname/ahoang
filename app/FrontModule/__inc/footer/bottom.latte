{* Footer: orange call-to-action band, then a dark four-column footer (logo, contact, menu,
   branches) and a bottom bar with the copyright (back to top: the scrollup plugin). *}
{var $branchesPage = page('branches')}
{var $footerBtnText = content('header', 'menuBtnText')}
{var $footerBtnLink = content('header', 'menuBtnLink')}

<footer class="lw-footer">
    <div class="lw-container">
        <div class="lw-footer-cta">
            <div>
                <span class="lw-footer-cta-kicker">Fikko market</span>
                <h3>Ofikko nejlepší ceny</h3>
            </div>
            <div class="lw-footer-cta-btns">
                <a n:if="$footerBtnText && $footerBtnLink" href="{$footerBtnLink}" target="_self" class="lw-btn lw-btn-white home-page link">{$footerBtnText}</a>
                <a n:if="$branchesPage" href="{$branchesPage->full_url}" class="lw-btn lw-btn-ghost">{$branchesPage->name}</a>
            </div>
        </div>

        <div class="lw-footer-grid">
            <div class="lw-footer-brand">
                <a class="lw-footer-logo home-page" href="{page('home')->full_url}">
                    <img src="/images/front/logo-color.png" alt="Fikko market" />
                </a>
                <p>Supermarket s vysokou kvalitou a přiměřenou cenou – české, německé i asijské zboží.</p>
            </div>
            <div>
                <h4 class="lw-footer-title">{content('footer','textTitle') ?: 'Kontakt'}</h4>
                <div n:if="$text = content('footer','text')" class="lw-footer-text">{=\ArticleLayout::fixLinks($text)|noescape}</div>
            </div>
            <div>
                <h4 class="lw-footer-title">Menu</h4>
                <ul class="lw-footer-links">
                    {* getMenuBlocksItems() grows with every call (header, blocks): list each section once *}
                    {var $footerBlockSlugs = []}
                    {foreach $presenter->getMenuBlocksItems() as $blockItem}
                        {continueIf !isset($blockItem['slug'], $blockItem['tag'], $blockItem['name']) || in_array($blockItem['slug'], $footerBlockSlugs, TRUE)}
                        {var $footerBlockSlugs[] = $blockItem['slug']}
                        <li><a href="{isset($language) && !$language->is_default ? "/".$language->id}/{$blockItem['slug']}" class="home-page link" target="_self">{$blockItem['name']}</a></li>
                    {/foreach}
                    <li n:foreach="$presenter->getMenuItems() as $menuItem">
                        <a href="{$menuItem->url}"{$menuItem->blank ? ' target="_blank"'} class="link">{$menuItem->name}</a>
                    </li>
                </ul>
            </div>
            <div n:if="$branchesPage && ($footerBranches = footerBranches())">
                <h4 class="lw-footer-title">{$branchesPage->name}</h4>
                <ul class="lw-footer-links lw-footer-branches">
                    <li n:foreach="$footerBranches as $footerBranch">
                        <a href="{$branchesPage->full_url}/{$footerBranch->getUrl()}">{$footerBranch->name}</a>
                    </li>
                </ul>
            </div>
        </div>

        <div n:if="isset($page) && $page->system == 'branches' && !empty($item) && isset($item->fb_url) && $item->fb_url" class="lw-footer-fb">
            <div class="fb-page" data-href="{$item->fb_url}" data-tabs="" data-width="" data-height="" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true"><blockquote cite="{$item->fb_url}" class="fb-xfbml-parse-ignore"><a href="{$item->fb_url}"></a></blockquote></div>
        </div>

        <div class="lw-footer-bottom">
            <div n:if="$content = content('footer', 'copyright')">{$content|replace:['{*Y*}' => date('Y')]|noescape}</div>
        </div>
    </div>
</footer>
