{* Header in the "Landwind" style (www/css/front/landwind.css): fixed white navbar, then on the
   home page the slider as the template's hero (text left, image right) and the claim strip. *}
{var $menuBtnText = content('header', 'menuBtnText')}
{var $menuBtnLink = content('header', 'menuBtnLink')}
{* the admin logo is white text for dark backgrounds: the white navbar uses the colour logo *}
{var $logoColor = '/images/front/logo-color.png'}

<header class="lw-header" id="lw-header">
    <nav class="lw-container lw-nav">
        <a class="lw-logo home-page" href="{page('home')->full_url}">
            <img src="{$logoColor}" alt="Fikko market" />
        </a>
        <div class="lw-nav-right">
            {* languages switched on in the admin (Jazyky: active + in menu); hidden with only one *}
            <div n:if="count($presenter->getMenuLanguages()) > 1" class="lw-lang dropdown">
                <button type="button" class="lw-icon-btn dropdown-toggle" data-toggle="dropdown" aria-expanded="false" aria-label="Jazyk">
                    <img src="/images/front/flags/{$language->id}.svg" alt="">
                    <span>{$language->id|upper}</span>
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a n:foreach="$presenter->getMenuLanguages() as $menuLanguage" n:class="dropdown-item, $menuLanguage->id == $language->id ? lw-current" href="{$menuLanguage->page ? $menuLanguage->page->full_url : '/'}">
                        <img src="/images/front/flags/{$menuLanguage->id}.svg" alt="">
                        {$menuLanguage->name}
                    </a>
                </div>
            </div>
            {* staff (admin user): sign in on the admin, the session is shared with the website *}
            {if !empty($staffUser)}
                {var $staffName = $staffUser->name ?: $staffUser->email}
                <div class="lw-user dropdown">
                    <button type="button" class="lw-icon-btn lw-user-btn dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                        <span class="lw-avatar">{=mb_strtoupper(mb_substr($staffName, 0, 1))}</span>
                        <span class="lw-user-name">{$staffName}</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <div class="lw-user-head"><b>{$staffName}</b><small>{$staffUser->email}</small></div>
                        <a class="dropdown-item" href="/admin/">Administrace</a>
                        <a class="dropdown-item" href="/admin/products/">Produkty a štítky</a>
                        <a class="dropdown-item" href="/admin/mobil/">Tisk z mobilu</a>
                        <a class="dropdown-item lw-logout" href="{link staffSignOut!}">Odhlásit</a>
                    </div>
                </div>
            {else}
                <a href="{$staffLoginUrl ?? '/admin/sign/in'}" class="lw-icon-btn lw-login" title="Přihlásit">
                    <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
                    <span>Přihlásit</span>
                </a>
            {/if}
            <a n:if="$menuBtnText && $menuBtnLink" href="{$menuBtnLink}" target="_self" class="lw-btn lw-btn-primary lw-btn-sm lw-cta-desktop scroll-item home-page link">{$menuBtnText}</a>
            <button class="lw-toggle" type="button" aria-controls="lw-menu" aria-expanded="false" aria-label="Menu">
                <svg class="lw-ic-open" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
                <svg class="lw-ic-close" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.3 4.3a1 1 0 011.4 0L10 8.6l4.3-4.3a1 1 0 111.4 1.4L11.4 10l4.3 4.3a1 1 0 01-1.4 1.4L10 11.4l-4.3 4.3a1 1 0 01-1.4-1.4L8.6 10 4.3 5.7a1 1 0 010-1.4z" clip-rule="evenodd"></path></svg>
            </button>
        </div>
        <div class="lw-menu" id="lw-menu">
            <ul>
                <li n:foreach="$presenter->getMenuBlocksItems() as $item" n:if="isset($item['slug']) && isset($item['tag']) && isset($item['name'])">
                    <a href="{isset($language) && !$language->is_default ? "/".$language->id}/{$item['slug']}" class="home-page link" target="_self" data-url="{isset($language) && !$language->is_default ? "/".$language->id."/".$item['tag']}">{$item['name']}</a>
                </li>
                <li n:foreach="$presenter->getMenuItems() as $item">
                    <a href="{$item->url}"{$item->blank ? ' target="_blank"'} n:class="$item->current ? 'active', $item->system == 'home' ? 'home-page', 'link'">{$item->name}</a>
                </li>
                <li n:if="$menuBtnText && $menuBtnLink" class="d-lg-none">
                    <a href="{$menuBtnLink}" target="_self" class="scroll-item home-page link">{$menuBtnText}</a>
                </li>
            </ul>
        </div>
    </nav>
</header>

{if $page->system == 'home'}
    <section n:if="$sliders = sliders()" class="lw-hero">
        <div class="swiper" id="top-slider">
            <div class="swiper-wrapper">
                <div n:foreach="$sliders as $slider" class="swiper-slide">
                    <div class="lw-container lw-hero-grid">
                        <div>
                            <h1 n:if="$slider->name" class="lw-hero-title">{$slider->name}</h1>
                            <div class="lw-hero-text">{($slider->text ?? '')|noescape}</div>
                            <div class="lw-hero-btns">
                                <a n:if="$slider->button_text && $slider->button_link" href="{$slider->button_link}" class="lw-btn lw-btn-primary scroll-item">{$slider->button_text}</a>
                                <a n:if="$slider->button_text_2 && $slider->button_link_2" href="{$slider->button_link_2}" class="lw-btn lw-btn-light scroll-item">{$slider->button_text_2}</a>
                            </div>
                        </div>
                        <div n:if="$slider->image" class="lw-hero-img">
                            <img src="{$slider->image|image:slider}" alt="{$slider->image|imageTitle}">
                        </div>
                    </div>
                </div>
            </div>
            {* always rendered: js/front/script.js gives these elements to Swiper *}
            <div class="lw-container lw-hero-controls"{if count($sliders) < 2} hidden{/if}>
                <div class="swiper-button-prev" aria-label="Předchozí">
                    <svg width="18" height="16" viewBox="0 0 18 16"><path d="M0.95 7.47 7.95.47a.75.75 0 0 1 1.05 1.08L3.29 7.25h13.23a.75.75 0 0 1 0 1.5H3.3l5.7 5.7a.75.75 0 0 1-1.06 1.06l-7-7a.75.75 0 0 1 0-1.04z"/></svg>
                </div>
                <div class="swiper-button-next" aria-label="Další">
                    <svg width="18" height="16" viewBox="0 0 18 16"><path d="m17.05 7.47-7-7a.75.75 0 0 0-1.05 1.08l5.71 5.7H1.48a.75.75 0 0 0 0 1.5H14.7l-5.7 5.7a.75.75 0 0 0 1.06 1.06l7-7a.75.75 0 0 0 0-1.04z"/></svg>
                </div>
                <div class="swiper-scrollbar"></div>
            </div>
        </div>
    </section>
    <div class="lw-claim">
        <div class="lw-container lw-claim-inner">
            <span class="lw-claim-text">Ofikko nejlepší ceny</span>
            <img src="{$logoColor}" alt="Fikko market" />
        </div>
    </div>
{elseif $page->meta_image && $presenter->getName() !== 'Front:Content'}
    {* content pages show their image in the page title (Breadcrumbs control) *}
    <div class="lw-subhero" style="background-image: url({$page->meta_image|image:header})"></div>
{/if}
