<style>
    /* Vel.3 label, 210 x 56mm: a strip across the A4 sheet, its dashed bottom edge is
       the cut line (the next strip touches it). Measured against "vel. 3.dc.html"
       (comparison) and "vel. 3 Akce.dc.html" (30-day rule) of the handoff 19.10.2026
       printed from Chromium; numbers are mm from the card's top-left corner.
       - Dompdf ignores box-sizing and has no flexbox/grid: blocks are absolutely
         positioned, borders are drawn outside width/height.
       - Single-line text uses line-height 0, where Dompdf puts the baseline
         exactly at the block's top, so each top below is a reference baseline.
       - The price row is a 1fr | divider | 1fr grid around the card centre (105):
         the comparison group ends 9mm left of the divider (its price row 8mm more),
         "Naše cena" starts 9.2mm right of it. */
    .fikko-vel3 {
        position: relative;
        width: 210mm;
        height: 55.6mm;
        border-bottom: 0.4mm dashed #111;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    .abs { position: absolute; white-space: nowrap; }
    .lh0 { line-height: 0; }
    .nu { font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; }
    .nu4 { font-family: Nunito, sans-serif; font-weight: 400; font-style: italic; }
    .sri { font-family: Sriracha, cursive; font-weight: bold; font-style: normal; }
    .center { text-align: center; }
    .right { text-align: right; }
    .rel { position: relative; }

    .head { position: absolute; left: 0; top: 0; width: 210mm; height: 11mm; background: #111; }
    .logo-box { position: absolute; top: 0; width: 15.2mm; height: 10.2mm; background: #fff; border: 0.4mm solid #111; }
    .logo { position: absolute; top: 1.38mm; width: 8.64mm; height: 7.91mm; }
    .head-title { left: 0; width: 210mm; top: 7.79mm; font-size: 7mm; letter-spacing: 0.02em; color: #fff; }

    .name { left: 2mm; width: 206mm; top: 16.33mm; font-weight: bold; }
    .flag { position: absolute; left: 2mm; top: 18.28mm; width: 6mm; height: 6mm; border: 0.25mm solid #111; border-radius: 50%; }
    .origin-label { left: 10.02mm; top: 20.43mm; font-size: 2mm; letter-spacing: 0.08em; text-transform: uppercase; font-weight: bold; }
    .origin-name { left: 10.02mm; top: 23.54mm; font-size: 3mm; font-weight: bold; }
    .meta { top: 22.53mm; font-size: 3.8mm; }
    .note2 { left: 0; width: 208mm; top: 22.33mm; font-size: 3.2mm; }

    .base-label { font-size: 2.3mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: bold; }
    .base-val { font-size: 9mm; }
    .base-cur { font-size: 5.5mm; }
    .strike { position: absolute; left: -4%; width: 108%; top: -3.47mm; height: 0.8mm; background: #111; border-radius: 0.4mm; transform: rotate(-5.6deg); }

    .save { position: absolute; top: 36mm; height: 8.7mm; transform: rotate(-1.2deg); }
    .save-brush { position: absolute; left: 0; top: 0; height: 8.7mm; }
    .save-line { left: 4mm; top: 6.55mm; color: #fff; }
    .save-copy { letter-spacing: 0.1em; text-transform: uppercase; font-weight: bold; }
    .save-suffix { font-weight: bold; }

    .divider { position: absolute; left: 104.94mm; top: 28.3mm; width: 0.3mm; height: 16.3mm; background: #111; }

    .our-label { font-size: 2.9mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: bold; }

    .bars { position: absolute; left: 2mm; top: 47.2mm; height: 4.5mm; }
    .bars div { height: 4.5mm; }
    .ean { left: 2mm; top: 54.11mm; font-size: 3mm; font-weight: bold; }
    .unit { left: 0; width: 208mm; top: 51.06mm; font-size: 3.8mm; }
    .note3 { width: 100mm; font-size: 3.4mm; }
</style>

{var $compare = $basePrice > $finalPrice}
{* AKCE_30 follows "vel. 3 Akce.dc.html" (30-day low struck through, Ušetříte without
   "oproti běžné ceně"); a comparison follows "vel. 3.dc.html". *}
{var $akce = $compare && $isAkce30}
{var $moreSpecies = $label && $label->is_more_species}
{var $digits = strlen(str_replace(' ', '', $finalPriceMajor))}
{* "Naše cena" group: label (8.9) + gap 2 + integer (22mm, 0.58em per digit) + gap 1.2 +
   ",90" / "Kč / 1 ks" column; shrinks if it would not fit. *}
{var $unitTxt = $priceUnitText ?: $currencySymbol . ' / 1 ks'}
{var $unitColW = max(18.7, mb_strlen($unitTxt) * 0.453 * 4.6)}
{var $intW = ($digits * 0.58 + substr_count($finalPriceMajor, ' ') * 0.37) * 22}
{var $ps = min(1, (($compare ? 208 - 114.14 : 204) - 10.9) / ($intW + 1.2 + $unitColW))}
{var $fsI = round(22 * $ps, 3)}
{var $fsD = round(10 * $ps, 3)}
{var $fsU = round(4.6 * $ps, 3)}
{var $groupW = 10.9 + ($intW + 1.2 + $unitColW) * $ps}
{var $ourL = $compare ? 114.14 : 105 - $groupW / 2}
{* the badge ends at 95.94 and keeps 2mm from the left edge, its text shrinks to fit *}
{var $saveValText = $savingText . ' ' . $currencySymbol}
{var $saveW = 4 + 19.2 + 1.5 + mb_strlen($saveValText) * 0.536 * 6.5 + ($akce ? 0 : 1.5 + 25.3) + 4}
{var $ss = $saveW > 93.94 ? (93.94 - 8) / ($saveW - 8) : 1}
{var $saveW = min($saveW, 93.94)}
{* product name: bold 4.6mm on one line, smaller for a long name (DejaVu Bold ~0.66em per character) *}
{var $nameFs = max(3.2, min(4.6, 202 / (max(1, mb_strlen($labelName)) * 0.66)))}
{* origin, then "Více druhů" 3mm after it; Poznámka 1 centred, pushed right when the left part is wide *}
{var $originW = $country ? max(18.3, mb_strlen((string)$country->name) * 0.621 * 3) : 0}
{var $speciesL = $country ? 10.02 + $originW + 4.5 : 2}
{var $metaEnd = $moreSpecies ? $speciesL + 18.8 : ($country ? 10.02 + $originW : 0)}
{var $n1W = $note1 ? mb_strlen((string)$note1) * 0.54 * 3.8 : 0}
{var $n2W = $note2 ? mb_strlen((string)$note2) * 0.54 * 3.2 : 0}
{var $n1L = max($metaEnd + 3, 105 - $n1W / 2)}
{var $n1Max = 208 - ($n2W ? $n2W + 3 : 0)}
{var $n1Fs = $n1W && $n1L + $n1W > $n1Max ? max(2.4, 3.8 * ($n1Max - $n1L) / $n1W) : 3.8}
{var $n1C = $n1L + $n1W * $n1Fs / 3.8 / 2}
{* Poznámka 3: centred between the EAN block and "cena za …", at most two balanced lines *}
{var $eanR = 2 + max($bars ? 31.4 : 0, 36.3)}
{var $unitL = $unit ? 208 - mb_strlen('cena za ' . $unit->unitWeight . ' ' . $unit->unitShort . ' = ' . number_format($unit->price, 2, ',', ' ') . ' ' . $currencySymbol) * 0.476 * 3.8 : 208}
{var $n3C = ($eanR + $unitL) / 2}
{var $n3 = trim((string)$note3)}
{var $n3Lines = $n3 === '' ? [] : (mb_strlen($n3) * 0.54 * 3.4 <= $unitL - $eanR - 6 ? [$n3] : (explode("\n", wordwrap($n3, (int)max(12, ceil(mb_strlen($n3) / 2) + 3), "\n", TRUE))))}
{* a third line joins the second one *}
{if count($n3Lines) > 2}{var $n3Lines = [$n3Lines[0], implode(' ', array_slice($n3Lines, 1))]}{/if}

<div class="fikko-vel3">
    <div class="head">
        <div class="logo-box" style="left:0"><img class="logo" style="left:3.48mm" src="{$logoDataUri|nocheck}" alt="Fikko market"></div>
        <div class="abs lh0 nu center head-title">{$headerText|upper}</div>
        <div class="logo-box" style="left:194mm"><img class="logo" style="left:3.48mm" src="{$logoDataUri|nocheck}" alt="Fikko market"></div>
    </div>

    <div class="abs lh0 center name" style="font-size:{=round($nameFs, 3)|noescape}mm">{$labelName|truncate:(int)floor(202 / ($nameFs * 0.66))}</div>

    {if $country}
        <img n:if="$flagIconDataUri" class="flag" src="{$flagIconDataUri|nocheck}" alt="">
        <div class="abs lh0 origin-label">Země původu</div>
        <div class="abs lh0 origin-name">{$country->name}</div>
    {/if}
    <div n:if="$moreSpecies" class="abs lh0 sri meta" style="left:{=round($speciesL, 3)|noescape}mm">Více druhů</div>
    <div n:if="$note1" class="abs lh0 sri center meta" style="left:{=round($n1C - 50, 3)|noescape}mm;width:100mm;font-size:{=round($n1Fs, 3)|noescape}mm">{$note1}</div>
    <div n:if="$note2" class="abs lh0 sri right note2">{$note2}</div>

    {if $compare}
        <table class="abs" style="left:0;width:87.94mm;top:29.56mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
            <tr>
                <td></td>
                <td style="width:1%;padding:0 2mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                    {if $akce}
                        <div class="lh0 base-label">Nejnižší cena</div>
                        <div class="lh0 base-label rel" style="top:2.76mm">za 30 dní</div>
                    {else}
                        <div class="lh0 base-label">Běžná</div>
                        <div class="lh0 base-label rel" style="top:2.76mm">cena</div>
                    {/if}
                </td>
                <td style="width:1%;padding:0;vertical-align:top;white-space:nowrap">
                    <div class="lh0 nu base-val rel" style="top:3.55mm">{$akce ? $lowestPrice30Text : $basePriceText}&nbsp;<span class="base-cur">{$currencySymbol}</span><div n:if="$akce" class="strike"></div></div>
                </td>
            </tr>
        </table>

        <div n:if="$saving > 0" class="save" style="left:{=round(95.94 - $saveW, 3)|noescape}mm;width:{=round($saveW, 3)|noescape}mm">
            <img class="save-brush" src="{$brushDataUri|nocheck}" style="width:{=round($saveW, 3)|noescape}mm" alt="">
            <div class="abs lh0 save-line"><span class="save-copy" style="font-size:{=round(3.1 * $ss, 3)|noescape}mm">Ušetříte</span><span class="nu" style="font-size:{=round(6.5 * $ss, 3)|noescape}mm;margin-left:{=round(1.5 * $ss, 3)|noescape}mm">{$saveValText}</span><span n:if="!$akce" class="save-suffix" style="font-size:{=round(2.5 * $ss, 3)|noescape}mm;margin-left:{=round(1.5 * $ss, 3)|noescape}mm">oproti běžné ceně</span></div>
        </div>

        <div class="divider"></div>
    {/if}

    <table class="abs" style="left:{=round($ourL, 3)|noescape}mm;top:35.82mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
        <tr>
            <td style="padding:0 2mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                <div class="lh0 our-label">Naše</div>
                <div class="lh0 our-label rel" style="top:3.48mm">cena</div>
            </td>
            <td style="padding:0;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsI|noescape}mm;position:relative;top:{=round(7.89 * $ps, 3)|noescape}mm">{$finalPriceMajor}</div>
            </td>
            <td style="padding:0 0 0 1.2mm;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsD|noescape}mm;position:relative;top:{=round(-0.35 * $ps, 3)|noescape}mm">{$finalPriceMinor}</div>
                <div class="lh0 nu" style="font-size:{$fsU|noescape}mm;position:relative;top:{=round(5.91 * $ps, 3)|noescape}mm">{$unitTxt}</div>
            </td>
        </tr>
    </table>

    <div n:if="$bars" class="bars">
        <div n:foreach="$bars as $bar" n:if="$bar['dark']" style="position:absolute;top:0;left:{$bar['left']|noescape};background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
    </div>
    <div class="abs lh0 ean">EAN: {$eanText}</div>
    <div n:foreach="$n3Lines as $i => $line" class="abs lh0 sri center note3" style="left:{=round($n3C - 50, 3)|noescape}mm;top:{=round(52.64 - (count($n3Lines) - 1 - $i) * 3.91, 3)|noescape}mm">{$line}</div>
    <div n:if="$unit" class="abs lh0 nu4 right unit">cena za {$unit->unitWeight} {$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}</div>
</div>
