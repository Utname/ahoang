<style>
    /* Vel.3 label, 182 x 56mm, no outer border. Measured against "vel. 3.dc.html"
       (comparison) and "vel. 3 Akce.dc.html" (30-day rule) printed from Chromium;
       numbers are mm from the card's top-left corner.
       - Dompdf ignores box-sizing and has no flexbox/grid: blocks are absolutely
         positioned, borders are drawn outside width/height.
       - Single-line text uses line-height 0, where Dompdf puts the baseline
         exactly at the block's top, so each top below is a reference baseline.
       - The price row is a 1fr | divider | 1fr grid around the card centre (91):
         the comparison group is right-aligned 7mm left of the divider, "Naše
         cena" starts 7mm right of it. Its rows are centred vertically, so the
         two designs (and the plain price) sit at slightly different heights. */
    .fikko-vel3 {
        position: relative;
        width: 182mm;
        height: 56mm;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    .abs { position: absolute; white-space: nowrap; }
    .lh0 { line-height: 0; }
    .nu { font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; }
    .nu4 { font-family: Nunito, sans-serif; font-weight: 400; font-style: italic; }
    .center { text-align: center; }
    .right { text-align: right; }
    .rel { position: relative; }

    .head { position: absolute; left: 0; top: 0; width: 182mm; height: 11mm; background: #111; }
    .logo-box { position: absolute; top: 0; width: 15.2mm; height: 10.2mm; background: #fff; border: 0.4mm solid #111; }
    .logo { position: absolute; top: 1.38mm; width: 8.64mm; height: 7.91mm; }
    .head-title { left: 0; width: 182mm; top: 7.79mm; font-size: 7mm; letter-spacing: 0.02em; color: #fff; }

    .name { left: 0; width: 182mm; top: 16.26mm; font-size: 4.6mm; font-weight: 400; }
    .meta-c { left: 0; width: 182mm; font-size: 3.6mm; }
    .origin { top: 23.67mm; font-size: 2.8mm; }
    .flag { position: absolute; left: 20.3mm; top: 18.73mm; width: 8mm; height: 8mm; border: 0.2mm solid #111; border-radius: 50%; }
    .note2 { left: 0; width: 182mm; top: 21.28mm; font-size: 2.8mm; }

    .base-label { font-size: 2.6mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }
    .base-val { font-size: 8mm; }
    .base-cur { font-size: 5mm; }
    .strike { position: absolute; left: -4%; width: 108%; top: -3.08mm; height: 0.8mm; background: #111; border-radius: 0.4mm; transform: rotate(-5.6deg); }

    .save { position: absolute; transform: rotate(-1.2deg); }
    .save-brush { position: absolute; left: 0; top: 0; }
    .save-line { left: 0; color: #fff; }
    .save-copy { font-size: 2.8mm; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; }
    .save-val { font-size: 5.5mm; margin-left: 1.5mm; }
    .save-suffix { font-size: 2.2mm; font-weight: 600; }

    .divider { position: absolute; left: 90.9mm; top: 28.52mm; width: 0.3mm; background: #111; }

    .our-label { font-size: 2.6mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }

    .bars { position: absolute; left: 0; top: 45.73mm; height: 6mm; }
    .bars div { float: left; height: 6mm; }
    .ean { left: 0; top: 54.36mm; font-size: 3mm; font-weight: 600; }
    .unit { left: 0; width: 182mm; top: 51.45mm; font-size: 2.8mm; }
    .note3 { left: 40.3mm; width: 100mm; top: 54.89mm; font-size: 2.8mm; }
</style>

{var $compare = $basePrice > $finalPrice}
{* AKCE_30 follows "vel. 3 Akce.dc.html" (30-day low struck through, no
   "oproti běžné ceně" line); a comparison follows "vel. 3.dc.html". *}
{var $akce = $compare && $isAkce30}
{var $len = mb_strlen($finalPriceMajor)}
{* "Naše cena" group: label (8.4) + gap 2 + integer (20mm) + gap 1.2 +
   ",90" / "Kč / 1 ks" column (17.1); shrinks if it would not fit. *}
{var $ps = min(1, (82 - 10.4) / ($len * 0.58 * 20 + 1.2 + 17.1))}
{var $fsI = round(20 * $ps, 3)}
{var $fsD = round(9 * $ps, 3)}
{var $fsU = round(4.2 * $ps, 3)}
{var $groupW = 10.4 + ($len * 0.58 * 20 + 1.2 + 17.1) * $ps}
{var $ourL = $compare ? 98.15 : 91 - $groupW / 2}
{var $ourT = $akce ? 35.04 : ($compare ? 36.63 : 34.04)}
{var $saveValText = $savingText . ' ' . $currencySymbol}
{var $saveW = max(17.1 + 1.5 + mb_strlen($saveValText) * 0.536 * 5.5, $akce ? 0 : 20.2) + 9}
{var $saveH = $akce ? 9.1 : 10.9}

<div class="fikko-vel3">
    <div class="head">
        <div class="logo-box" style="left:0"><img class="logo" style="left:3.48mm" src="{$logoDataUri|nocheck}" alt="Fikko market"></div>
        <div class="abs lh0 nu center head-title">FIKKO CENA</div>
        <div class="logo-box" style="left:166mm"><img class="logo" style="left:3.48mm" src="{$logoDataUri|nocheck}" alt="Fikko market"></div>
    </div>

    <div class="abs lh0 center name">{$labelName|truncate:70}</div>

    {var $moreSpecies = $label && $label->is_more_species}
    <div n:if="$moreSpecies" class="abs lh0 nu4 center meta-c" style="top:21.02mm">Více druhů</div>
    <div n:if="$note1" class="abs lh0 nu4 center meta-c" style="top:{$moreSpecies ? '25.25' : '21.02'|noescape}mm">{$note1}</div>
    {if $country}
        <div class="abs lh0 nu origin" style="left:0">Země původu:</div>
        <img n:if="$flagIconDataUri" class="flag" src="{$flagIconDataUri|nocheck}" alt="">
        <div class="abs lh0 nu origin" style="left:30.4mm">{$country->name}</div>
    {/if}
    <div n:if="$note2" class="abs lh0 nu4 right note2">{$note2}</div>

    {if $compare}
        <table class="abs" style="left:0;width:83.85mm;top:29.49mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
            <tr>
                <td></td>
                <td style="width:1%;padding:0 2mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                    {if $akce}
                        <div class="lh0 base-label">Nejnižší cena</div>
                        <div class="lh0 base-label rel" style="top:3.17mm">za 30 dní</div>
                    {else}
                        <div class="lh0 base-label">Běžná</div>
                        <div class="lh0 base-label rel" style="top:3.17mm">cena</div>
                    {/if}
                </td>
                <td style="width:1%;padding:0;vertical-align:top;white-space:nowrap">
                    <div class="lh0 nu base-val rel" style="top:3.44mm">{$akce ? $lowestPrice30Text : $basePriceText}&nbsp;<span class="base-cur">{$currencySymbol}</span><div n:if="$akce" class="strike"></div></div>
                </td>
            </tr>
        </table>

        <div n:if="$saving > 0" class="save" style="left:{=round(83.7 - $saveW, 3)|noescape}mm;top:{$akce ? '36.75' : '36.27'|noescape}mm;width:{=round($saveW, 3)|noescape}mm;height:{$saveH|noescape}mm">
            <img class="save-brush" src="{$brushDataUri|nocheck}" style="width:{=round($saveW, 3)|noescape}mm;height:{$saveH|noescape}mm" alt="">
            <div class="abs lh0 center save-line" style="width:{=round($saveW, 3)|noescape}mm;top:{$akce ? '6.14' : '5.56'|noescape}mm"><span class="save-copy">Ušetříte</span><span class="nu save-val">{$saveValText}</span></div>
            <div n:if="!$akce" class="abs lh0 center save-line save-suffix" style="width:{=round($saveW, 3)|noescape}mm;top:9.02mm">oproti běžné ceně</div>
        </div>

        <div class="divider" style="height:{$akce ? '15.31' : '18.48'|noescape}mm"></div>
    {/if}

    <table class="abs" style="left:{=round($ourL, 3)|noescape}mm;top:{$ourT|noescape}mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
        <tr>
            <td style="padding:0 2mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                <div class="lh0 our-label">Naše</div>
                <div class="lh0 our-label rel" style="top:3.18mm">cena</div>
            </td>
            <td style="padding:0;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsI|noescape}mm;position:relative;top:{=round(7.14 * $ps, 3)|noescape}mm">{$finalPriceMajor}</div>
            </td>
            <td style="padding:0 0 0 1.2mm;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsD|noescape}mm;position:relative;top:{=round(-0.26 * $ps, 3)|noescape}mm">{$finalPriceMinor}</div>
                <div class="lh0 nu" style="font-size:{$fsU|noescape}mm;position:relative;top:{=round(5.56 * $ps, 3)|noescape}mm">{$currencySymbol} / 1 ks</div>
            </td>
        </tr>
    </table>

    <div n:if="$bars" class="bars">
        <div n:foreach="$bars as $bar" style="background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
    </div>
    <div class="abs lh0 ean">EAN: {$eanText}</div>
    <div n:if="$note3" class="abs lh0 nu4 center note3">{$note3}</div>
    <div n:if="$unit" class="abs lh0 nu4 right unit">cena za {$unit->unitWeight}{$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}</div>
</div>
