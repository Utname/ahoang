<style>
    @page { margin: 0; }
    html, body {
        margin: 0;
        padding: 0;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        background: #fff;
        color: #111;
        -webkit-font-smoothing: antialiased;
    }
    * {
        box-sizing: border-box;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    /* Dompdf ignores box-sizing:border-box here and draws the 0.4mm border
       outside width/height — measured on the real PDF: a 150x41 box came out
       150.8x41.8mm. So the inner box is 149.2x40.2mm, and the outer size
       (inner + border) is exactly the reference's 150x41mm. */
    .fikko-pecivo {
        box-sizing: border-box;
        position: relative;
        width: 149.2mm;
        height: 40.2mm;
        border: 0.4mm dashed #111;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }

    /* 1. Left Brand Column (32mm x 41mm) */
    .pecivo-brand-col {
        position: absolute;
        top: 0;
        left: 0;
        width: 32mm;
        height: 40.2mm;
        border-right: 0.4mm dashed #111;
        text-align: center;
        padding: 0;
    }
    .pecivo-brand-table {
        width: 100%;
        height: 40.2mm;
        border-collapse: collapse;
    }
    .pecivo-brand-cell {
        vertical-align: middle;
        text-align: center;
    }
    .pecivo-brand-text {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 7.5mm;
        line-height: 1.05;
        color: #111;
    }

    /* 2. Center Content Column: the reference's 1fr = 149.2 - 32 - 40 */
    .pecivo-center-col {
        position: absolute;
        top: 0;
        left: 32mm;
        width: 77.2mm;
        height: 40.2mm;
        padding: 1mm 2.5mm 0.6mm 2.5mm;
    }

    /* Top: Product Name and Subtitle */
    .pecivo-top-box {
        position: absolute;
        top: 1mm;
        left: 2.5mm;
        width: 72.2mm;
        overflow: hidden;
    }
    /* Dompdf spaces this font 1.28x the line-height (measured: 1.15 gave 5.3mm
       lines, and a second name line was cut by max-height); 0.9 gives the
       reference's 4.14mm (3.6mm x 1.15). */
    .pecivo-prod-name {
        font-size: 3.6mm;
        font-weight: 700;
        line-height: 0.9;
        color: #111;
        max-height: 9.6mm;
        overflow: hidden;
    }
    .pecivo-prod-sub {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 3.6mm;
        line-height: 1.1;
        color: #111;
        margin-top: 0.2mm;
    }

    /* Middle Area: Notes on left, Price group on right, vertically centered
       like the reference's flex:1 middle row. Its height lives on the cells:
       Dompdf ignores height on the table itself (it shrank to its content and
       sat at the top, so nothing was ever centered). Top/height are taken
       from Pecivo.dc.html rendered in Chromium and measured against this
       card, so the price lands where the reference puts it. */
    .pecivo-middle-box {
        position: absolute;
        top: 14.24mm;
        left: 2.5mm;
        width: 72.2mm;
    }
    .pecivo-middle-table {
        width: 100%;
        border-collapse: collapse;
    }
    /* Every cell/inline-block container here sets an explicit font-size and
       line-height: without one Dompdf gives it the default 16px (~5.6mm) line
       box, which inflated these boxes far beyond their content (measured: the
       Rozmrazeno badge rendered 6.3mm tall instead of 4.6mm, and the unit
       price sat 5.2mm below the price digits instead of the reference 0.5mm,
       pushing it into the barcode). */
    .pecivo-notes-cell {
        width: 25mm;
        height: 19.96mm;
        vertical-align: middle;
        text-align: left;
        font-size: 2.4mm;
        line-height: 1.15;
    }
    .pecivo-note-row {
        margin-bottom: 1.2mm;
        line-height: 1.15;
        white-space: nowrap;
        overflow: hidden;
    }
    .pecivo-note-tag {
        font-size: 2.4mm;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        color: #111;
        display: inline-block;
        margin-right: 1.5mm;
    }
    .pecivo-note-val {
        font-size: 3mm;
        font-weight: 700;
        color: #111;
    }

    .pecivo-price-cell {
        width: 47.2mm;
        height: 19.96mm;
        vertical-align: middle;
        text-align: right;
        white-space: nowrap;
        font-size: 2.4mm;
        line-height: 1;
    }

    /* Main price group: one price-group wrapper holding price-integer beside
       a price-decimal-unit column (price-decimal over price-unit) — matches
       Pecivo.dc.html's price block structure exactly. Dompdf's HTML parser
       does not treat the stylesheet block as raw text/CDATA the way a
       browser does, so a CSS comment anywhere in this block must never
       contain literal angle-bracket markup (confirmed: an earlier version
       of this exact comment, describing the bug using real example tags,
       made Dompdf exit the stylesheet block early and dump the remainder of
       this CSS as literal text onto the printed page — so this warning is
       deliberately written with no angle brackets anywhere, including in
       this sentence).
       The reference's flex row (align-items:center) is a two-cell table here
       (vertical-align:middle), since Dompdf has no flexbox.
       Dompdf line-height semantics differ from a browser's (see
       FrameDecorator/Text::get_margin_height): the box is line-height x the
       font's natural height (1.5004em for this Nunito), not x font-size, and
       the glyph is not centered in it. So each reference value L becomes
       line-height L/1.5004 (same box height as in the browser), and a
       relative top shift — which moves only the glyph, not the layout —
       puts each glyph where Chromium draws it in Pecivo.dc.html. Shifts are
       in em so the 3/4-digit sizes scale with them, and were calibrated by
       measuring both PDFs: every baseline lands within 0.05mm of the
       reference. */
    .price-group {
        margin-left: auto;
        border-collapse: collapse;
        line-height: 1;
    }
    .price-integer-cell {
        vertical-align: middle;
        padding: 0;
    }
    .price-integer {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 17mm;
        line-height: 0.5665;
        position: relative;
        top: 0.0215em;
        color: #111;
    }
    .price-decimal-unit {
        vertical-align: middle;
        text-align: left;
        padding: 0 0 0 0.8mm;
    }
    .price-decimal {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 9.5mm;
        line-height: 0.6665;
        position: relative;
        top: -0.073em;
        color: #111;
    }
    .price-unit {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 5.5mm;
        line-height: 0.6665;
        position: relative;
        top: -0.117em;
        color: #111;
        white-space: nowrap;
    }

    /* Scaling for 3+ digits */
    .price-digits-3 .price-integer { font-size: 14.5mm; }
    .price-digits-3 .price-decimal { font-size: 8.5mm; }
    .price-digits-3 .price-unit { font-size: 5.0mm; }

    .price-digits-4 .price-integer { font-size: 11.2mm; }
    .price-digits-4 .price-decimal { font-size: 6.6mm; }
    .price-digits-4 .price-unit { font-size: 4.2mm; }

    .pecivo-unit-price {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.4mm;
        line-height: 0.9091;
        position: relative;
        top: -0.485em;
        white-space: nowrap;
        text-align: right;
        margin-top: 0.5mm;
        color: #111;
    }

    /* Bottom Row: Origin, Rozmrazeno, Barcode.
       Pecivo.dc.html's own bottom row uses CSS flexbox with centered
       alignment, and an earlier version of this file tried that literally —
       confirmed by direct isolated testing that Dompdf v3.1.6 (this
       project's version) does not lay out flexbox as a row at all: even the
       simplest possible flex container with two plain block children
       rendered them stacked vertically, one per line, exactly like ordinary
       block-level elements (never written here again, since that same
       example — with its own literal angle-bracket markup — is what broke
       this style block the first time this bug was hit on this card).
       Dompdf has no real flexbox implementation, so a plain HTML table with
       vertical-align:middle is what actually produces a horizontally
       centered row in this renderer — same technique as every other row on
       this card.
       Measured against the reference (ink, mm): unit-price line to barcode
       bars ~1.2 (ref 1.28), EAN to bottom border ~1.1 (ref 1.10), badge to
       bottom border ~1.4 (ref 1.35), badge height 4.58 (ref 4.48). */
    .pecivo-bottom-box {
        position: absolute;
        left: 2.5mm;
        top: 32.85mm;
        width: 72.2mm;
        padding-top: 0.5mm;
    }
    .pecivo-bottom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 2.2mm;
        line-height: 1;
    }
    .pecivo-bottom-origin-cell {
        width: 25mm;
        vertical-align: middle;
        text-align: left;
        white-space: nowrap;
        font-size: 2.2mm;
        line-height: 1;
    }
    .pecivo-origin-flag {
        width: 4.5mm;
        height: 3mm;
        display: inline-block;
        vertical-align: middle;
        border: 0.2mm solid #111;
    }
    .pecivo-origin-name {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2mm;
        line-height: 1;
        display: inline-block;
        vertical-align: middle;
        margin-left: 1.5mm;
        color: #111;
    }

    .pecivo-bottom-badge-cell {
        width: 24mm;
        vertical-align: middle;
        text-align: center;
        white-space: nowrap;
        font-size: 2.2mm;
        line-height: 1;
    }
    /* Reference values: 0.3mm border, 1mm radius, 0.3mm 1mm padding, 3.4mm
       icon. The explicit font-size keeps the badge's own line box at 2mm, so
       the box is icon + padding + border = 4.6mm tall like the reference. */
    .pecivo-defrost-badge {
        display: inline-block;
        vertical-align: middle;
        border: 0.3mm solid #111;
        border-radius: 1mm;
        padding: 0.3mm 1mm;
        font-size: 2mm;
        line-height: 1;
        white-space: nowrap;
    }
    .pecivo-snowflake-img {
        width: 3.4mm;
        height: 3.4mm;
        display: inline-block;
        vertical-align: middle;
    }
    .pecivo-defrost-text {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2mm;
        line-height: 1;
        display: inline-block;
        vertical-align: middle;
        margin-left: 0.8mm;
        color: #111;
    }

    .pecivo-bottom-barcode-cell {
        width: 23.2mm;
        vertical-align: middle;
        text-align: right;
        white-space: nowrap;
        font-size: 1.6mm;
        line-height: 1;
    }
    .pecivo-barcode-container {
        display: inline-block;
        text-align: center;
        vertical-align: middle;
        font-size: 1.6mm;
        line-height: 1;
    }
    .pecivo-barcode-bars {
        position: relative;
        width: 22.8mm; /* 95 modules × 0.24mm, bars are absolute */
        height: 4mm;
        margin-bottom: 0.15mm;
        display: block;
        overflow: hidden;
    }
    .pecivo-barcode-bars > div {
        height: 4mm;
    }
    .pecivo-barcode-ean {
        clear: both;
        letter-spacing: 0.02em;
        font-size: 1.6mm;
        line-height: 1;
        text-align: center;
        color: #111;
    }

    /* 3. Right Column: Složení & Výrobce (40mm) */
    .pecivo-right-col {
        position: absolute;
        top: 0;
        left: 109.2mm;
        /* Content width: 40mm column minus 0.4mm border and 2x2mm padding
           (Dompdf adds border/padding outside width, see .fikko-pecivo). */
        width: 35.6mm;
        height: 40.2mm;
        border-left: 0.4mm dashed #111;
        padding: 0.8mm 2mm 0.6mm 2mm;
        overflow: hidden;
    }
    .pecivo-ingredients-title {
        font-size: 2.4mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        color: #111;
        margin-bottom: 0.3mm;
    }
    .pecivo-ingredients-text {
        font-size: 2.2mm;
        line-height: 1.2;
        font-weight: 400;
        color: #111;
        height: 22mm;
        overflow: hidden;
    }
    /* `bottom` is unreliable for absolutely-positioned elements in this
       project's Dompdf setup (confirmed repeatedly elsewhere this session,
       e.g. vel1.latte) — it rendered this box low enough that "Hermanická
       163/7, Praha 9" crossed the card's own bottom border. Pinned with an
       explicit `top` instead, calibrated against the real rendered PDF. */
    .pecivo-manufacturer-box {
        position: absolute;
        left: 2mm;
        top: 31mm;
        width: 35.6mm;
        border-top: 0.25mm dashed #111;
        padding-top: 0.5mm;
        background: #fff;
    }
    .pecivo-manufacturer-title {
        font-size: 1.8mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        color: #111;
    }
    .pecivo-manufacturer-name {
        font-size: 1.9mm;
        line-height: 1.2;
        font-weight: 700;
        color: #111;
    }
    .pecivo-manufacturer-addr {
        font-size: 1.8mm;
        line-height: 1.2;
        font-weight: 400;
        color: #111;
    }
</style>

{var $pecivoClasses = ($priceDigits >= 4 ? 'price-digits-4' : ($priceDigits >= 3 ? 'price-digits-3' : ''))}
{* Fitting the 72.2mm centre column. Widths in em per character, measured on the
   Dompdf PDF: name 0.59, sub-line 0.51, note tag 0.80 (+2.4mm gap), note value 0.60,
   price digits 0.60, ",90" 1.47em, unit text 0.45, "cena za …" 0.50. Without this a
   3-4 digit price was pushed across the right line by the notes, and a two-line name
   plus a two-line "Akce platí do …" ran into the notes. *}
{* "Více druhů" and the chosen text share the line (neither drops the other); Poznámka 3 when both are empty *}
{var $sub = implode(' · ', array_filter([($label && $label->is_more_species) ? 'Více druhů' : '', $validityCustom ? (string)$validityText : ''])) ?: (string)($note3 ?: '')}
{var $subFs = $sub !== '' ? max(2.6, min(3.6, 72.2 / (mb_strlen($sub) * 0.51))) : 3.6}
{var $sub = $sub !== '' ? ($sub|truncate:(int)floor(72.2 / ($subFs * 0.51))) : ''}
{var $fsI0 = $priceDigits >= 4 ? 11.2 : ($priceDigits >= 3 ? 14.5 : 17)}
{var $fsD0 = $priceDigits >= 4 ? 6.6 : ($priceDigits >= 3 ? 8.5 : 9.5)}
{var $fsU0 = $priceDigits >= 4 ? 4.2 : ($priceDigits >= 3 ? 5.0 : 5.5)}
{var $unitTxt = $priceUnitText ?: $currencySymbol . ' / 1 ks'}
{var $intEm = strlen(str_replace(' ', '', $finalPriceMajor)) * 0.6 + substr_count($finalPriceMajor, ' ') * 0.3}
{var $groupW = $intEm * $fsI0 + max(1.47 * $fsD0, mb_strlen($unitTxt) * 0.453 * $fsU0) + 0.8}
{var $unitPriceW = $unit ? mb_strlen('cena za ' . $unit->unitWeight . $unit->unitShort . ' = ' . number_format($unit->price, 2, ',', ' ') . ' ' . $currencySymbol) * 0.5 * 2.4 : 0}
{* note value at 3mm: capitals/digits 0.77em, spaces 0.28em, other letters 0.56em *}
{var $n1 = (string)$note1}
{var $n2 = (string)$note2}
{var $n1W = 3 * (0.77 * preg_match_all('/[\p{Lu}\d]/u', $n1) + 0.28 * substr_count($n1, ' ') + 0.56 * (mb_strlen($n1) - preg_match_all('/[\p{Lu}\d ]/u', $n1)))}
{var $n2W = 3 * (0.77 * preg_match_all('/[\p{Lu}\d]/u', $n2) + 0.28 * substr_count($n2, ' ') + 0.56 * (mb_strlen($n2) - preg_match_all('/[\p{Lu}\d ]/u', $n2)))}
{var $notesW = 21.7 + max($n1W, $n2W)}
{var $ps = max(0.7, min(1, (72.2 - $notesW - 3) / $groupW))}
{var $priceW = max($groupW * $ps, $unitPriceW)}
{if $notesW > 72.2 - 3 - $priceW}
    {* still too wide: the notes give way *}
    {var $noteMax = max(3, (int)floor((72.2 - 3 - $priceW - 21.7) / 2.31))}
    {var $note1 = ((string)$note1|truncate:$noteMax)}
    {var $note2 = ((string)$note2|truncate:$noteMax)}
    {var $notesW = 72.2 - 3 - $priceW}
{/if}
{var $flagMarkup = $flagRectDataUri ? '<img class="pecivo-origin-flag" src="' . $flagRectDataUri . '" alt="">' : ''}
{var $snowflakeMarkup = $snowflakeIconDataUri ? '<img class="pecivo-snowflake-img" src="' . $snowflakeIconDataUri . '" alt="">' : ''}

<div class="fikko-pecivo {$pecivoClasses}">
    <!-- 1. Left Brand Column (32mm) -->
    <div class="pecivo-brand-col">
        <table class="pecivo-brand-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="pecivo-brand-cell">
                    {* the label header (default "Fikko / Cena") word by word, shrunk to the 28mm column *}
                    {var $bFs = min(7.5, 28 / ($headerWordMax * 0.68))}
                    <div class="pecivo-brand-text" style="font-size:{=round($bFs, 3)|noescape}mm">
                        <div n:foreach="$headerWords as $word">{$word}</div>
                    </div>
                </td>
            </tr>
        </table>
    </div>

    <!-- 2. Center Content Column (78mm) -->
    <div class="pecivo-center-col">
        <div class="pecivo-top-box">
            {* at most two lines (~60 characters) above the notes *}
            <div class="pecivo-prod-name">{$labelName|truncate:60}</div>
            {* one line; the "Akce platí do …" text follows Skrýt platnost *}
            <div n:if="$sub !== ''" class="pecivo-prod-sub" style="font-size:{=round($subFs, 3)|noescape}mm;white-space:nowrap">{$sub}</div>
        </div>

        <div class="pecivo-middle-box">
            <table class="pecivo-middle-table" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="pecivo-notes-cell" style="width:{=round($notesW, 3)|noescape}mm">
                        <div class="pecivo-note-row">
                            <span class="pecivo-note-tag">Poznámka 1</span>
                            <span class="pecivo-note-val">{$note1 ?: ''}</span>
                        </div>
                        <div class="pecivo-note-row">
                            <span class="pecivo-note-tag">Poznámka 2</span>
                            <span class="pecivo-note-val">{$note2 ?: ''}</span>
                        </div>
                    </td>
                    <td class="pecivo-price-cell" style="width:{=round(72.2 - $notesW, 3)|noescape}mm">
                        <table class="price-group" cellpadding="0" cellspacing="0">
                            <tr>
                                <td class="price-integer-cell"><div class="price-integer" style="font-size:{=round($fsI0 * $ps, 3)|noescape}mm">{$finalPriceMajor}</div></td>
                                <td class="price-decimal-unit" style="padding-left:{=round(0.8 * $ps, 3)|noescape}mm">
                                    <div class="price-decimal" style="font-size:{=round($fsD0 * $ps, 3)|noescape}mm">{$finalPriceMinor}</div>
                                    <div class="price-unit" style="font-size:{=round($fsU0 * $ps, 3)|noescape}mm">{$unitTxt}</div>
                                </td>
                            </tr>
                        </table>
                        <div n:if="$unit" class="pecivo-unit-price">
                            cena za {$unit->unitWeight}{$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <div class="pecivo-bottom-box">
            <table class="pecivo-bottom-table" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="pecivo-bottom-origin-cell">
                        {* No country: nothing is printed (no invented flag or name). *}
                        {if $country && $country->name && $country->name !== '-'}
                            {$flagMarkup|noescape}
                            <span class="pecivo-origin-name">{$country->name}</span>
                        {/if}
                    </td>
                    <td class="pecivo-bottom-badge-cell">
                        <div n:if="$isThawed" class="pecivo-defrost-badge">
                            {$snowflakeMarkup|noescape}
                            <span class="pecivo-defrost-text">Rozmrazeno</span>
                        </div>
                    </td>
                    <td class="pecivo-bottom-barcode-cell">
                        <div class="pecivo-barcode-container">
                            <div n:if="$bars" class="pecivo-barcode-bars">
                                <div n:foreach="$bars as $bar" n:if="$bar['dark']" style="position:absolute;top:0;left:{$bar['left']|noescape};background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
                            </div>
                            <div class="pecivo-barcode-ean">{$eanText}</div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <!-- 3. Right Column: Složení & Výrobce (40mm) -->
    <div class="pecivo-right-col">
        {* Empty or hidden ingredients hide the whole block, title included (CACH-LAM-CODE.md). *}
        {if !$hideIngredients && $ingredients !== ''}
            <div class="pecivo-ingredients-title">Složení</div>
            <div class="pecivo-ingredients-text">{$ingredients|truncate:130}</div>
        {/if}

        <div class="pecivo-manufacturer-box">
            <div class="pecivo-manufacturer-title">Výrobce</div>
            <div class="pecivo-manufacturer-name">Fikko market s.r.o.</div>
            <div class="pecivo-manufacturer-addr">Hermanická 163/7, Praha 9</div>
        </div>
    </div>
</div>
