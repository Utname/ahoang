<style>
    @page { size: A4; margin: 0; }
    html, body { margin: 0; padding: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; background: #fff; color: #111; -webkit-font-smoothing: antialiased; }
    * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    .page {
        box-sizing: border-box;
        width: 100%;
        height: 269mm;
        padding: 14mm;
        background: #fff;
        color: #111;
        overflow: hidden;
        page-break-inside: avoid;
        page-break-after: avoid;
    }

    .logo-box {
        width: 210mm;
        margin: 6mm -14mm 6mm -14mm;
        text-align: center;
    }
    .logo-box img {
        width: 36mm;
        height: 25mm;
        display: inline-block;
    }

    .header-box {
        display: table;
        width: 210mm;
        height: 23mm;
        background: #111;
        color: #fff;
        text-align: center;
        margin: 0 -14mm;
    }
    .header-box .title {
        display: table-cell;
        vertical-align: middle;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 18mm;
        line-height: 1;
        letter-spacing: 0.04em;
    }

    .content-box {
        margin-top: 3mm;
    }
    .prod-name {
        font-size: 8mm;
        line-height: 1.15;
        font-weight: 400;
        text-align: center;
        padding-bottom: 2mm;
    }

    .subtitle-box {
        text-align: center;
        padding-bottom: 1.5mm;
    }
    .subtitle-box .sub-text {
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-weight: 400;
        font-size: 6mm;
        line-height: 1.1;
    }

    .main-row {
        position: relative;
        padding-top: 2mm;
    }
    .left-col {
        position: absolute;
        top: 0;
        left: 0;
        white-space: nowrap;
    }
    .note1-text {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 6mm;
        line-height: 1.1;
        margin-bottom: 4mm;
        white-space: nowrap;
    }
    .origin-box {
        display: table;
        white-space: nowrap;
    }
    .origin-box .flag-cell {
        display: table-cell;
        width: 15mm;
        vertical-align: middle;
    }
    .origin-box .flag-img {
        width: 15mm;
        height: 15mm;
        display: block;
        border: 0.4mm solid #111;
        border-radius: 50%;
    }
    .origin-box .flag-text {
        display: table-cell;
        padding-left: 3.5mm;
        vertical-align: middle;
        white-space: nowrap;
    }
    .origin-box .flag-label {
        font-size: 3.5mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        opacity: 0.65;
        white-space: nowrap;
    }
    .origin-box .flag-name {
        font-size: 5.3mm;
        font-weight: 800;
        line-height: 1.1;
        white-space: nowrap;
    }

    .price-col {
        text-align: center;
        margin-left: 45mm;
    }
    .lowest-box {
        position: relative;
        text-align: right;
        padding-right: 15mm;
        margin-bottom: 1.5mm;
    }
    .lowest-label {
        display: inline-block;
        vertical-align: middle;
        font-size: 3.6mm;
        line-height: 1.2;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        text-align: right;
        margin-right: 3mm;
    }
    .lowest-val-box {
        position: relative;
        display: inline-block;
        vertical-align: middle;
    }
    .lowest-val {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 11mm;
        line-height: 1;
        color: #111;
    }
    .lowest-val span {
        font-size: 6.5mm;
    }
    .lowest-strike-img {
        position: absolute;
        left: -1mm;
        top: 4.8mm;
        width: 26mm;
        height: 7mm;
    }

    .our-label {
        font-size: 4mm;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 2mm;
    }

    .main-price {
        display: table;
        margin: 0 auto;
        white-space: nowrap;
    }
    .price-major {
        display: table-cell;
        vertical-align: top;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 61mm;
        line-height: 0.82;
        letter-spacing: -0.03em;
    }
    .price-minor-col {
        display: table-cell;
        vertical-align: top;
        padding-left: 2mm;
        text-align: left;
    }
    .price-minor {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 23.5mm;
        line-height: 0.9;
    }
    .price-currency {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 6.5mm;
        line-height: 0.9;
        white-space: nowrap;
        margin-top: 13mm;
    }

    .save-box {
        position: relative;
        width: 112mm;
        height: 19mm;
        margin: 3.5mm auto 0 auto;
        color: #fff;
    }
    .save-brush {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }
    .save-inner {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 19mm;
        text-align: center;
    }
    .save-table {
        height: 19mm;
        border-collapse: collapse;
        margin: 0 auto;
    }
    .save-pig-cell {
        vertical-align: middle;
        text-align: right;
        padding-right: 3.5mm;
    }
    .save-pig {
        display: block;
        width: 11.5mm;
        height: 11.5mm;
    }
    .save-copy-cell {
        vertical-align: middle;
        text-align: left;
        white-space: nowrap;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 6.8mm;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #fff;
        line-height: 1;
        padding-right: 3.5mm;
    }
    .save-val-cell {
        vertical-align: middle;
        text-align: left;
        white-space: nowrap;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 13.5mm;
        line-height: 1;
        color: #fff;
    }

    .unit-box {
        margin-top: 2mm;
        font-size: 4.8mm;
        font-weight: 700;
    }
    .unit-val {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 6mm;
        margin-left: 2mm;
    }

    .note3-box {
        text-align: center;
        margin-top: 6mm;
        clear: both;
    }
    .note3-text {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 6mm;
        line-height: 1.15;
        text-align: center;
        max-width: 150mm;
        margin: 0 auto;
    }

    .bottom-box {
        display: table;
        width: 100%;
        margin-top: 6mm;
        clear: both;
    }
    .barcode-col {
        display: table-cell;
        vertical-align: bottom;
        width: 50mm;
        text-align: left;
    }
    .barcode-bars {
        display: block;
        height: 8.5mm;
        white-space: nowrap;
    }
    .barcode-ean {
        font-size: 2.9mm;
        letter-spacing: 0.14em;
        font-weight: 600;
        margin-top: 1mm;
    }

    .validity-box {
        display: table-cell;
        vertical-align: bottom;
        text-align: center;
        padding-bottom: 1mm;
    }
    .validity-text {
        font-size: 3.6mm;
        font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .price-digits-3 .price-major { font-size: 50mm; }
    .price-digits-3 .price-minor { font-size: 20mm; }
    .price-digits-3 .price-currency { margin-top: 10mm; font-size: 6mm; }
    .price-digits-3 .lowest-strike-img { width: 32mm; }
</style>

{var $pageClasses = 'page' . ($priceDigits >= 3 ? ' price-digits-3' : '')}
{var $logoMarkup = '<img src="' . $logoDataUri . '" alt="Fikko market">'}
{var $flagMarkup = $flagIconDataUri ? '<img class="flag-img" src="' . $flagIconDataUri . '" alt="">' : ''}
{var $brushMarkup = '<img class="save-brush" src="' . $brushDataUri . '" alt="">'}
{var $pigMarkup = '<img class="save-pig" src="' . $pigIconDataUri . '" alt="">'}
{var $strikeMarkup = '<img class="lowest-strike-img" src="' . $strikeSlashDataUri . '" alt="">'}

<section class="{$pageClasses}" data-document-role="page" data-label="Fikko Cena – tem A4 Akce" data-screen-label="A4 – 1 tem">

    <div class="logo-box">
        {$logoMarkup|noescape}
    </div>

    <header class="header-box">
        <div class="title">FIKKO CENA</div>
    </header>

    <div class="content-box">
        <div class="prod-name">{$labelName}</div>

        <div n:if="$label && $label->is_more_species" class="subtitle-box">
            <div class="sub-text">Více druhů</div>
        </div>

        <div class="main-row">
            <div class="left-col">
                <div n:if="$note1" class="note1-text">{$note1}</div>
                <div n:if="$country" class="origin-box">
                    <div class="flag-cell">{$flagMarkup|noescape}</div>
                    <div class="flag-text">
                        <div class="flag-label">Země původu</div>
                        <div class="flag-name">{$country->name}</div>
                    </div>
                </div>
            </div>

            <div class="price-col">
                <div class="lowest-box">
                    <div class="lowest-label">Nejnižší cena<br>za 30 dní</div>
                    <div class="lowest-val-box">
                        <div class="lowest-val">{$basePriceText} <span>{$currencySymbol}</span></div>
                        {$strikeMarkup|noescape}
                    </div>
                </div>

                <div class="our-label">Naše cena</div>

                <div class="main-price">
                    <div class="price-major">{$finalPriceMajor}</div>
                    <div class="price-minor-col">
                        <div class="price-minor">{$finalPriceMinor}</div>
                        <div class="price-currency">{$currencySymbol} / ks</div>
                    </div>
                </div>

                <div n:if="$saving > 0" class="save-box">
                    {$brushMarkup|noescape}
                    <div class="save-inner">
                        <table class="save-table" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td class="save-pig-cell">
                                    {$pigMarkup|noescape}
                                </td>
                                <td class="save-copy-cell">
                                    UŠETŘÍTE
                                </td>
                                <td class="save-val-cell">
                                    {$savingText}&nbsp;{$currencySymbol}
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div n:if="$unit" class="unit-box">
                    <span>Cena za {$unit->unitWeight} {$unit->unitShort}</span>
                    <span class="unit-val">{$unit->price|number:2,',',' '} {$currencySymbol}</span>
                </div>
            </div>
        </div>

        <div n:if="$note3 || $note2" class="note3-box">
            <div class="note3-text">{$note3 ?: $note2}</div>
        </div>

        <div class="bottom-box">
            <div class="barcode-col">
                <div n:if="$bars" class="barcode-bars">
                    <div n:foreach="$bars as $bar" style="float:left;height:8.5mm;background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
                    <div style="clear:both"></div>
                </div>
                <div n:if="$eanText" class="barcode-ean">EAN {$eanText}</div>
            </div>

            <div n:if="!$hideValidity && $validityText" class="validity-box">
                <div class="validity-text">Akce platí do <b>{$validityText}</b> nebo do vyprodání zásob</div>
            </div>
        </div>
    </div>

</section>
