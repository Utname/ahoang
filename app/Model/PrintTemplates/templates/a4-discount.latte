<style>
    @page { margin: 0; }
    html, body { margin: 0; padding: 0; background: #fff; color: #111; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
    .fikko-a4 { box-sizing: border-box; position: relative; width: 194mm; height: 281mm; margin: 8mm; overflow: hidden; }
    .fikko-a4 .logo { position: absolute; top: 13mm; left: 76mm; width: 42mm; height: 30mm; object-fit: contain; filter: grayscale(1) contrast(1.15); }
    .fikko-a4 .heading { position: absolute; top: 49mm; left: 0; width: 194mm; height: 22mm; display: table; background: #111; color: #fff; text-align: center; }
    .fikko-a4 .heading span { display: table-cell; vertical-align: middle; font-family: Nunito, sans-serif; font-size: 14mm; font-weight: 900; font-style: italic; line-height: 1; letter-spacing: .02em; }
    .fikko-a4 .product-name { position: absolute; top: 76mm; left: 0; width: 194mm; text-align: center; font-size: 8mm; font-weight: 400; line-height: 1.15; }
    .fikko-a4 .product-meta { position: absolute; top: 94mm; left: 0; width: 194mm; min-height: 13mm; border-bottom: .5mm solid #111; text-align: center; }
    .fikko-a4 .more-species { font-family: Nunito, sans-serif; font-size: 8.5mm; font-weight: 400; font-style: italic; line-height: 1.1; }
    .fikko-a4 .validity { position: absolute; right: 0; top: -8mm; font-size: 5mm; font-weight: 800; white-space: nowrap; }
    .fikko-a4 .validity-label { margin-right: 3mm; color: #555; font-size: 3.6mm; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .fikko-a4 .note-1 { position: absolute; top: 116mm; left: 60mm; white-space: nowrap; font-family: Nunito, sans-serif; font-size: 6mm; font-weight: 900; font-style: italic; }
    .fikko-a4 .origin { position: absolute; top: 128mm; left: 0; display: table; }
    .fikko-a4 .origin-icon { display: table-cell; width: 15mm; vertical-align: middle; }
    .fikko-a4 .origin-icon img { display: block; width: 15mm; height: auto; border: .15mm solid #ccc; }
    .fikko-a4 .origin-text { display: table-cell; padding-left: 3.5mm; vertical-align: middle; }
    .fikko-a4 .origin-label { color: #555; font-size: 3.5mm; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .fikko-a4 .origin-name { font-size: 5.3mm; font-weight: 800; line-height: 1.1; }
    .fikko-a4 .base-price { position: absolute; top: 116mm; right: 12mm; white-space: nowrap; }
    .fikko-a4 .base-label { font-size: 4mm; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .fikko-a4 .base-value { margin-left: 3mm; font-family: Nunito, sans-serif; font-size: 11mm; font-weight: 900; font-style: italic; }
    .fikko-a4 .our-price-label { position: absolute; top: 149mm; left: 70mm; font-size: 4mm; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .fikko-a4 .price { position: absolute; top: 149mm; left: 57mm; display: table; white-space: nowrap; }
    .fikko-a4 .price-major { display: table-cell; font-family: Nunito, sans-serif; font-size: 72mm; font-weight: 900; font-style: italic; line-height: .82; letter-spacing: -.03em; }
    .fikko-a4 .price-side { display: table-cell; vertical-align: top; padding-left: 3mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; }
    .fikko-a4 .price-minor { font-size: 28mm; line-height: .9; }
    .fikko-a4 .price-currency { margin-top: 15mm; font-size: 11mm; line-height: .9; }
    .fikko-a4 .save { position: absolute; top: 235mm; left: 22mm; width: 150mm; height: 19mm; color: #fff; white-space: nowrap; transform: rotate(-1.2deg); }
    .fikko-a4 .save-brush { position: absolute; inset: 0; width: 150mm; height: 19mm; }
    .fikko-a4 .save-content { position: absolute; top: 3.2mm; left: 7mm; display: table; height: 11mm; }
    .fikko-a4 .save-pig-cell { display: table-cell; width: 11mm; vertical-align: middle; }
    .fikko-a4 .save-pig { display: block; width: 11mm; height: 11mm; }
    .fikko-a4 .save-copy, .fikko-a4 .save-value, .fikko-a4 .save-suffix { display: table-cell; vertical-align: middle; }
    .fikko-a4 .save-copy { padding-left: 4mm; font-size: 5mm; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .fikko-a4 .save-value { padding-left: 2mm; font-family: Nunito, sans-serif; font-size: 10.5mm; font-weight: 900; font-style: italic; line-height: 1; }
    .fikko-a4 .save-suffix { padding-left: 2mm; font-size: 3.2mm; font-weight: 600; }
    .fikko-a4 .unit { position: absolute; top: 258mm; left: 64mm; white-space: nowrap; font-size: 4.8mm; font-weight: 700; }
    .fikko-a4 .unit-value { margin-left: 3.5mm; font-family: Nunito, sans-serif; font-size: 6mm; font-weight: 900; font-style: italic; }
    .fikko-a4 .ean { position: absolute; left: 0; bottom: 0; width: 42mm; margin: 0; padding-top: .5mm; background: #fff; font-size: 2.9mm; font-weight: 600; line-height: 1; letter-spacing: .14em; white-space: nowrap; }
    .fikko-a4 .notes-bottom { position: absolute; right: 42mm; bottom: 5mm; width: 110mm; text-align: center; white-space: nowrap; font-family: Nunito, sans-serif; font-size: 6mm; font-weight: 900; font-style: italic; line-height: 1.1; }
    .fikko-a4 .notes-bottom div + div { margin-top: 1mm; }
    .fikko-a4.long-name .product-meta { top: 105mm; }
    .fikko-a4.long-name .note-1, .fikko-a4.long-name .base-price { top: 127mm; }
    .fikko-a4.long-name .origin { top: 139mm; }
    .fikko-a4.long-name .our-price-label { top: 160mm; }
    .fikko-a4.long-name .price { top: 157mm; }
    .fikko-a4.long-name .save { top: 240mm; }
    .fikko-a4.long-name .unit { top: 264mm; }
    .fikko-a4.price-digits-3 .our-price-label { left: 60mm; }
    .fikko-a4 .price { top: 146mm; }
    .fikko-a4.price-digits-3 .price { left: 43mm; }
    .fikko-a4.price-digits-3 .price-major { font-size: 56mm; }
    .fikko-a4.price-digits-3 .price-side { padding-left: 2mm; }
    .fikko-a4.price-digits-3 .price-minor { font-size: 22mm; }
    .fikko-a4.price-digits-3 .price-currency { margin-top: 11mm; font-size: 9mm; }
</style>

{var $a4Classes = 'fikko-a4' . ($priceDigits >= 3 ? ' price-digits-3' : '') . ($labelNameLength > 48 ? ' long-name' : '')}
{var $logoMarkup = '<img class="logo" src="' . $logoDataUri . '" alt="Fikko market">'}
{var $flagMarkup = $flagIconDataUri ? '<img src="' . $flagIconDataUri . '" alt="">' : ''}
{var $brushMarkup = '<img class="save-brush" src="' . $brushDataUri . '" alt="">'}
{var $pigMarkup = '<img class="save-pig" src="' . $pigIconDataUri . '" alt="">'}
<section class="{$a4Classes}">
    {$logoMarkup|noescape}
    <div class="heading"><span>FIKKO CENA</span></div>

    <div class="product-name">{$labelName}</div>
    <div class="product-meta">
        <div n:if="$label && $label->is_more_species" class="more-species">Více druhů</div>
        <div n:if="!$hideValidity && $validityText" class="validity"><span class="validity-label">Platnost</span>{$validityText}</div>
    </div>

    <div n:if="$note1" class="note-1">{$note1}</div>

    <div n:if="$country" class="origin">
        <div class="origin-icon">{$flagMarkup|noescape}</div>
        <div class="origin-text"><div class="origin-label">Země původu</div><div class="origin-name">{$country->name}</div></div>
    </div>

    <div class="base-price"><span class="base-label">Běžná cena</span><span class="base-value">{$basePriceText} {$currencySymbol}</span></div>
    <div class="our-price-label">Naše cena</div>
    <div class="price"><div class="price-major">{$finalPriceMajor}</div><div class="price-side"><div class="price-minor">{$finalPriceMinor}</div><div class="price-currency">{$currencySymbol} / 1 ks</div></div></div>

    <div n:if="$saving > 0" class="save">{$brushMarkup|noescape}<div class="save-content"><span class="save-pig-cell">{$pigMarkup|noescape}</span><span class="save-copy">Ušetříte</span><span class="save-value">{$savingText} {$currencySymbol}</span><span class="save-suffix">oproti běžné ceně</span></div></div>
    <div n:if="$unit" class="unit">Cena za {$unit->unitWeight} {$unit->unitShort}<span class="unit-value">{$unit->price|number:2,',',''} {$currencySymbol}</span></div>
    <div class="ean">EAN {$eanText}</div>
    <div class="notes-bottom"><div n:if="$note2">{$note2}</div><div n:if="$note3">{$note3}</div></div>
</section>
