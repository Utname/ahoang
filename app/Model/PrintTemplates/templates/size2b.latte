<style>
    @page { margin: 0; }
    html, body { margin: 0; padding: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; background: #fff; color: #111; -webkit-font-smoothing: antialiased; }
    * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    .fikko-vel2 {
        box-sizing: border-box;
        position: relative;
        width: 133mm;
        height: 41mm;
        border: 0.4mm dashed #111;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }

    /* Left logo / brand column (24mm x 41mm) */
    .vel2-logo-col {
        position: absolute;
        top: 0;
        left: 0;
        width: 24mm;
        height: 41mm;
        border-right: 0.4mm dashed #111;
        text-align: center;
        padding: 1.2mm 1mm;
    }
    .vel2-logo-img {
        width: 14mm;
        height: 11mm;
        object-fit: contain;
        display: block;
        margin: 0 auto;
        filter: grayscale(1) contrast(1.15);
    }
    .vel2-logo-divider {
        width: 21mm;
        margin: 1.2mm auto 1.2mm auto;
        border-top: 0.3mm dashed #111;
    }
    .vel2-brand-text {
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 5.8mm;
        line-height: 1.05;
        color: #111;
    }

    /* Right main content column (109mm x 41mm) */
    .vel2-content-col {
        position: absolute;
        top: 0;
        left: 28.5mm;
        width: 102.5mm;
        height: 41mm;
        padding: 0.6mm 1.5mm 0.4mm 1.5mm;
    }

    /* 1. Product Name */
    .vel2-prod-name {
        text-align: center;
        font-size: 3.2mm;
        font-weight: 400;
        line-height: 1.1;
        overflow: hidden;
        white-space: nowrap;
        height: 3.5mm;
    }

    /* 2. Meta row (Origin, Note1, More species) */
    .vel2-meta-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0.1mm;
    }
    .vel2-meta-left {
        width: 44mm;
        vertical-align: middle;
        text-align: left;
    }
    .vel2-meta-center {
        vertical-align: middle;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-size: 2.2mm;
        font-weight: 400;
        line-height: 1.1;
        white-space: nowrap;
    }
    .vel2-meta-right {
        width: 25mm;
        vertical-align: middle;
        text-align: right;
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-size: 2.2mm;
        font-weight: 400;
        line-height: 1.1;
        white-space: nowrap;
    }

    /* Origin box inside meta-left */
    .vel2-origin-box {
        display: table;
        white-space: nowrap;
    }
    .vel2-origin-flag-cell {
        display: table-cell;
        width: 5.5mm;
        vertical-align: middle;
    }
    .vel2-origin-flag-img {
        width: 4.5mm;
        height: 4.5mm;
        display: block;
        border: 0.25mm solid #111;
        border-radius: 50%;
    }
    .vel2-origin-text-cell {
        display: table-cell;
        vertical-align: middle;
        padding-left: 1.2mm;
        white-space: nowrap;
    }
    .vel2-origin-label {
        font-size: 1.7mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        color: #111;
        display: block;
        line-height: 1;
    }
    .vel2-origin-name {
        font-size: 2.6mm;
        font-weight: 800;
        line-height: 1.05;
        display: block;
        white-space: nowrap;
    }

    /* 3. Main Price Comparison Section */
    .vel2-price-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0.1mm;
    }
    .vel2-price-left {
        width: 47mm;
        vertical-align: middle;
        text-align: right;
        padding-right: 2mm;
    }
    .vel2-price-divider {
        width: 0.3mm;
        background: #111;
        padding: 0;
    }
    .vel2-price-right {
        vertical-align: middle;
        text-align: left;
        padding-left: 2.5mm;
    }

    /* Běžná cena */
    .vel2-base-row {
        white-space: nowrap;
        text-align: right;
    }
    .vel2-base-label {
        display: inline-block;
        vertical-align: middle;
        font-size: 2mm;
        line-height: 1.15;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        text-align: right;
        margin-right: 1.5mm;
    }
    .vel2-base-val {
        display: inline-block;
        vertical-align: middle;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 5.6mm;
        line-height: 1;
    }
    .vel2-base-currency {
        font-size: 3.5mm;
    }

    /* Ušetříte brush badge */
    .vel2-save-box {
        position: relative;
        width: 44mm;
        height: 4.4mm;
        margin-top: 0.3mm;
        margin-left: auto;
        transform: rotate(-1.2deg);
        color: #fff;
    }
    .vel2-save-brush {
        position: absolute;
        top: 0;
        left: 0;
        width: 44mm;
        height: 4.4mm;
        z-index: 0;
    }
    .vel2-save-table {
        position: relative;
        z-index: 1;
        width: 44mm;
        height: 4.4mm;
        border-collapse: collapse;
        margin: 0 auto;
    }
    .vel2-save-copy-cell {
        vertical-align: middle;
        text-align: right;
        font-size: 1.7mm;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        white-space: nowrap;
        padding-left: 1.5mm;
    }
    .vel2-save-val-cell {
        vertical-align: middle;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 3.6mm;
        line-height: 1;
        white-space: nowrap;
        padding: 0 0.6mm;
    }
    .vel2-save-suffix-cell {
        vertical-align: middle;
        text-align: left;
        font-size: 1.5mm;
        font-weight: 600;
        white-space: nowrap;
        padding-right: 1.5mm;
    }

    /* Naše cena */
    .vel2-our-row {
        white-space: nowrap;
    }
    .vel2-our-label {
        display: inline-block;
        vertical-align: middle;
        font-size: 2mm;
        line-height: 1.15;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        text-align: right;
        margin-right: 1.5mm;
    }
    .vel2-main-price-box {
        display: inline-block;
        vertical-align: middle;
        white-space: nowrap;
    }
    .vel2-price-major {
        display: inline-block;
        vertical-align: top;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 16mm;
        line-height: 0.82;
    }
    .vel2-price-minor-col {
        display: inline-block;
        vertical-align: top;
        text-align: left;
        padding-top: 0.2mm;
        margin-left: 0.5mm;
    }
    .vel2-price-minor {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 7.2mm;
        line-height: 0.9;
    }
    .vel2-price-currency {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 3.1mm;
        line-height: 0.9;
        white-space: nowrap;
        margin-top: 0.3mm;
    }

    /* 4. Unit price row */
    .vel2-unit-price {
        text-align: right;
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-size: 2mm;
        white-space: nowrap;
        padding-right: 1mm;
        line-height: 1.1;
        margin-top: 0.1mm;
        margin-bottom: 0.1mm;
    }

    /* 5. Bottom row (Barcode, Note 3) */
    .vel2-bottom-table {
        width: 100%;
        border-collapse: collapse;
    }
    .vel2-barcode-cell {
        width: 42mm;
        vertical-align: bottom;
        text-align: left;
    }
    .vel2-barcode-bars {
        height: 3.2mm;
        white-space: nowrap;
        margin-bottom: 0.1mm;
    }
    .vel2-barcode-bars > div {
        float: left;
        height: 100%;
    }
    .vel2-barcode-ean {
        font-size: 1.7mm;
        font-weight: 600;
        white-space: nowrap;
        letter-spacing: 0.04em;
        line-height: 1;
        clear: both;
    }
    .vel2-note3-cell {
        vertical-align: bottom;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-size: 2mm;
        line-height: 1.15;
        max-height: 4mm;
        overflow: hidden;
    }
    .vel2-bottom-spacer {
        width: 20mm;
    }

    /* 3-digit price scaling (e.g. 139,90) */
    .price-digits-3 .vel2-price-major { font-size: 14mm; }
    .price-digits-3 .vel2-price-minor { font-size: 6.2mm; }
    .price-digits-3 .vel2-price-currency { font-size: 2.8mm; margin-top: 0.2mm; }
    .price-digits-3 .vel2-base-val { font-size: 4.8mm; }
    .price-digits-3 .vel2-price-left { width: 42mm; }
</style>

{var $vel2Classes = ($priceDigits >= 3 ? 'price-digits-3' : '')}
{var $logoMarkup = '<img class="vel2-logo-img" src="' . $logoDataUri . '" alt="Fikko market">'}
{var $flagMarkup = $flagIconDataUri ? '<img class="vel2-origin-flag-img" src="' . $flagIconDataUri . '" alt="">' : ''}
{var $brushMarkup = '<img class="vel2-save-brush" src="' . $brushDataUri . '" alt="">'}

<div class="fikko-vel2 {$vel2Classes}">
    <div class="vel2-logo-col">
        {$logoMarkup|noescape}
        <div class="vel2-logo-divider"></div>
        <div class="vel2-brand-text">
            <div>Fikko</div>
            <div>Cena</div>
        </div>
    </div>

    <div class="vel2-content-col">
        <div class="vel2-prod-name">{$labelName}</div>

        <table class="vel2-meta-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel2-meta-left">
                    <div n:if="$country" class="vel2-origin-box">
                        <div class="vel2-origin-flag-cell">{$flagMarkup|noescape}</div>
                        <div class="vel2-origin-text-cell">
                            <span class="vel2-origin-label">Země původu</span>
                            <span class="vel2-origin-name">{$country->name}</span>
                        </div>
                    </div>
                </td>
                <td class="vel2-meta-center">
                    <div n:if="$note1">{$note1}</div>
                </td>
                <td class="vel2-meta-right">
                    <div n:if="$label && $label->is_more_species">Více druhů</div>
                </td>
            </tr>
        </table>

        <table class="vel2-price-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel2-price-left">
                    <div n:if="$basePrice > $finalPrice" class="vel2-base-row">
                        <span class="vel2-base-label">Běžná<br>cena</span>
                        <span class="vel2-base-val">{$basePriceText} <span class="vel2-base-currency">{$currencySymbol}</span></span>
                    </div>
                    <div n:if="$basePrice > $finalPrice && $saving > 0" class="vel2-save-box">
                        {$brushMarkup|noescape}
                        <table class="vel2-save-table" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td class="vel2-save-copy-cell">UŠETŘÍTE</td>
                                <td class="vel2-save-val-cell">{$savingText}&nbsp;{$currencySymbol}</td>
                                <td class="vel2-save-suffix-cell">oproti běžné ceně</td>
                            </tr>
                        </table>
                    </div>
                </td>

                <td class="vel2-price-divider"></td>

                <td class="vel2-price-right">
                    <div class="vel2-our-row">
                        <span class="vel2-our-label">Naše<br>cena</span>
                        <div class="vel2-main-price-box">
                            <span class="vel2-price-major">{$finalPriceMajor}</span>
                            <div class="vel2-price-minor-col">
                                <div class="vel2-price-minor">{$finalPriceMinor}</div>
                                <div class="vel2-price-currency">{$currencySymbol} / 1 ks</div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <div n:if="$unit" class="vel2-unit-price">
            cena za {$unit->unitWeight}{$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}
        </div>

        <table class="vel2-bottom-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel2-barcode-cell">
                    <div n:if="$bars" class="vel2-barcode-bars">
                        <div n:foreach="$bars as $bar" style="height:100%;background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
                    </div>
                    <div class="vel2-barcode-ean">EAN: {$eanText}</div>
                </td>
                <td class="vel2-note3-cell">
                    <div n:if="$note3 || $note2">{$note3 ?: $note2}</div>
                </td>
                <td class="vel2-bottom-spacer"></td>
            </tr>
        </table>
    </div>
</div>
