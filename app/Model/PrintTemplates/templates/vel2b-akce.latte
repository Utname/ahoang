<style>
    @page { margin: 0; }
    html, body { margin: 0; padding: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; background: #fff; color: #111; -webkit-font-smoothing: antialiased; }
    * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    .fikko-vel2b-akce {
        box-sizing: border-box;
        position: relative;
        width: 133mm;
        height: 52mm;
        border: 0.4mm dashed #111;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }

    /* Left logo / brand column (24mm x 52mm) */
    .vel2b-logo-col {
        position: absolute;
        top: 0;
        left: 0;
        width: 24mm;
        height: 52mm;
        border-right: 0.4mm dashed #111;
        text-align: center;
        padding: 1.5mm 1mm;
    }
    .vel2b-logo-img {
        width: 14mm;
        height: 11mm;
        object-fit: contain;
        display: block;
        margin: 0 auto;
        filter: grayscale(1) contrast(1.15);
    }
    .vel2b-logo-divider {
        width: 21mm;
        margin: 1.5mm auto;
        border-top: 0.3mm dashed #111;
    }
    .vel2b-brand-text {
        margin-top: 10mm;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 6mm;
        line-height: 1.05;
        color: #111;
    }

    /* Right main content column (109mm x 52mm) */
    .vel2b-content-col {
        position: absolute;
        top: 0;
        left: 28.5mm;
        width: 102.5mm;
        height: 52mm;
        padding: 0.8mm 2mm 0.6mm 2mm;
    }

    /* 1. Product Name */
    .vel2b-prod-name {
        text-align: center;
        font-size: 3.2mm;
        font-weight: 400;
        line-height: 1.1;
        padding-top: 0.6mm;
        height: 4mm;
        overflow: hidden;
        white-space: nowrap;
    }

    /* 2. Meta row */
    .vel2b-meta-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0.5mm;
    }
    .vel2b-meta-left {
        width: 50mm;
        vertical-align: middle;
        text-align: left;
    }
    .vel2b-meta-center {
        vertical-align: middle;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.6mm;
        line-height: 1.1;
        white-space: nowrap;
    }
    .vel2b-meta-right {
        width: 8mm;
    }

    .vel2b-more-species {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.6mm;
        line-height: 1.1;
        margin-bottom: 0.4mm;
    }
    .vel2b-origin-row {
        display: table;
        white-space: nowrap;
    }
    .vel2b-origin-label-cell {
        display: table-cell;
        vertical-align: middle;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.2mm;
        padding-right: 1mm;
    }
    .vel2b-origin-flag-cell {
        display: table-cell;
        vertical-align: middle;
        width: 6.5mm;
    }
    .vel2b-origin-flag-img {
        width: 5.5mm;
        height: 5.5mm;
        display: block;
        border: 0.2mm solid #111;
        border-radius: 50%;
    }
    .vel2b-origin-name-cell {
        display: table-cell;
        vertical-align: middle;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.2mm;
        padding-left: 1mm;
    }

    /* 3. Main Price & Discount Table */
    .vel2b-price-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0.8mm;
    }
    .vel2b-price-left {
        width: 48mm;
        vertical-align: middle;
        text-align: right;
        padding-right: 2.5mm;
    }
    .vel2b-price-divider {
        width: 0.3mm;
        background: #111;
        padding: 0;
    }
    .vel2b-price-right {
        vertical-align: middle;
        text-align: left;
        padding-left: 2.5mm;
    }

    /* Nejnižší cena za 30 dní */
    .vel2b-lowest-row {
        white-space: nowrap;
        text-align: right;
    }
    .vel2b-lowest-label {
        display: inline-block;
        vertical-align: middle;
        font-size: 2.2mm;
        line-height: 1.2;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 700;
        color: #111;
        text-align: right;
        margin-right: 1.5mm;
    }
    .vel2b-lowest-val-box {
        position: relative;
        display: inline-block;
        vertical-align: middle;
    }
    .vel2b-lowest-val {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 5.5mm;
        line-height: 1;
        color: #111;
    }
    .vel2b-strike-wrap {
        position: absolute;
        left: 0;
        top: 0;
        width: 0;
        height: 0;
        overflow: visible;
        display: inline-block;
    }
    .vel2b-strike-img {
        position: absolute;
        left: -1.5mm;
        top: 0.8mm;
        height: 4.5mm;
    }

    /* Ušetříte brush badge */
    .vel2b-save-box {
        position: relative;
        width: 42mm;
        height: 5.5mm;
        margin-top: 1.5mm;
        margin-left: auto;
        transform: rotate(-1.2deg);
        color: #fff;
    }
    .vel2b-save-brush {
        position: absolute;
        top: 0;
        left: 0;
        width: 42mm;
        height: 5.5mm;
        z-index: 0;
    }
    .vel2b-save-table {
        position: relative;
        z-index: 1;
        width: 42mm;
        height: 5.5mm;
        border-collapse: collapse;
        margin: 0 auto;
    }
    .vel2b-save-copy-cell {
        vertical-align: middle;
        text-align: right;
        font-size: 2.4mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        white-space: nowrap;
        padding-left: 2mm;
        padding-bottom: 0.3mm;
    }
    .vel2b-save-val-cell {
        vertical-align: middle;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 4.6mm;
        line-height: 1;
        white-space: nowrap;
        padding: 0 1.2mm;
        padding-bottom: 0.3mm;
    }

    /* Naše cena */
    .vel2b-our-label {
        font-size: 2.2mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 0.4mm;
        margin-left: 3mm;
    }
    .vel2b-main-price-box {
        white-space: nowrap;
    }
    .vel2b-price-major {
        display: inline-block;
        vertical-align: top;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 21mm;
        line-height: 0.85;
    }
    .vel2b-price-minor-col {
        display: inline-block;
        vertical-align: top;
        text-align: left;
        padding-top: 0.2mm;
        margin-left: 0.8mm;
    }
    .vel2b-price-minor {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 10mm;
        line-height: 0.9;
    }
    .vel2b-price-currency {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 3.6mm;
        line-height: 0.9;
        white-space: nowrap;
        margin-top: 0.4mm;
    }

    /* 4. Unit price row */
    .vel2b-unit-price {
        text-align: right;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.2mm;
        white-space: nowrap;
        padding-right: 1mm;
        line-height: 1.1;
        margin-top: 0.2mm;
        margin-bottom: 0.2mm;
    }

    /* 5. Bottom row (Barcode, Note 3) */
    .vel2b-bottom-table {
        width: 100%;
        border-collapse: collapse;
    }
    .vel2b-barcode-cell {
        width: 48mm;
        vertical-align: bottom;
        text-align: left;
    }
    .vel2b-barcode-bars {
        height: 5.5mm;
        white-space: nowrap;
        margin-bottom: 0.2mm;
    }
    .vel2b-barcode-bars > div {
        float: left;
        height: 100%;
    }
    .vel2b-barcode-ean {
        font-size: 2.2mm;
        font-weight: 600;
        white-space: nowrap;
        letter-spacing: 0.04em;
        line-height: 1;
        clear: both;
    }
    .vel2b-note3-cell {
        vertical-align: bottom;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.6mm;
        line-height: 1.15;
        max-height: 5.5mm;
        overflow: hidden;
    }
    .vel2b-bottom-spacer {
        width: 10mm;
    }

    /* 3-digit price scaling */
    .price-digits-3 .vel2b-price-major { font-size: 16mm; }
    .price-digits-3 .vel2b-price-minor { font-size: 7.5mm; }
    .price-digits-3 .vel2b-price-currency { font-size: 3.1mm; margin-top: 0.2mm; }
    .price-digits-3 .vel2b-lowest-val { font-size: 4.8mm; }
    .price-digits-3 .vel2b-price-left { width: 44mm; }
</style>

{var $vel2bClasses = ($priceDigits >= 3 ? 'price-digits-3' : '')}
{var $logoMarkup = '<img class="vel2b-logo-img" src="' . $logoDataUri . '" alt="Fikko market">'}
{var $flagMarkup = $flagIconDataUri ? '<img class="vel2b-origin-flag-img" src="' . $flagIconDataUri . '" alt="">' : ''}
{var $brushMarkup = '<img class="vel2b-save-brush" src="' . $brushDataUri . '" alt="">'}
{var $strikeMarkup = '<img class="vel2b-strike-img" src="' . $strikeSlashDataUri . '" alt="">'}

<div class="fikko-vel2b-akce {$vel2bClasses}">
    <div class="vel2b-logo-col">
        {$logoMarkup|noescape}
        <div class="vel2b-logo-divider"></div>
        <div class="vel2b-brand-text">
            <div>Fikko</div>
            <div>Cena</div>
        </div>
    </div>

    <div class="vel2b-content-col">
        <div class="vel2b-prod-name">{$labelName}</div>

        <table class="vel2b-meta-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel2b-meta-left">
                    <div n:if="$label && $label->is_more_species" class="vel2b-more-species">Více druhů</div>
                    <div n:if="$country" class="vel2b-origin-row">
                        <span class="vel2b-origin-label-cell">Země původu:</span>
                        <span class="vel2b-origin-flag-cell">{$flagMarkup|noescape}</span>
                        <span class="vel2b-origin-name-cell">{$country->name}</span>
                    </div>
                </td>
                <td class="vel2b-meta-center">
                    <div n:if="$note1">{$note1}</div>
                </td>
                <td class="vel2b-meta-right"></td>
            </tr>
        </table>

        <table class="vel2b-price-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel2b-price-left">
                    <div n:if="$isDiscounted && $basePrice > $finalPrice" class="vel2b-lowest-row">
                        <span class="vel2b-lowest-label">Nejnižší cena<br>za 30 dní</span>
                        <div class="vel2b-lowest-val-box">
                            <span class="vel2b-lowest-val">{$basePriceText} {$currencySymbol}</span>
                            <span class="vel2b-strike-wrap">{$strikeMarkup|noescape}</span>
                        </div>
                    </div>
                    <div n:if="$isDiscounted && $saving > 0" class="vel2b-save-box">
                        {$brushMarkup|noescape}
                        <table class="vel2b-save-table" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td class="vel2b-save-copy-cell">UŠETŘÍTE</td>
                                <td class="vel2b-save-val-cell">{$savingText}&nbsp;{$currencySymbol}</td>
                            </tr>
                        </table>
                    </div>
                </td>

                <td class="vel2b-price-divider"></td>

                <td class="vel2b-price-right">
                    <div class="vel2b-our-label">Naše cena</div>
                    <div class="vel2b-main-price-box">
                        <span class="vel2b-price-major">{$finalPriceMajor}</span>
                        <div class="vel2b-price-minor-col">
                            <div class="vel2b-price-minor">{$finalPriceMinor}</div>
                            <div class="vel2b-price-currency">{$currencySymbol} / 1 ks</div>
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <div n:if="$unit" class="vel2b-unit-price">
            cena za {$unit->unitWeight}{$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}
        </div>

        <table class="vel2b-bottom-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel2b-barcode-cell">
                    <div n:if="$bars" class="vel2b-barcode-bars">
                        <div n:foreach="$bars as $bar" style="height:100%;background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
                    </div>
                    <div class="vel2b-barcode-ean">EAN: {$eanText}</div>
                </td>
                <td class="vel2b-note3-cell">
                    <div n:if="$note3 || $note2">{$note3 ?: $note2}</div>
                </td>
                <td class="vel2b-bottom-spacer"></td>
            </tr>
        </table>
    </div>
</div>
