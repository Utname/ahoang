<style>
    /* Vel.2B label, 133 x 52mm. Measured against "vel. 2B Akce.dc.html" printed
       from Chromium; numbers are mm from the card's inner (inside-border) corner.
       - Dompdf ignores box-sizing and draws the 0.4mm border outside
         width/height, so the box is 132.2 x 51.2 to come out 133 x 52.
       - No flexbox/grid in Dompdf: blocks are absolutely positioned.
       - Single-line text uses line-height 0, where Dompdf puts the baseline
         exactly at the block's top, so each top below is a reference baseline.
       - The reference row is space-between: the 30-day / Ušetříte column is
         centred under itself at the left, "Naše cena" is flush right. Only the
         30-day design exists for this size; a plain comparison reuses it with
         "Běžná cena" and no strike, a plain price keeps "Naše cena" flush right. */
    .fikko-vel2b-akce {
        position: relative;
        width: 132.2mm;
        height: 51.2mm;
        border: 0.4mm dashed #111;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    .abs { position: absolute; white-space: nowrap; }
    .lh0 { line-height: 0; }
    .nu { font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; }
    .center { text-align: center; }
    .right { text-align: right; }
    .rel { position: relative; }

    .logo-col { position: absolute; left: 0; top: 0; width: 23.6mm; height: 51.2mm; border-right: 0.4mm dashed #111; }
    .logo { position: absolute; left: 6.77mm; top: 2.31mm; width: 10.55mm; height: 9.72mm; }
    .logo-divider { position: absolute; left: 1.5mm; top: 14.1mm; width: 20.6mm; border-top: 0.3mm dashed #111; }
    .brand { left: 0; width: 23.6mm; font-size: 6mm; }

    .name { left: 26mm; width: 104.2mm; top: 3.95mm; font-size: 3.2mm; font-weight: 400; }
    .note1 { left: 28.1mm; width: 100mm; top: 7.39mm; font-size: 2.6mm; }
    .species { left: 25.9mm; top: 7.39mm; font-size: 2.6mm; }
    .origin { font-size: 2.2mm; }
    .flag { position: absolute; left: 41.62mm; width: 7.5mm; height: 7.5mm; border: 0.2mm solid #111; border-radius: 50%; }

    .base-label { font-size: 2.2mm; letter-spacing: 0.04em; text-transform: uppercase; font-weight: 700; }
    .base-val { font-size: 5.5mm; }
    .strike { position: absolute; left: -4%; width: 108%; top: -1.94mm; height: 0.6mm; background: #111; border-radius: 0.3mm; transform: rotate(-5.5deg); }

    .save { position: absolute; top: 26.56mm; height: 6.9mm; transform: rotate(-1.2deg); }
    .save-brush { position: absolute; left: 0; top: 0; height: 6.9mm; }
    .save-text { left: 2.8mm; top: 4.78mm; color: #fff; }
    .save-copy { font-size: 2.4mm; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }
    .save-val { font-size: 4.5mm; margin-left: 1mm; }
    .save-suffix { font-size: 1.8mm; font-weight: 600; margin-left: 1mm; }

    .our-label { font-size: 2.2mm; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }

    .unit { left: 0; width: 130.5mm; top: 39.41mm; font-size: 2.2mm; }
    .bars { position: absolute; left: 25.85mm; top: 41.08mm; height: 6mm; }
    .bars div { float: left; height: 6mm; }
    .ean { left: 25.9mm; top: 49.19mm; font-size: 2.2mm; font-weight: 600; }
    .note3 { left: 0; width: 90.3mm; top: 46.81mm; font-size: 2.6mm; }
</style>

{var $compare = $basePrice > $finalPrice}
{var $akce = $compare && $isAkce30}
{var $len = mb_strlen($finalPriceMajor)}
{* "Naše cena" group: integer (23mm, stretched 1.15 tall) + gap 1.2 +
   ",90" / "Kč / 1 ks" column (16.2); shrinks if it would not fit next to
   the comparison column. *}
{var $ps = $compare ? min(1, (55 - 1.2) / ($len * 13.8 + 16.2)) : min(1, (100 - 1.2) / ($len * 13.8 + 16.2))}
{var $fsI = round(23 * $ps, 3)}
{var $fsD = round(11 * $ps, 3)}
{var $fsU = round(3.8 * $ps, 3)}
{* the left column is centred on 46.05 (reference), moving right only when
   a long price would push it past the logo column *}
{var $baseText = ($akce ? $lowestPrice30Text : $basePriceText) . ' ' . $currencySymbol}
{var $rowW = ($akce ? 19.2 : 10.6) + 1.5 + mb_strlen($baseText) * 0.55 * 5.5}
{var $saveValText = $savingText . ' ' . $currencySymbol}
{var $saveW = 2.8 + 14.3 + 1 + mb_strlen($saveValText) * 0.536 * 4.5 + ($akce ? 0 : 1 + 18.2) + 2.8}
{var $colC = max(46.05, 25 + max($rowW, $saveW) / 2)}
{var $moreSpecies = $label && $label->is_more_species}
{var $oy = $moreSpecies ? 0 : -3.26}

<div class="fikko-vel2b-akce">
    <div class="logo-col">
        <img class="logo" src="{$logoDataUri|nocheck}" alt="Fikko market">
        <div class="logo-divider"></div>
        <div class="abs lh0 nu center brand" style="top:30.67mm">Fikko</div>
        <div class="abs lh0 nu center brand" style="top:36.76mm">Cena</div>
    </div>

    <div class="abs lh0 center name">{$labelName|truncate:60}</div>

    <div n:if="$note1" class="abs lh0 nu center note1">{$note1}</div>
    <div n:if="$moreSpecies" class="abs lh0 nu species">Více druhů</div>
    {if $country}
        <div class="abs lh0 nu origin" style="left:25.9mm;top:{=round(13.21 + $oy, 3)|noescape}mm">Země původu:</div>
        <img n:if="$flagIconDataUri" class="flag" style="top:{=round(8.9 + $oy, 3)|noescape}mm" src="{$flagIconDataUri|nocheck}" alt="">
        <div class="abs lh0 nu origin" style="left:50.7mm;top:{=round(13.21 + $oy, 3)|noescape}mm">{$country->name}</div>
    {/if}

    {if $compare}
        <div class="abs" style="left:{=round($colC - 50, 3)|noescape}mm;width:100mm;top:20.62mm">
            <table style="margin:0 auto;border-collapse:collapse" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="padding:0 1.5mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                        {if $akce}
                            <div class="lh0 base-label">Nejnižší cena</div>
                            <div class="lh0 base-label rel" style="top:2.38mm">za 30 dní</div>
                        {else}
                            <div class="lh0 base-label">Běžná</div>
                            <div class="lh0 base-label rel" style="top:2.38mm">cena</div>
                        {/if}
                    </td>
                    <td style="padding:0;vertical-align:top;white-space:nowrap">
                        <div class="lh0 nu base-val rel" style="top:2.38mm">{$baseText}<div n:if="$akce" class="strike"></div></div>
                    </td>
                </tr>
            </table>
        </div>

        <div n:if="$saving > 0" class="save" style="left:{=round($colC - $saveW / 2, 3)|noescape}mm;width:{=round($saveW, 3)|noescape}mm">
            <img class="save-brush" src="{$brushDataUri|nocheck}" style="width:{=round($saveW, 3)|noescape}mm" alt="">
            <div class="abs lh0 save-text"><span class="save-copy">Ušetříte</span><span class="nu save-val">{$saveValText}</span><span n:if="!$akce" class="save-suffix">oproti běžné ceně</span></div>
        </div>
    {/if}

    <table class="abs" style="left:0;width:127.3mm;top:13.74mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
        <tr>
            <td></td>
            <td style="width:1%;padding:0;vertical-align:top;white-space:nowrap">
                <div class="lh0 our-label rel" style="left:8mm">Naše cena</div>
                <div class="lh0 nu" style="font-size:{$fsI|noescape}mm;position:relative;top:21.37mm;transform:scaleY(1.15);transform-origin:0 0">{$finalPriceMajor}</div>
            </td>
            <td style="width:1%;padding:0 0 0 1.2mm;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsD|noescape}mm;position:relative;top:{=round(21.37 - 9.73 * $ps, 3)|noescape}mm">{$finalPriceMinor}</div>
                <div class="lh0 nu" style="font-size:{$fsU|noescape}mm;position:relative;top:{=round(21.37 - 4.97 * $ps, 3)|noescape}mm">{$currencySymbol} / 1 ks</div>
            </td>
        </tr>
    </table>

    <div n:if="$unit" class="abs lh0 nu right unit">cena za {$unit->unitWeight}{$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}</div>

    <div n:if="$bars" class="bars">
        <div n:foreach="$bars as $bar" style="background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
    </div>
    <div class="abs lh0 ean">EAN: {$eanText}</div>
    <div n:if="$note3 || $note2" class="abs lh0 nu right note3">{$note3 ?: $note2}</div>
</div>
