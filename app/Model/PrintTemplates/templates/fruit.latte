<style>
    @page { size: 50mm 35mm; margin: 0; }
    html, body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: #111111;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    * { box-sizing: border-box; }

    .fikko-fruit {
        position: relative;
        width: 50mm;
        height: 35mm;
        padding: 1.6mm 2mm;
        background: #ffffff;
        color: #111111;
        overflow: hidden;
        page-break-after: always;
    }

    .fikko-fruit .product-title {
        position: absolute;
        top: 1.6mm;
        left: 2mm;
        width: 46mm;
        font-size: 2.8mm;
        font-weight: 800;
        line-height: 1.1;
        word-wrap: break-word;
        word-break: break-word;
    }

    .fikko-fruit .title-divider {
        position: absolute;
        top: 5.6mm;
        left: 2mm;
        width: 46mm;
        border-top: 0.25mm solid #111111;
    }

    /* Middle section: Weight / Price per kg (Left) vs Price (Right) */
    .fikko-fruit .weight-col {
        position: absolute;
        top: 6.6mm;
        left: 2mm;
        width: 25mm;
    }

    .fikko-fruit .meta-label {
        font-size: 1.5mm;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 700;
        line-height: 1.1;
    }

    .fikko-fruit .meta-val {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.9mm;
        line-height: 1.05;
        margin-top: 0.2mm;
    }

    .fikko-fruit .meta-item-spacing {
        margin-top: 0.6mm;
    }

    .fikko-fruit .price-col {
        position: absolute;
        top: 6.6mm;
        right: 2mm;
        width: 21mm;
        text-align: right;
    }

    .fikko-fruit .price-header-label {
        font-size: 1.6mm;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        text-align: right;
        margin-bottom: 0.6mm;
        line-height: 1;
    }

    .fikko-fruit .price-wrap {
        display: inline-block;
        white-space: nowrap;
        text-align: right;
    }

    .fikko-fruit .price-major {
        display: inline-block;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 8mm;
        line-height: 0.85;
        letter-spacing: -0.02em;
        vertical-align: top;
    }

    .fikko-fruit .price-side {
        display: inline-block;
        vertical-align: top;
        text-align: left;
        margin-left: 0.4mm;
    }

    .fikko-fruit .price-minor {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 3.6mm;
        line-height: 0.9;
    }

    .fikko-fruit .price-currency {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 2.4mm;
        line-height: 0.9;
        margin-top: 0.3mm;
    }

    /* Bottom section: Details (Left) vs Barcode (Right) */
    .fikko-fruit .details-col {
        position: absolute;
        bottom: 3.8mm;
        left: 2mm;
        width: 25.5mm;
        font-size: 1.6mm;
        line-height: 1.2;
    }

    .fikko-fruit .details-col div {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .fikko-fruit .barcode-col {
        position: absolute;
        bottom: 3.8mm;
        right: 2mm;
        width: 20mm;
        text-align: center;
    }

    .fikko-fruit .barcode-bars {
        position: relative;
        width: 19mm;
        height: 4.5mm;
        margin: 0 auto;
        overflow: hidden;
    }

    .fikko-fruit .barcode-ean {
        font-size: 1.4mm;
        letter-spacing: 0.06em;
        text-align: center;
        margin-top: 0.2mm;
        line-height: 1.1;
    }

    .fikko-fruit .footer-text {
        position: absolute;
        bottom: 1.4mm;
        left: 2mm;
        width: 46mm;
        font-size: 1.4mm;
        line-height: 1.1;
        opacity: 0.85;
    }
</style>

{var $packedDate = $label?->datetime_printed ? $label->datetime_printed->format('d.m.Y') : date('d.m.Y')}
{var $expiryDate = $validityText ?: date('d.m.Y', strtotime('+2 days'))}
{var $countryName = $country ? $country->name : ($product->getCountry()?->name ?: 'Thajsko')}
{var $weightVal = $note1 ?: ($unit ? $unit->unitWeight . ' ' . $unit->unitShort : '0,486 kg')}
{var $unitPriceVal = $unitText ?: ($unit ? ($unit->price|number:2,',','') . ' ' . $currencySymbol : '129,90 Kč')}
{var $storageVal = $note2 ?: '2–6 °C'}
{var $storageText = str_starts_with($storageVal, 'Skladujte') ? $storageVal : ('Skladujte při ' . $storageVal)}
{* last line (handoff 19.10.2026): company · branch, address of the branch printing it (Nastavení → Pobočky),
   no "Balí"; Poznámka 3 replaces it. Two lines at most, smaller when longer. *}
{var $packerText = $note3 ?: $branchLine}
{var $packerFs = max(1.1, min(1.4, 2 * 46 / (max(1, mb_strlen($packerText)) * 0.55)))}
{var $finalPriceMinorFormatted = str_starts_with($finalPriceMinor, ',') ? $finalPriceMinor : (',' . $finalPriceMinor)}

<section class="fikko-fruit">
    <div class="product-title">{$labelName}</div>
    <div class="title-divider"></div>

    <div class="weight-col">
        <div>
            <div class="meta-label">Hmotnost</div>
            <div class="meta-val">{$weightVal}</div>
        </div>
        <div class="meta-item-spacing">
            <div class="meta-label">Cena za 1 kg</div>
            <div class="meta-val">{$unitPriceVal}</div>
        </div>
    </div>

    <div class="price-col">
        <div class="price-header-label">Cena</div>
        <div class="price-wrap">
            <div class="price-major">{$finalPriceMajor}</div>
            <div class="price-side">
                <div class="price-minor">{$finalPriceMinorFormatted}</div>
                <div class="price-currency">{$currencySymbol}</div>
            </div>
        </div>
    </div>

    <div class="details-col">
        <div>Baleno dne: <b>{$packedDate}</b></div>
        <div>Spotřebujte do: <b>{$expiryDate}</b></div>
        <div>{$storageText}</div>
        <div>Země původu: <b>{$countryName}</b></div>
    </div>

    <div class="barcode-col">
        <div n:if="$bars" class="barcode-bars">
            <div n:foreach="$bars as $bar" n:if="$bar['dark']" style="position:absolute;top:0;height:4.5mm;left:{$bar['left']|noescape};background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
        </div>
        <div class="barcode-ean">{$eanText ?: '2810001063137'}</div>
    </div>

    <div class="footer-text" style="font-size:{=round($packerFs, 3)|noescape}mm">{$packerText}</div>
</section>
