<style>
    /* Vel.1 label, 164 x 41mm. Measured against "vel. 1.dc.html" (handoff 19.10.2026)
       printed from Chromium; numbers are mm from the card's inner (inside-border) corner.
       The name / origin / notes rows and the bottom row are the ones of vel2.latte.
       - Dompdf ignores box-sizing and draws the 0.4mm border outside
         width/height, so the box is 163.2 x 40.2 to come out 164 x 41.
       - No flexbox/grid in Dompdf: blocks are absolutely positioned.
       - Single-line text uses line-height 0, where Dompdf puts the baseline
         exactly at the block's top, so each top below is a reference baseline.
       - The reference price row is a 1fr | divider | 1fr grid around the
         content centre, so both price groups are anchored on the divider:
         the comparison group right-aligned 5mm left of it, "Naše cena" 5mm
         right of it. */
    .fikko-vel1 {
        position: relative;
        width: 163.2mm;
        height: 40.2mm;
        border: 0.4mm dashed #111;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    .abs { position: absolute; white-space: nowrap; }
    .lh0 { line-height: 0; }
    .nu { font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; }
    .nu4 { font-family: Nunito, sans-serif; font-weight: 400; font-style: italic; }
    .sri { font-family: Sriracha, cursive; font-weight: bold; font-style: normal; }
    .center { text-align: center; }
    .right { text-align: right; }
    .rel { position: relative; }

    .logo-col { position: absolute; left: 0; top: 0; width: 23.6mm; height: 40.2mm; border-right: 0.4mm dashed #111; }
    .logo { position: absolute; left: 6.77mm; top: 2.31mm; width: 10.55mm; height: 9.72mm; }
    .logo-divider { position: absolute; left: 1.5mm; top: 14.1mm; width: 20.6mm; border-top: 0.3mm dashed #111; }
    .brand { left: 0; width: 23.6mm; font-size: 5.8mm; }

    .name { left: 27mm; width: 133.2mm; top: 5.02mm; font-weight: bold; }
    .flag { position: absolute; left: 26.8mm; top: 6.72mm; width: 4.5mm; height: 4.5mm; border: 0.25mm solid #111; border-radius: 50%; }
    .origin-label { left: 33.11mm; top: 8.15mm; font-size: 1.6mm; letter-spacing: 0.08em; text-transform: uppercase; font-weight: bold; }
    .origin-name { left: 33.11mm; top: 10.71mm; font-size: 2.4mm; font-weight: bold; }
    .meta { top: 9.92mm; font-size: 3.2mm; }

    .base-label { font-size: 2.2mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }
    .base-val { font-size: 6.5mm; }
    .base-cur { font-size: 4mm; }

    .save { position: absolute; top: 22.27mm; height: 6.9mm; transform: rotate(-1.2deg); }
    .save-brush { position: absolute; left: 0; top: 0; height: 6.9mm; }
    .save-text { left: 3mm; top: 5.0mm; color: #fff; }
    .save-copy { font-size: 2.3mm; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }
    .save-val { font-size: 4.5mm; margin-left: 1mm; }
    .save-suffix { font-size: 2mm; font-weight: 600; margin-left: 1mm; }

    .divider { position: absolute; left: 93.48mm; top: 12.5mm; width: 0.3mm; height: 18.5mm; background: #111; }

    .our-label { font-size: 2.2mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }
    .price-table { border-collapse: collapse; }
    .price-table td { padding: 0; vertical-align: top; white-space: nowrap; }

    .unit { left: 0; width: 160.3mm; top: 32.53mm; font-size: 2.7mm; }
    .bars { position: absolute; left: 26.63mm; top: 33.93mm; height: 3.5mm; }
    .bars div { height: 3.5mm; }
    .ean { left: 26.9mm; top: 39.14mm; font-size: 2mm; font-weight: 600; letter-spacing: 0.04em; }
    .note3 { left: 43.6mm; width: 100mm; font-size: 2.9mm; }
</style>

{var $compare = $basePrice > $finalPrice}
{var $digits = strlen(str_replace(' ', '', $finalPriceMajor))}
{* unit column: ",90" or the chosen "Cena za" text (0.453em per character), whichever is wider *}
{var $unitTxt = $priceUnitText ?: $currencySymbol . ' / 1 ks'}
{var $unitColW = max(14.8, mb_strlen($unitTxt) * 0.453 * 3.6)}
{* integer width in em: 0.58 per digit, 0.37 for the thousands space ("1 299") *}
{var $intEm = $digits * 0.58 + substr_count($finalPriceMajor, ' ') * 0.37}
{var $ps = min($digits >= 4 ? 0.78 : 1, (($compare ? 160 - 98.7 : 130) - 8.3 - 1) / ($intEm * 21 + $unitColW))}
{var $fsI = round(21 * $ps, 3)}
{var $fsD = round(9.5 * $ps, 3)}
{var $fsU = round(3.6 * $ps, 3)}
{* "Naše cena" group starts 5mm right of the divider (reference grid); with
   no comparison there is no divider, so the group is centred on the content
   area instead (its width estimated from the Dompdf font metrics). *}
{var $groupW = 8.3 + $intEm * $fsI + 1 + $unitColW * $ps}
{var $ourL = $compare ? 98.7 : 93.6 - $groupW / 2}
{var $saveValText = $savingText . ' ' . $currencySymbol}
{var $saveW = 3 + 15.2 + 1 + mb_strlen($saveValText) * 0.536 * 4.5 + 1 + 20.2 + 3}
{var $moreSpecies = $label && $label->is_more_species}
{* product name: bold 3.9mm on one line, smaller for a long name (DejaVu Bold ~0.66em per character) *}
{var $nameLen = max(1, mb_strlen($labelName))}
{var $nameFs = max(2.8, min(3.9, 132.5 / ($nameLen * 0.66)))}
{* origin, then "Více druhů" 2.5mm after it; Poznámka 1 centred, pushed right when the left part is wide *}
{var $originW = $country ? max(14.6, mb_strlen((string)$country->name) * 0.621 * 2.4) : 0}
{var $speciesL = $country ? 33.11 + $originW + 3.7 : 26.8}
{var $metaEnd = $moreSpecies ? $speciesL + 15.8 : ($country ? 33.11 + $originW : 26.6)}
{var $n1W = $note1 ? mb_strlen((string)$note1) * 0.54 * 3.2 : 0}
{var $n1L = max($metaEnd + 3, 93.55 - $n1W / 2)}
{var $n1Fs = $n1W && $n1L + $n1W > 160 ? max(2.2, 3.2 * (160 - $n1L) / $n1W) : 3.2}
{var $n1C = $n1L + $n1W * $n1Fs / 3.2 / 2}
{* Poznámka 3: centred, at most two balanced lines *}
{var $n3 = trim((string)($note3 ?: $note2))}
{var $n3Lines = $n3 === '' ? [] : (mb_strlen($n3) * 0.54 * 2.9 <= 80 ? [$n3] : (explode("\n", wordwrap($n3, (int)max(12, ceil(mb_strlen($n3) / 2) + 3), "\n", TRUE))))}
{* a third line joins the second one *}
{if count($n3Lines) > 2}{var $n3Lines = [$n3Lines[0], implode(' ', array_slice($n3Lines, 1))]}{/if}

<div class="fikko-vel1">
    <div class="logo-col">
        <img class="logo" src="{$logoDataUri|nocheck}" alt="Fikko market">
        <div class="logo-divider"></div>
        {* label header word by word ("Fikko / Cena"), top-aligned like the reference, shrunk to the 21.5mm column *}
        {var $bFs = min(5.8, 21.5 / ($headerWordMax * 0.68))}
        <div n:foreach="$headerWords as $i => $word" class="abs lh0 nu center brand" style="font-size:{=round($bFs, 3)|noescape}mm;top:{=round(20.36 + $i * 6.08 * $bFs / 5.8, 3)|noescape}mm">{$word}</div>
    </div>

    <div class="abs lh0 center name" style="font-size:{=round($nameFs, 3)|noescape}mm">{$labelName|truncate:(int)floor(132.5 / ($nameFs * 0.66))}</div>

    {if $country}
        <img n:if="$flagIconDataUri" class="flag" src="{$flagIconDataUri|nocheck}" alt="">
        <div class="abs lh0 origin-label">Země původu</div>
        <div class="abs lh0 origin-name">{$country->name}</div>
    {/if}
    <div n:if="$moreSpecies" class="abs lh0 sri meta" style="left:{=round($speciesL, 3)|noescape}mm">Více druhů</div>
    <div n:if="$note1" class="abs lh0 sri center meta" style="left:{=round($n1C - 50, 3)|noescape}mm;width:100mm;font-size:{=round($n1Fs, 3)|noescape}mm">{$note1}</div>

    {* Vel.1's reference only has the plain "Běžná cena" comparison (no 30-day
       box, %, or strike): this size always renders a discount as a comparison
       (earlier user decision). *}
    {if $compare}
        <table class="abs" style="left:0;width:88.5mm;top:16.39mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
            <tr>
                <td></td>
                <td style="width:1%;padding:0 1.5mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                    <div class="lh0 base-label">Běžná</div>
                    <div class="lh0 base-label rel" style="top:2.64mm">cena</div>
                </td>
                <td style="width:1%;padding:0;vertical-align:top;white-space:nowrap">
                    <div class="lh0 nu base-val rel" style="top:2.91mm">{$basePriceText}&nbsp;<span class="base-cur">{$currencySymbol}</span></div>
                </td>
            </tr>
        </table>

        <div n:if="$saving > 0" class="save" style="left:{=round(88.6 - $saveW, 3)|noescape}mm;width:{=round($saveW, 3)|noescape}mm">
            <img class="save-brush" src="{$brushDataUri|nocheck}" style="width:{=round($saveW, 3)|noescape}mm" alt="">
            <div class="abs lh0 save-text"><span class="save-copy">Ušetříte</span><span class="nu save-val">{$saveValText}</span><span class="save-suffix">oproti běžné ceně</span></div>
        </div>

        <div class="divider"></div>
    {/if}

    <table class="abs" style="left:{=round($ourL, 3)|noescape}mm;top:20.62mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
        <tr>
            <td style="padding:0 1.5mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                <div class="lh0 our-label">Naše</div>
                <div class="lh0 our-label rel" style="top:2.65mm">cena</div>
            </td>
            <td style="padding:0;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsI|noescape}mm;position:relative;top:{=round(7.41 * $ps, 3)|noescape}mm">{$finalPriceMajor}</div>
            </td>
            <td style="padding:0 0 0 1mm;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsD|noescape}mm;position:relative;top:{=round(-0.53 * $ps, 3)|noescape}mm">{$finalPriceMinor}</div>
                <div class="lh0 nu" style="font-size:{$fsU|noescape}mm;position:relative;top:{=round(4.5 * $ps, 3)|noescape}mm">{$unitTxt}</div>
            </td>
        </tr>
    </table>

    <div n:if="$unit" class="abs lh0 nu4 right unit">cena za {$unit->unitWeight} {$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}</div>

    <div n:if="$bars" class="bars">
        <div n:foreach="$bars as $bar" n:if="$bar['dark']" style="position:absolute;top:0;left:{$bar['left']|noescape};background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
    </div>
    <div class="abs lh0 ean">EAN: {$eanText}</div>
    <div n:foreach="$n3Lines as $i => $line" class="abs lh0 sri center note3" style="top:{=round(38.65 - (count($n3Lines) - 1 - $i) * 3.34, 3)|noescape}mm">{$line}</div>
</div>
