<style>
    @page { margin: 0; }
    html, body { margin: 0; padding: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; background: #fff; color: #111; -webkit-font-smoothing: antialiased; }
    * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    .fikko-vel1 {
        box-sizing: border-box;
        position: relative;
        width: 164mm;
        height: 41mm;
        border: 0.4mm dashed #111;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }

    /* Left logo / brand column (24mm x 41mm) */
    .vel1-logo-col {
        position: absolute;
        top: 0;
        left: 0;
        width: 24mm;
        height: 41mm;
        border-right: 0.4mm dashed #111;
        text-align: center;
        padding: 1.2mm 1mm;
    }
    .vel1-logo-img {
        width: 14mm;
        height: 11mm;
        object-fit: contain;
        display: block;
        margin: 0 auto;
        filter: grayscale(1) contrast(1.15);
    }
    .vel1-logo-divider {
        width: 21mm;
        margin: 1.2mm auto 1.2mm auto;
        border-top: 0.3mm dashed #111;
    }
    .vel1-brand-text {
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 5.8mm;
        line-height: 1.05;
        color: #111;
    }

    /* Right main content column (140mm x 41mm) */
    .vel1-content-col {
        position: absolute;
        top: 0;
        left: 27.5mm;
        width: 134mm;
        height: 41mm;
        padding: 0.8mm 1mm 0.6mm 1mm;
    }

    /* 1. Product Name */
    .vel1-prod-name {
        text-align: center;
        font-size: 3.3mm;
        font-weight: 400;
        line-height: 1.05;
        overflow: hidden;
        white-space: nowrap;
        height: 3.5mm;
    }

    /* 2. Meta row (Origin, Note1, More species) */
    .vel1-meta-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0;
    }
    .vel1-meta-left {
        width: 50mm;
        vertical-align: middle;
        text-align: left;
    }
    .vel1-meta-center {
        vertical-align: middle;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-size: 2.3mm;
        font-weight: 400;
        line-height: 1;
        white-space: nowrap;
    }
    .vel1-meta-right {
        width: 30mm;
        vertical-align: middle;
        text-align: right;
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-size: 2.3mm;
        font-weight: 400;
        line-height: 1;
        white-space: nowrap;
    }

    /* Origin box inside meta-left */
    .vel1-origin-box {
        display: table;
        white-space: nowrap;
    }
    .vel1-origin-flag-cell {
        display: table-cell;
        width: 6mm;
        vertical-align: middle;
    }
    .vel1-origin-flag-img {
        width: 5mm;
        height: 5mm;
        display: block;
        border: 0.25mm solid #111;
        border-radius: 50%;
    }
    .vel1-origin-text-cell {
        display: table-cell;
        vertical-align: middle;
        padding-left: 1.3mm;
        white-space: nowrap;
    }
    .vel1-origin-label {
        font-size: 1.8mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        color: #111;
        display: block;
        line-height: 1;
    }
    .vel1-origin-name {
        font-size: 2.7mm;
        font-weight: 800;
        line-height: 1.05;
        display: block;
        white-space: nowrap;
    }

    /* 3. Main Price Comparison Section */
    .vel1-price-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0;
    }
    .vel1-price-left {
        width: 58mm;
        vertical-align: middle;
        text-align: right;
        padding-right: 2.5mm;
    }
    .vel1-price-right {
        vertical-align: middle;
        text-align: left;
        padding-left: 2.5mm;
    }

    /* Běžná cena */
    .vel1-base-row {
        white-space: nowrap;
        text-align: right;
    }
    .vel1-base-label {
        display: inline-block;
        vertical-align: middle;
        font-size: 2.1mm;
        line-height: 1.15;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        text-align: right;
        margin-right: 1.5mm;
    }
    .vel1-base-val {
        display: inline-block;
        vertical-align: middle;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 6mm;
        line-height: 1;
    }
    .vel1-base-currency {
        font-size: 3.8mm;
    }

    /* Ušetříte brush badge */
    .vel1-save-box {
        position: relative;
        width: 50mm;
        height: 4.4mm;
        margin-top: 0.2mm;
        margin-left: auto;
        transform: rotate(-1.2deg);
        color: #fff;
    }
    .vel1-save-brush {
        position: absolute;
        top: 0;
        left: 0;
        width: 50mm;
        height: 4.4mm;
        z-index: 0;
    }
    .vel1-save-table {
        position: relative;
        z-index: 1;
        width: 50mm;
        height: 4.4mm;
        border-collapse: collapse;
        margin: 0 auto;
    }
    .vel1-save-copy-cell {
        vertical-align: middle;
        text-align: right;
        font-size: 2mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        white-space: nowrap;
        padding-left: 1.5mm;
    }
    .vel1-save-val-cell {
        vertical-align: middle;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 4mm;
        line-height: 1;
        white-space: nowrap;
        padding: 0 0.8mm;
    }
    .vel1-save-suffix-cell {
        vertical-align: middle;
        text-align: left;
        font-size: 1.8mm;
        font-weight: 600;
        white-space: nowrap;
        padding-right: 1.5mm;
    }

    /* Naše cena */
    .vel1-our-row {
        white-space: nowrap;
    }
    .vel1-our-label {
        display: inline-block;
        vertical-align: middle;
        font-size: 2.1mm;
        line-height: 1.15;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        text-align: right;
        margin-right: 2mm;
    }
    .vel1-main-price-box {
        display: inline-block;
        vertical-align: middle;
        white-space: nowrap;
    }
    .vel1-price-major {
        display: inline-block;
        vertical-align: top;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 18.5mm;
        line-height: 0.82;
    }
    .vel1-price-minor-col {
        display: inline-block;
        vertical-align: top;
        text-align: left;
        padding-top: 0.3mm;
        margin-left: 0.8mm;
    }
    .vel1-price-minor {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 8.5mm;
        line-height: 0.88;
    }
    .vel1-price-currency {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 3.4mm;
        line-height: 0.9;
        white-space: nowrap;
        margin-top: 0.3mm;
    }

    /* 4. Unit price row */
    .vel1-unit-price {
        text-align: right;
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-size: 2.1mm;
        white-space: nowrap;
        padding-right: 1mm;
        line-height: 1;
        margin-top: -0.4mm;
        margin-bottom: 0.1mm;
    }

    /* 5. Bottom row (Barcode, Note 3) */
    .vel1-bottom-box {
        position: absolute;
        left: 28mm;
        right: 2.5mm;
        bottom: 1.8mm;
        width: 133.5mm;
    }
    .vel1-bottom-table {
        width: 100%;
        border-collapse: collapse;
    }
    .vel1-barcode-cell {
        width: 44mm;
        vertical-align: bottom;
        text-align: left;
    }
    .vel1-barcode-bars {
        height: 3.5mm;
        white-space: nowrap;
        margin-bottom: 0.2mm;
    }
    .vel1-barcode-bars > div {
        float: left;
        height: 100%;
    }
    .vel1-barcode-ean {
        font-size: 1.8mm;
        font-weight: 600;
        white-space: nowrap;
        letter-spacing: 0.04em;
        line-height: 1;
        clear: both;
    }
    .vel1-note3-cell {
        vertical-align: bottom;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-style: italic;
        font-size: 2.1mm;
        line-height: 1.15;
        max-height: 4.2mm;
        overflow: hidden;
    }
    .vel1-bottom-spacer {
        width: 25mm;
    }

    /* 3-digit price scaling (e.g. 139,90) */
    .price-digits-3 .vel1-price-major { font-size: 15.5mm; }
    .price-digits-3 .vel1-price-minor { font-size: 7.2mm; }
    .price-digits-3 .vel1-price-currency { font-size: 3mm; margin-top: 0.2mm; }
    .price-digits-3 .vel1-base-val { font-size: 5.2mm; }
    .price-digits-3 .vel1-price-left { width: 50mm; }
</style>

{var $vel1Classes = ($priceDigits >= 3 ? 'price-digits-3' : '')}
{var $logoMarkup = '<img class="vel1-logo-img" src="' . $logoDataUri . '" alt="Fikko market">'}
{var $flagMarkup = $flagIconDataUri ? '<img class="vel1-origin-flag-img" src="' . $flagIconDataUri . '" alt="">' : ''}
{var $brushMarkup = '<img class="vel1-save-brush" src="' . $brushDataUri . '" alt="">'}

<div class="fikko-vel1 {$vel1Classes}">
    <div class="vel1-logo-col">
        {$logoMarkup|noescape}
        <div class="vel1-logo-divider"></div>
        <div class="vel1-brand-text">
            <div>Fikko</div>
            <div>Cena</div>
        </div>
    </div>

    <div class="vel1-content-col">
        <div class="vel1-prod-name">{$labelName}</div>

        <table class="vel1-meta-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel1-meta-left">
                    <div n:if="$country" class="vel1-origin-box">
                        <div class="vel1-origin-flag-cell">{$flagMarkup|noescape}</div>
                        <div class="vel1-origin-text-cell">
                            <span class="vel1-origin-label">Země původu</span>
                            <span class="vel1-origin-name">{$country->name}</span>
                        </div>
                    </div>
                </td>
                <td class="vel1-meta-center">
                    <div n:if="$note1">{$note1}</div>
                </td>
                <td class="vel1-meta-right">
                    <div n:if="$label && $label->is_more_species">Více druhů</div>
                </td>
            </tr>
        </table>

        <table class="vel1-price-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel1-price-left">
                    <div n:if="$isDiscounted && $basePrice > $finalPrice" class="vel1-base-row">
                        <span class="vel1-base-label">Běžná<br>cena</span>
                        <span class="vel1-base-val">{$basePriceText} <span class="vel1-base-currency">{$currencySymbol}</span></span>
                    </div>
                    <div n:if="$isDiscounted && $saving > 0" class="vel1-save-box">
                        {$brushMarkup|noescape}
                        <table class="vel1-save-table" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td class="vel1-save-copy-cell">UŠETŘÍTE</td>
                                <td class="vel1-save-val-cell">{$savingText}&nbsp;{$currencySymbol}</td>
                                <td class="vel1-save-suffix-cell">oproti běžné ceně</td>
                            </tr>
                        </table>
                    </div>
                </td>

                <td class="vel1-price-right">
                    <div class="vel1-our-row">
                        <span class="vel1-our-label">Naše<br>cena</span>
                        <div class="vel1-main-price-box">
                            <span class="vel1-price-major">{$finalPriceMajor}</span>
                            <div class="vel1-price-minor-col">
                                <div class="vel1-price-minor">{$finalPriceMinor}</div>
                                <div class="vel1-price-currency">{$currencySymbol} / 1 ks</div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <div n:if="$unit" class="vel1-unit-price">
            cena za {$unit->unitWeight}{$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}
        </div>
    </div>

    <div class="vel1-bottom-box">
        <table class="vel1-bottom-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="vel1-barcode-cell">
                    <div n:if="$bars" class="vel1-barcode-bars">
                        <div n:foreach="$bars as $bar" style="height:100%;background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
                    </div>
                    <div class="vel1-barcode-ean">EAN: {$eanText}</div>
                </td>
                <td class="vel1-note3-cell">
                    <div n:if="$note3 || $note2">{$note3 ?: $note2}</div>
                </td>
                <td class="vel1-bottom-spacer"></td>
            </tr>
        </table>
    </div>
</div>
