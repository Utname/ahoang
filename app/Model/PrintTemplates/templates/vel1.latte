<style>
    @page { margin: 0; }
    html, body { margin: 0; padding: 0; background: #fff; color: #111; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
    .fikko-vel1 { box-sizing: border-box; position: relative; width: 150mm; height: 44mm; border: .4mm dashed #111; overflow: hidden; }
    .fikko-vel1 .logo-col { position: absolute; top: 0; left: 0; width: 32mm; height: 44mm; border-right: .4mm dashed #111; }
    .fikko-vel1 .brand { position: absolute; left: 0; width: 32mm; text-align: center; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 7.5mm; line-height: 1.05; }
    .fikko-vel1 .brand-fikko { top: 14.13mm; }
    .fikko-vel1 .brand-cena { top: 22mm; }
    .fikko-vel1 .name { position: absolute; left: 34.76mm; top: 1.76mm; width: 72.48mm; font-size: 3.6mm; font-weight: 700; line-height: 1.15; }
    .fikko-vel1 .more-species { position: absolute; left: 34.76mm; top: 10mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 3.6mm; line-height: 1.1; white-space: nowrap; }
    .fikko-vel1 .note1, .fikko-vel1 .note2 { position: absolute; left: 34.76mm; font-size: 2.4mm; white-space: nowrap; max-width: 25mm; overflow: hidden; text-overflow: ellipsis; font-weight: 700; }
    .fikko-vel1 .note1 { top: 22.15mm; }
    .fikko-vel1 .note2 { top: 25.79mm; }
    .fikko-vel1 .price-major { position: absolute; top: 15.38mm; left: 60.54mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 19mm; line-height: .85; white-space: nowrap; }
    .fikko-vel1 .price-minor { position: absolute; top: 15.5mm; left: 84.84mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 9mm; line-height: 1; white-space: nowrap; }
    .fikko-vel1 .price-currency { position: absolute; top: 26.0mm; left: 84.84mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 4.2mm; line-height: 1; white-space: nowrap; }
    .fikko-vel1 .unit { position: absolute; left: 84.84mm; top: 31.2mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 2mm; line-height: 1; white-space: nowrap; max-width: 26mm; overflow: hidden; text-overflow: ellipsis; }
    .fikko-vel1 .origin-label { position: absolute; left: 34.76mm; top: 37.34mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 2mm; white-space: nowrap; }
    .fikko-vel1 .origin-flag { position: absolute; left: 49.75mm; top: 37.04mm; width: 5.03mm; height: 3.53mm; border: .2mm solid #111; box-sizing: border-box; }
    .fikko-vel1 .origin-name { position: absolute; left: 56.27mm; top: 37.34mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 2mm; white-space: nowrap; }
    .fikko-vel1 .thawed { position: absolute; left: 74.58mm; top: 36.7mm; display: table; height: 4mm; border: .3mm solid #111; border-radius: 1mm; padding: 0 1mm; }
    .fikko-vel1 .thawed-icon { display: table-cell; width: 2.8mm; vertical-align: middle; }
    .fikko-vel1 .thawed-icon svg { display: block; width: 2.8mm; height: 2.8mm; }
    .fikko-vel1 .thawed-text { display: table-cell; vertical-align: middle; padding-left: .8mm; font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; font-size: 2mm; white-space: nowrap; }
    .fikko-vel1 .ean-text { position: absolute; right: 42.5mm; top: 38.3mm; font-size: 2mm; letter-spacing: .02em; text-align: right; white-space: nowrap; }
    .fikko-vel1 .ingredients-col { position: absolute; top: 0; right: 0; width: 40mm; height: 44mm; border-left: .4mm dashed #111; box-sizing: border-box; }
    .fikko-vel1 .ingredients-label { position: absolute; left: 112mm; top: 1.26mm; width: 36mm; font-size: 2.4mm; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; color: #555; }
    .fikko-vel1 .ingredients-text { position: absolute; left: 112mm; top: 4.4mm; width: 36mm; font-size: 2.2mm; line-height: 1.2; }
    .fikko-vel1.long-name .more-species { top: 14mm; }
    .fikko-vel1.long-name .note1 { top: 24.5mm; }
    .fikko-vel1.long-name .note2 { top: 28.1mm; }
    .fikko-vel1.price-digits-3 .note1, .fikko-vel1.price-digits-3 .note2 { max-width: 16mm; }
    .fikko-vel1.price-digits-3 .price-major { left: 52mm; font-size: 15mm; }
    .fikko-vel1.price-digits-3 .price-minor { left: 76mm; font-size: 7.5mm; }
    .fikko-vel1.price-digits-3 .price-currency { left: 76mm; top: 26.0mm; font-size: 4mm; }
    .fikko-vel1.price-digits-3 .unit { left: 76mm; top: 31.2mm; max-width: 34mm; }
</style>

{var $vel1Classes = 'fikko-vel1' . ($priceDigits >= 3 ? ' price-digits-3' : '') . ($labelNameLength > 40 ? ' long-name' : '')}
{var $flagMarkup = $flagIconDataUri ? '<img src="' . $flagIconDataUri . '" alt="" style="width:100%;height:100%;object-fit:cover">' : ''}
<section class="{$vel1Classes}">
    <div class="logo-col">
        <div class="brand brand-fikko">Fikko</div>
        <div class="brand brand-cena">Cena</div>
    </div>

    <div class="name">{$labelName}</div>
    <div n:if="$label && $label->is_more_species" class="more-species">Více druhů</div>

    <div n:if="$note1" class="note1">{$note1}</div>
    <div n:if="$note2" class="note2">{$note2}</div>

    <div class="price-major">{$finalPriceMajor}</div>
    <div class="price-minor">{$finalPriceMinor}</div>
    <div class="price-currency">Kč / 1 ks</div>
    <div n:if="$unit" class="unit">cena za {$unit->unitWeight}{$unit->unitShort} = {$unit->price|number:2,',',''} {$currencySymbol}</div>

    <div n:if="$country" class="origin-label">Země původu:</div>
    <div n:if="$country" class="origin-flag">{$flagMarkup|noescape}</div>
    <div n:if="$country" class="origin-name">{$country->name}</div>

    <div n:if="$note3" class="thawed">
        <span class="thawed-icon"><svg viewBox="0 0 24 24"><g stroke="#111" stroke-width="1.8" stroke-linecap="round" fill="none"><line x1="12" y1="2" x2="12" y2="22"></line><line x1="3.3" y1="7" x2="20.7" y2="17"></line><line x1="3.3" y1="17" x2="20.7" y2="7"></line><line x1="12" y1="2" x2="9.5" y2="4.5"></line><line x1="12" y1="2" x2="14.5" y2="4.5"></line><line x1="12" y1="22" x2="9.5" y2="19.5"></line><line x1="12" y1="22" x2="14.5" y2="19.5"></line></g></svg></span>
        <span class="thawed-text">Rozmrazeno</span>
    </div>

    <div class="ean-text">{$eanText}</div>

    <div class="ingredients-col"></div>
    <div n:if="!$hideIngredients && $product->ingredients" class="ingredients-label">Složení</div>
    <div n:if="!$hideIngredients && $product->ingredients" class="ingredients-text">{$product->ingredients|truncate:110}</div>
</section>
