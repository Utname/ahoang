<style>
    /* A5 label (210 x 148.5mm, two per A4 sheet via renderA5Page()).
       Same technique as a4-discount.latte, measured against "A5 Akce.dc.html"
       (AKCE_30) and "A5.dc.html" (comparison / plain price) printed from
       Chromium; all numbers are mm inside the label:
       - Dompdf has no flexbox and ignores box-sizing, so every block is
         absolutely positioned on a padding-free 210 x 148.5 box.
       - Single-line text uses line-height 0, where Dompdf puts the baseline
         exactly at the block's top: each top below is a reference baseline.
       - Multi-line text keeps a line-height giving the reference line pitch
         (Dompdf: pitch = line-height x natural font height, 1.2804em for
         Helvetica/DejaVu, 1.5004em for Nunito; first baseline at top +
         1.024 / 1.2 x line-height x font-size). */
    .a5 {
        position: relative;
        width: 210mm;
        height: 148.5mm;
        overflow: hidden;
        background: #fff;
        color: #111;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    .abs { position: absolute; white-space: nowrap; }
    .lh0 { line-height: 0; }
    .nu { font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; }
    .center { text-align: center; }
    .right { text-align: right; }
    .rel { position: relative; }

    .bar { position: absolute; background: #111; }
    .title { color: #fff; font-size: 12mm; letter-spacing: 0.02em; }
    .logo { position: absolute; }

    .flow { position: absolute; left: 0; width: 210mm; }
    .middle { position: relative; width: 210mm; height: 100mm; }
    .name { font-size: 5.6mm; font-weight: 400; line-height: 0.898; max-height: 12.88mm; overflow: hidden; text-align: center; }
    /* Více druhů / Poznámka 1 / 3: Sriracha bold (handoff 19.10.2026) */
    .sub { font-family: Sriracha, cursive; font-style: normal; font-weight: bold; font-size: 5mm; }
    .sri { font-family: Sriracha, cursive; font-weight: bold; font-style: normal; }

    .ribbon { position: absolute; width: 50mm; height: 18mm; transform: rotate(-1.2deg); }
    .ribbon img { position: absolute; left: 0; top: 0; width: 50mm; height: 18mm; }
    .ribbon-text { left: 0; width: 50mm; top: 13.46mm; color: #fff; font-size: 14mm; letter-spacing: -0.03em; }

    .flag { position: absolute; width: 10.7mm; height: 10.7mm; border: 0.3mm solid #111; border-radius: 50%; }
    .origin-label { font-size: 2.5mm; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }
    .origin-name { font-size: 3.8mm; font-weight: 800; }
    .ingr-label { font-size: 2.5mm; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; opacity: 0.65; }
    .ingr { position: absolute; font-weight: 400; overflow: hidden; }

    .lowest-label { font-size: 2.7mm; letter-spacing: 0.04em; text-transform: uppercase; font-weight: 700; }
    .lowest-val { font-size: 13mm; }
    .strike { position: absolute; height: 1.1mm; background: #111; border-radius: 0.55mm; }
    .regular-label { font-size: 3.1mm; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin-right: 2mm; }
    .regular-val { font-size: 9mm; }
    .our-label { font-size: 3.1mm; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; }

    .price-table { border-collapse: collapse; margin: 0 auto; }
    .price-table td { padding: 0; vertical-align: top; white-space: nowrap; }
    .price-major { letter-spacing: -0.03em; }

    .save { position: absolute; transform: rotate(-1.2deg); }
    .save-brush { position: absolute; left: 0; top: 0; }
    .save-pig { position: absolute; }
    .save-text { color: #fff; }
    .save-copy { letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; }
    .save-suffix { font-weight: 600; }

    .note3 { position: absolute; overflow: hidden; text-align: center; }
    .bars { position: absolute; height: 10mm; }
    .bars div { height: 10mm; }
    .ean { font-size: 2.9mm; letter-spacing: 0.14em; font-weight: 600; }
    .unit { font-size: 3.4mm; font-weight: 700; }
    .unit-val { font-size: 4.2mm; margin-left: 2.5mm; }
    .validity { font-size: 3mm; font-weight: 600; }
    .validity b { font-weight: 800; }
</style>

{* AKCE_30 uses the "A5 Akce" layout; comparison-price and plain-price labels use
   the "A5.dc.html" layout (the two references differ in padding, header
   position and sizes, so each has its own measured coordinates). *}
{var $akce = $isAkce30 && $basePrice > $finalPrice}
{var $isCompare = !$isAkce30 && $basePrice > $finalPrice}
{var $showSave = $basePrice > $finalPrice && $saving > 0}
{var $digits = strlen(str_replace(' ', '', $finalPriceMajor))}
{var $ps = $digits >= 4 ? 0.78 : 1}
{if $akce}
    {var $g = [
        'barL' => 32, 'barT' => 8.2, 'barW' => 169.85, 'barH' => 19.03,
        'logoW' => 18.45, 'logoH' => 16.99, 'logoL' => 11.13, 'logoT' => 10.53,
        'titleB' => 21.08, 'pad' => 8,
        'nameTop' => 30.22, 'midTop' => 36.66,
        'subB' => 42.78, 'note1B' => 48.8, 'note1Fs' => 4.5,
        'flagL' => 8, 'flagT' => 75.65, 'originX' => 21.7, 'originLB' => 79.49, 'originNB' => 83.73, 'originOp' => 1,
        'ingrLB' => 90.87, 'ingrL' => 8, 'ingrW' => 66, 'ingrFs' => 3.175, 'ingrLh' => 0.937, 'ingrTop' => 92.32, 'ingrMax' => 26.67,
        'colC' => 140, 'fsI' => 38, 'fsD' => 17, 'fsU' => 7.5, 'priceB' => 95.9, 'decRel' => -10.85, 'curRel' => -2.12, 'gapI' => 0.4,
        'saveT' => 101.3, 'saveH' => 11.9, 'padX' => 6, 'pigS' => 5.5, 'pigGap' => 2.5, 'copyFs' => 4, 'valFs' => 7.5, 'valGap' => 2, 'textRel' => 7.95,
        'note3B' => 119.7, 'note3Fs' => 4.5, 'note3Lines' => 1,
        'barsL' => 8, 'eanB' => 137.17, 'unitR' => 202, 'unitB' => 132.14,
        'ribbonT' => 55.55, 'lowT' => 60.97, 'barsT' => 124.05, 'validB' => 143.26,
    ]}
{else}
    {var $g = [
        'barL' => 33, 'barT' => 0.25, 'barW' => 168, 'barH' => 19.02,
        'logoW' => 18.48, 'logoH' => 17.02, 'logoL' => 12.2, 'logoT' => 2.66,
        'titleB' => 13.14, 'pad' => 9,
        'nameTop' => 20.69, 'midTop' => 27.13,
        'subB' => 33.51, 'note1B' => 40.08, 'note1Fs' => 5,
        'flagL' => 9, 'flagT' => 47.1, 'originX' => 22.7, 'originLB' => 51.2, 'originNB' => 55.44, 'originOp' => 0.65,
        'ingrLB' => 66.55, 'ingrL' => 9, 'ingrW' => 58, 'ingrFs' => 3.528, 'ingrLh' => 0.976, 'ingrTop' => 67.52, 'ingrMax' => 44.1,
        'colC' => 132, 'fsI' => 40, 'fsD' => 16, 'fsU' => 8, 'priceB' => 93.03, 'decRel' => -12.17, 'curRel' => -3.71, 'gapI' => 0.8,
        'saveT' => 97.85, 'saveH' => 15.5, 'padX' => 7, 'pigS' => 7.5, 'pigGap' => 3, 'copyFs' => 4.6, 'valFs' => 10.5, 'valGap' => 1.5, 'textRel' => 10.5,
        'note3B' => 122.68, 'note3Fs' => 5, 'note3Lines' => 2,
        'barsL' => 9, 'eanB' => 138.82, 'unitR' => 201, 'unitB' => 137.76,
        'ribbonT' => 57.2, 'lowT' => 62.62, 'barsT' => 125.7, 'validB' => 144.91, 'regB' => 55.46, 'ourB' => 62.07,
    ]}
{/if}
{* Positions inside .middle are relative to where it starts for a one-line
   name, so a two-line name pushes the middle content down by one line. *}
{var $m = $g['midTop']}
{* A5 Akce stacks the "-X %" ribbon (18mm + 2mm gap) above origin/Složení;
   without it the left column moves up, as in the reference's flex column. *}
{var $rb = ($akce && $hasSaleRibbon) ? 0 : ($akce ? -20 : 0)}
{* Price row / badge widths (for centering on the column and the right edge
   of the "Nejnižší cena" row) from the Dompdf font metrics, per character. *}
{var $rowW = $digits * 0.58 * $g['fsI'] * $ps + $g['gapI'] + 4.07 * $g['fsU'] * $ps}
{var $lowRight = $g['colC'] + max($rowW, 66.8) / 2}
{var $saveValText = $savingText . ' ' . $currencySymbol}
{var $saveW = $g['padX'] * 2 + $g['pigS'] + $g['pigGap'] + 6.2 * $g['copyFs'] + $g['valGap'] + mb_strlen($saveValText) * 0.536 * $g['valFs'] + ($isCompare ? 1.5 + 10.12 * 3.9 : 0)}
{var $note3Lh = 0.7665}
{* Složení: Dompdf ignores max-height, so a long text ran into the barcode. It shrinks
   to 75% of the design size, then is cut to what fits the box (~0.58em per character,
   ~85% of each line used after wrapping). *}
{var $ingrFs = $g['ingrFs']}
{var $ingrCap = (int)(floor($g['ingrW'] / ($ingrFs * 0.58)) * floor($g['ingrMax'] / ($ingrFs * $g['ingrLh'])) * 0.85)}
{while $ingrFs > $g['ingrFs'] * 0.76 && $ingrCap < mb_strlen($ingredients)}
    {var $ingrFs = $ingrFs - 0.1}
    {var $ingrCap = (int)(floor($g['ingrW'] / ($ingrFs * 0.58)) * floor($g['ingrMax'] / ($ingrFs * $g['ingrLh'])) * 0.85)}
{/while}

<div class="a5">
    <div class="bar" style="left:{$g['barL']|noescape}mm;top:{$g['barT']|noescape}mm;width:{$g['barW']|noescape}mm;height:{$g['barH']|noescape}mm"></div>
    <img class="logo" src="{$logoDataUri|nocheck}" style="left:{$g['logoL']|noescape}mm;top:{$g['logoT']|noescape}mm;width:{$g['logoW']|noescape}mm;height:{$g['logoH']|noescape}mm" alt="Fikko market">
    {* A longer header than "FIKKO CENA" shrinks to fit the bar, baseline lifted to stay centred. *}
    {var $hdrFs = min(12, ($g['barW'] - 10) / max(1, mb_strlen($headerText) * 0.7))}
    <div class="abs lh0 nu center title" style="left:{=round($g['barL'], 3)|noescape}mm;width:{=round($g['barW'], 3)|noescape}mm;top:{=round($g['titleB'] - (12 - $hdrFs) * 0.36, 3)|noescape}mm;font-size:{=round($hdrFs, 3)|noescape}mm">{$headerText|upper}</div>

    <div class="flow" style="top:{$g['nameTop']|noescape}mm">
        <div class="name" style="margin-left:{$g['pad']|noescape}mm;width:{=210 - 2 * $g['pad']|noescape}mm">{$labelName}</div>
        <div class="middle">
            <div n:if="$label && $label->is_more_species" class="abs lh0 center sub" style="left:0;width:210mm;top:{=round($g['subB'] - $m, 3)|noescape}mm">Více druhů</div>
            <div n:if="$note1" class="abs lh0 sri center" style="left:0;width:210mm;font-size:{$g['note1Fs']|noescape}mm;top:{=round($g['note1B'] - $m, 3)|noescape}mm">{$note1}</div>

            <div n:if="$akce && $hasSaleRibbon" class="ribbon" style="left:8mm;top:{=round($g['ribbonT'] - $m, 3)|noescape}mm">
                <img src="{$brushDataUri|nocheck}" alt="">
                <div class="abs lh0 nu center ribbon-text">-{$salePercent|number:0}%</div>
            </div>

            {if $country}
                <img n:if="$flagIconDataUri" class="flag" src="{$flagIconDataUri|nocheck}" style="left:{$g['flagL']|noescape}mm;top:{=round($g['flagT'] + $rb - $m, 3)|noescape}mm" alt="">
                <div class="abs lh0 origin-label" style="left:{$g['originX']|noescape}mm;top:{=round($g['originLB'] + $rb - $m, 3)|noescape}mm;opacity:{$g['originOp']|noescape}">Země původu</div>
                <div class="abs lh0 origin-name" style="left:{$g['originX']|noescape}mm;top:{=round($g['originNB'] + $rb - $m, 3)|noescape}mm">{$country->name}</div>
            {/if}

            {if !$hideIngredients && $ingredients !== ''}
                <div class="abs lh0 ingr-label" style="left:{$g['ingrL']|noescape}mm;top:{=round($g['ingrLB'] + $rb - $m, 3)|noescape}mm">Složení</div>
                <div class="ingr" style="left:{$g['ingrL']|noescape}mm;width:{$g['ingrW']|noescape}mm;top:{=round($g['ingrTop'] + $rb - $m, 3)|noescape}mm;font-size:{=round($ingrFs, 3)|noescape}mm;line-height:{$g['ingrLh']|noescape};max-height:{$g['ingrMax']|noescape}mm">{$ingredients|truncate:$ingrCap}</div>
            {/if}

            {* AKCE_30: "Nejnižší cena za 30 dní" + struck 30-day price. *}
            <table n:if="$akce" class="abs" style="left:8mm;width:{=round($lowRight - 8, 3)|noescape}mm;top:{=round($g['lowT'] - $m, 3)|noescape}mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
                <tr>
                    <td></td>
                    <td style="width:1%;padding:0 2.5mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                        <div class="lh0 lowest-label">Nejnižší cena</div>
                        <div class="lh0 lowest-label rel" style="top:3.18mm">za 30 dní</div>
                    </td>
                    <td style="width:1%;padding:0;vertical-align:top;white-space:nowrap">
                        <div class="lh0 nu lowest-val rel" style="top:4.24mm">{$lowestPrice30Text}<div class="strike" style="left:-3.5%;width:107%;top:-5.08mm;transform:rotate(-7deg)"></div></div>
                    </td>
                </tr>
            </table>
            {* SROVNANI: "Běžná cena" + regular price, never struck (CACH-LAM-CODE §3). *}
            <div n:if="$isCompare" class="abs lh0 right" style="left:0;width:191.6mm;top:{=round($g['regB'] - $m, 3)|noescape}mm"><span class="regular-label">Běžná cena</span><span class="nu regular-val">{$basePriceText}&nbsp;{$currencySymbol}</span></div>
            <div n:if="!$akce" class="abs lh0 center our-label" style="left:50mm;width:120mm;top:{=round($g['ourB'] - $m, 3)|noescape}mm">Naše cena</div>

            <div class="abs" style="left:{=round($g['colC'] - 105, 3)|noescape}mm;width:210mm;top:{=round($g['priceB'] - $m, 3)|noescape}mm">
                <table class="price-table" cellpadding="0" cellspacing="0">
                    <tr>
                        <td><div class="lh0 nu price-major" style="font-size:{=round($g['fsI'] * $ps, 3)|noescape}mm">{$finalPriceMajor}</div></td>
                        <td style="padding-left:{$g['gapI']|noescape}mm">
                            <div class="lh0 nu rel" style="font-size:{=round($g['fsD'] * $ps, 3)|noescape}mm;top:{=round($g['decRel'] * $ps, 3)|noescape}mm">{$finalPriceMinor}</div>
                            <div class="lh0 nu rel" style="font-size:{=round($g['fsU'] * $ps, 3)|noescape}mm;top:{=round($g['curRel'] * $ps, 3)|noescape}mm">{$priceUnitText ?: $currencySymbol . ' / 1 ks'}</div>
                        </td>
                    </tr>
                </table>
            </div>

            <div n:if="$showSave" class="save" style="left:{=round($g['colC'] - $saveW / 2, 3)|noescape}mm;top:{=round($g['saveT'] - $m, 3)|noescape}mm;width:{=round($saveW, 3)|noescape}mm;height:{$g['saveH']|noescape}mm">
                <img class="save-brush" src="{$brushDataUri|nocheck}" style="width:{=round($saveW, 3)|noescape}mm;height:{$g['saveH']|noescape}mm" alt="">
                <img class="save-pig" src="{$pigFaceIconDataUri|nocheck}" style="left:{$g['padX']|noescape}mm;top:{=round(($g['saveH'] - $g['pigS']) / 2, 3)|noescape}mm;width:{$g['pigS']|noescape}mm;height:{$g['pigS']|noescape}mm" alt="">
                <div class="abs lh0 save-text" style="left:{=round($g['padX'] + $g['pigS'] + $g['pigGap'], 3)|noescape}mm;top:{$g['textRel']|noescape}mm"><span class="save-copy" style="font-size:{$g['copyFs']|noescape}mm">Ušetříte</span><span class="nu" style="font-size:{$g['valFs']|noescape}mm;margin-left:{$g['valGap']|noescape}mm">{$saveValText}</span><span n:if="$isCompare" class="save-suffix" style="font-size:3.9mm;margin-left:1.5mm">oproti běžné ceně</span></div>
            </div>
        </div>
    </div>

    {if $note3 || $note2}
        {if $g['note3Lines'] > 1}
            <div class="note3 sri" style="left:30mm;width:150mm;font-size:{$g['note3Fs']|noescape}mm;line-height:{$note3Lh|noescape};max-height:11.5mm;top:{=round($g['note3B'] - 1.2 * $note3Lh * $g['note3Fs'], 3)|noescape}mm">{$note3 ?: $note2}</div>
        {else}
            <div class="abs lh0 sri center" style="left:30mm;width:150mm;font-size:{$g['note3Fs']|noescape}mm;top:{$g['note3B']|noescape}mm">{$note3 ?: $note2}</div>
        {/if}
    {/if}

    <div n:if="$bars" class="bars" style="left:{$g['barsL']|noescape}mm;top:{$g['barsT']|noescape}mm">
        <div n:foreach="$bars as $bar" n:if="$bar['dark']" style="position:absolute;top:0;left:{$bar['left']|noescape};background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
    </div>
    <div n:if="$eanText" class="abs lh0 ean" style="left:{$g['barsL']|noescape}mm;top:{$g['eanB']|noescape}mm">EAN {$eanText}</div>

    <div n:if="$unit" class="abs lh0 right unit" style="left:0;width:{$g['unitR']|noescape}mm;top:{$g['unitB']|noescape}mm">Cena za {$unit->unitWeight} {$unit->unitShort}<span class="nu unit-val">{$unit->price|number:2,',',' '}&nbsp;{$currencySymbol}</span></div>

    {* "Akce platí do" only on AKCE_30 (CACH-LAM-CODE §3). *}
    <div n:if="!$hideValidity && ($akce || $validityCustom)" class="abs lh0 center validity" style="left:0;width:210mm;top:{$g['validB']|noescape}mm">{if $validityCustom}{$validityText}{elseif $validityUntil}Akce platí do <b>{$validityUntil}</b> nebo do vyprodání zásob{else}Akce platí do vyprodání zásob{/if}</div>
</div>
