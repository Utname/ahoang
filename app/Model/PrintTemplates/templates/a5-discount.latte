<style>
    @page { size: A4; margin: 0; }
    html, body { margin: 0; padding: 0; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; background: #fff; color: #111; -webkit-font-smoothing: antialiased; }
    * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    .a5-half {
        box-sizing: border-box;
        width: 210mm;
        height: 148.5mm;
        padding: 0;
        background: #fff;
        color: #111;
        overflow: hidden;
        position: relative;
    }

    .a5-header {
        display: table;
        width: 210mm;
        height: 18mm;
        background: #111;
        color: #fff;
    }
    .a5-logo-cell {
        display: table-cell;
        width: 22mm;
        height: 18mm;
        background: #fff;
        text-align: center;
        vertical-align: middle;
        padding: 1mm;
    }
    .a5-logo-cell img {
        width: 20mm;
        height: 16mm;
        object-fit: contain;
        display: block;
        margin: 0 auto;
    }
    .a5-title-cell {
        display: table-cell;
        vertical-align: middle;
        text-align: center;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 11.5mm;
        line-height: 1;
        letter-spacing: 0.02em;
        color: #fff;
        padding-right: 22mm;
    }

    .a5-content {
        width: 194mm;
        margin: 1.5mm auto 0 auto;
    }

    .a5-prod-name {
        font-size: 5.5mm;
        line-height: 1.15;
        font-weight: 400;
        text-align: center;
        padding-bottom: 0.5mm;
    }

    .a5-subtitle-row {
        text-align: center;
        padding-bottom: 0.5mm;
    }
    .a5-more-species {
        font-family: Nunito, sans-serif;
        font-weight: 400;
        font-style: italic;
        font-size: 5.8mm;
        line-height: 1.1;
    }
    .a5-note1 {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 4.3mm;
        line-height: 1.1;
        white-space: nowrap;
        margin-top: 0.2mm;
    }

    .a5-main-table {
        width: 194mm;
        border-collapse: collapse;
        margin-top: 0;
    }
    .a5-left-col {
        vertical-align: top;
        width: 66mm;
        padding-right: 3mm;
    }

    .a5-ribbon-badge {
        position: relative;
        width: 50mm;
        height: 18mm;
        margin-bottom: 1.5mm;
        transform: rotate(-1.2deg);
    }
    .a5-ribbon-brush {
        position: absolute;
        top: 0;
        left: 0;
        width: 50mm;
        height: 18mm;
        z-index: 0;
    }
    .a5-ribbon-table {
        position: relative;
        z-index: 1;
        width: 50mm;
        height: 18mm;
        border-collapse: collapse;
    }
    .a5-ribbon-text-cell {
        vertical-align: middle;
        text-align: center;
        color: #fff;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 14mm;
        line-height: 0.9;
        letter-spacing: -0.03em;
        padding-bottom: 1.5mm;
    }

    .a5-origin-box {
        display: table;
        white-space: nowrap;
        margin-bottom: 1mm;
    }
    .a5-origin-flag-cell {
        display: table-cell;
        width: 11mm;
        vertical-align: middle;
    }
    .a5-origin-flag-img {
        width: 10.7mm;
        height: 10.7mm;
        display: block;
        border: 0.3mm solid #111;
        border-radius: 50%;
    }
    .a5-origin-text-cell {
        display: table-cell;
        padding-left: 2.5mm;
        vertical-align: middle;
        white-space: nowrap;
    }
    .a5-origin-label {
        font-size: 2.5mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        color: #111;
        white-space: nowrap;
    }
    .a5-origin-name {
        font-size: 3.8mm;
        font-weight: 800;
        line-height: 1.1;
        white-space: nowrap;
    }

    .a5-ingredients-box {
        margin-top: 0.5mm;
    }
    .a5-ingredients-label {
        font-size: 2.5mm;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        opacity: 0.65;
    }
    .a5-ingredients-text {
        font-size: 8.5pt;
        line-height: 1.15;
        font-weight: 400;
        max-height: 15mm;
        overflow: hidden;
    }

    .a5-right-col {
        vertical-align: top;
        text-align: center;
    }

    .a5-price-col {
        text-align: center;
    }

    .a5-lowest-box {
        position: relative;
        text-align: right;
        padding-right: 12mm;
        margin-bottom: 0.8mm;
        white-space: nowrap;
    }
    .a5-lowest-label {
        display: inline-block;
        vertical-align: middle;
        font-size: 2.7mm;
        line-height: 1.2;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 700;
        color: #111;
        text-align: right;
        margin-right: 2.5mm;
    }
    .a5-strike-wrap { position: absolute; left: 0; top: 0; width: 0; height: 0; overflow: visible; display: inline-block; }
    .a5-lowest-val-box {
        position: relative;
        display: inline-block;
        vertical-align: middle;
    }
    .a5-lowest-val {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 13mm;
        line-height: 1;
        color: #111;
    }
    .a5-lowest-strike-img {
        position: absolute;
        left: -2mm;
        top: 7.5mm;
        height: 6.5mm;
    }

    .a5-main-price {
        display: table;
        margin: 0 auto;
        white-space: nowrap;
    }
    .a5-price-major {
        display: table-cell;
        vertical-align: top;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 38mm;
        line-height: 0.82;
        letter-spacing: -0.03em;
    }
    .a5-price-minor-col {
        display: table-cell;
        vertical-align: top;
        padding-left: 1.5mm;
        text-align: left;
    }
    .a5-price-minor {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 17mm;
        line-height: 0.9;
    }
    .a5-price-currency {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 7.5mm;
        line-height: 0.9;
        white-space: nowrap;
        margin-top: 1mm;
    }

    .a5-save-box {
        position: relative;
        width: 76mm;
        height: 10.5mm;
        margin: 0.5mm auto 0 auto;
        color: #fff;
    }
    .a5-save-brush {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }
    .a5-save-inner {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 10.5mm;
        text-align: center;
    }
    .a5-save-table {
        height: 10.5mm;
        border-collapse: collapse;
        margin: 0 auto;
    }
    .a5-save-pig-cell {
        vertical-align: middle;
        text-align: right;
        padding-right: 2mm;
    }
    .a5-save-pig {
        display: block;
        width: 5.5mm;
        height: 5.5mm;
    }
    .a5-save-copy-cell {
        vertical-align: middle;
        text-align: left;
        white-space: nowrap;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 4mm;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #fff;
        line-height: 1;
        padding-right: 2mm;
    }
    .a5-save-val-cell {
        vertical-align: middle;
        text-align: left;
        white-space: nowrap;
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 7.5mm;
        line-height: 1;
        color: #fff;
    }

    .a5-note3-box {
        text-align: center;
        padding-top: 1mm;
        padding-bottom: 0.5mm;
        clear: both;
    }
    .a5-note3-text {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 4.5mm;
        line-height: 1.1;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
    }

    .a5-bottom-table {
        width: 194mm;
        border-collapse: collapse;
        margin-top: 0.5mm;
    }
    .a5-barcode-cell {
        vertical-align: bottom;
        width: 50mm;
        text-align: left;
    }
    .a5-barcode-bars {
        height: 7.5mm;
        margin-bottom: 0.4mm;
        white-space: nowrap;
    }
    .a5-barcode-bars > div {
        float: left;
        height: 100%;
    }
    .a5-barcode-ean {
        font-size: 2.9mm;
        letter-spacing: 0.14em;
        font-weight: 600;
    }

    .a5-unit-cell {
        vertical-align: bottom;
        text-align: right;
        font-size: 3.4mm;
        font-weight: 700;
        white-space: nowrap;
    }
    .a5-unit-val {
        font-family: Nunito, sans-serif;
        font-weight: 900;
        font-style: italic;
        font-size: 4.2mm;
        margin-left: 2.5mm;
    }

    .a5-validity-box {
        text-align: center;
        padding-top: 0.8mm;
        font-size: 3mm;
        font-weight: 600;
        white-space: nowrap;
    }
    .a5-validity-val {
        font-weight: 800;
    }

    .price-digits-3 .a5-price-major { font-size: 31mm; }
    .price-digits-3 .a5-price-minor { font-size: 14mm; }
    .price-digits-3 .a5-price-currency { margin-top: 1.5mm; font-size: 6.5mm; }
    .price-digits-3 .a5-lowest-box { padding-right: 9mm; }
</style>

{var $a5Classes = 'a5-half' . ($priceDigits >= 3 ? ' price-digits-3' : '')}
{var $logoMarkup = '<img src="' . $logoDataUri . '" alt="Fikko market">'}
{var $flagMarkup = $flagIconDataUri ? '<img class="a5-origin-flag-img" src="' . $flagIconDataUri . '" alt="">' : ''}
{var $brushMarkup = '<img class="a5-save-brush" src="' . $brushDataUri . '" alt="">'}
{var $ribbonBrushMarkup = '<img class="a5-ribbon-brush" src="' . $brushDataUri . '" alt="">'}
{var $pigMarkup = '<img class="a5-save-pig" src="' . $pigIconDataUri . '" alt="">'}
{var $strikeWidth = (strlen($basePriceText) <= 4 ? '32mm' : (strlen($basePriceText) <= 5 ? '38mm' : (strlen($basePriceText) <= 6 ? '48mm' : '58mm')))}
{var $strikeMarkup = '<img class="a5-lowest-strike-img" src="' . $strikeSlashDataUri . '" style="width:' . $strikeWidth . '" alt="">'}

<div class="{$a5Classes}">
    <header class="a5-header">
        <div class="a5-logo-cell">
            {$logoMarkup|noescape}
        </div>
        <div class="a5-title-cell">
            FIKKO CENA
        </div>
    </header>

    <div class="a5-content">
        <div class="a5-prod-name">{$labelName}</div>

        <div n:if="($label && $label->is_more_species) || $note1" class="a5-subtitle-row">
            <div n:if="$label && $label->is_more_species" class="a5-more-species">Více druhů</div>
            <div n:if="$note1" class="a5-note1">{$note1}</div>
        </div>

        <table class="a5-main-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="a5-left-col">
                    <div n:if="$hasSaleRibbon" class="a5-ribbon-badge">
                        {$ribbonBrushMarkup|noescape}
                        <table class="a5-ribbon-table" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td class="a5-ribbon-text-cell">-{$salePercent|number:0}%</td>
                            </tr>
                        </table>
                    </div>

                    <div n:if="$country" class="a5-origin-box">
                        <div class="a5-origin-flag-cell">{$flagMarkup|noescape}</div>
                        <div class="a5-origin-text-cell">
                            <div class="a5-origin-label">Země původu</div>
                            <div class="a5-origin-name">{$country->name}</div>
                        </div>
                    </div>

                    <div n:if="!$hideIngredients && $product->ingredients" class="a5-ingredients-box">
                        <div class="a5-ingredients-label">Složení</div>
                        <div class="a5-ingredients-text">{$product->ingredients|truncate:200}</div>
                    </div>
                </td>

                <td class="a5-right-col">
                    <div class="a5-price-col">
                        <div n:if="$isDiscounted && $basePrice > $finalPrice" class="a5-lowest-box">
                            <div class="a5-lowest-label">NEJNIŽŠÍ CENA<br>ZA 30 DNÍ</div>
                            <div class="a5-lowest-val-box">
                                <span class="a5-lowest-val">{$basePriceText}</span><span class="a5-strike-wrap">{$strikeMarkup|noescape}</span>
                            </div>
                        </div>

                        <div class="a5-main-price">
                            <div class="a5-price-major">{$finalPriceMajor}</div>
                            <div class="a5-price-minor-col">
                                <div class="a5-price-minor">{$finalPriceMinor}</div>
                                <div class="a5-price-currency">{$currencySymbol} / 1 ks</div>
                            </div>
                        </div>

                        <div n:if="$saving > 0" class="a5-save-box">
                            {$brushMarkup|noescape}
                            <div class="a5-save-inner">
                                <table class="a5-save-table" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td class="a5-save-pig-cell">
                                            {$pigMarkup|noescape}
                                        </td>
                                        <td class="a5-save-copy-cell">
                                            UŠETŘÍTE
                                        </td>
                                        <td class="a5-save-val-cell">
                                            {$savingText}&nbsp;{$currencySymbol}
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <div n:if="$note3 || $note2" class="a5-note3-box">
            <div class="a5-note3-text">{$note3 ?: $note2}</div>
        </div>

        <table class="a5-bottom-table" cellpadding="0" cellspacing="0">
            <tr>
                <td class="a5-barcode-cell">
                    <div n:if="$bars" class="a5-barcode-bars">
                        <div n:foreach="$bars as $bar" style="height:100%;background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
                    </div>
                    <div class="a5-barcode-ean">EAN {$eanText}</div>
                </td>
                <td class="a5-unit-cell">
                    <div n:if="$unit">
                        <span>Cena za {$unit->unitWeight} {$unit->unitShort}</span>
                        <span class="a5-unit-val">{$unit->price|number:2,',',' '} {$currencySymbol}</span>
                    </div>
                </td>
            </tr>
        </table>

        <div n:if="!$hideValidity && $validityText" class="a5-validity-box">
            Akce platí do <span class="a5-validity-val">{$validityText}</span> nebo do vyprodání zásob
        </div>
    </div>
</div>
