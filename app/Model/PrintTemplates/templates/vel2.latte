<style>
    /* Vel.2 label, 133 x 41mm. Measured against "vel. 2.dc.html" printed from
       Chromium; numbers are mm from the card's inner (inside-border) corner.
       - Dompdf ignores box-sizing and draws the 0.4mm border outside
         width/height, so the box is 132.2 x 40.2 to come out 133 x 41.
       - No flexbox/grid in Dompdf: blocks are absolutely positioned.
       - Single-line text uses line-height 0, where Dompdf puts the baseline
         exactly at the block's top, so each top below is a reference baseline.
       - The reference price row is a 1fr | divider | 1fr grid: the comparison
         group is right-aligned against the divider, "Naše cena" starts just
         right of it. */
    .fikko-vel2 {
        position: relative;
        width: 132.2mm;
        height: 40.2mm;
        border: 0.4mm dashed #111;
        background: #fff;
        color: #111;
        overflow: hidden;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    .abs { position: absolute; white-space: nowrap; }
    .lh0 { line-height: 0; }
    .nu { font-family: Nunito, sans-serif; font-weight: 900; font-style: italic; }
    .nu4 { font-family: Nunito, sans-serif; font-weight: 400; font-style: italic; }
    .center { text-align: center; }
    .right { text-align: right; }
    .rel { position: relative; }

    .logo-col { position: absolute; left: 0; top: 0; width: 23.6mm; height: 40.2mm; border-right: 0.4mm dashed #111; }
    .logo { position: absolute; left: 6.77mm; top: 2.31mm; width: 10.55mm; height: 9.72mm; }
    .logo-divider { position: absolute; left: 1.5mm; top: 14.1mm; width: 20.6mm; border-top: 0.3mm dashed #111; }
    .brand { left: 0; width: 23.6mm; font-size: 5.8mm; }

    .name { left: 27mm; width: 102.3mm; top: 3.69mm; font-size: 3.4mm; font-weight: 400; }
    .flag { position: absolute; left: 26.8mm; top: 5.37mm; width: 5.5mm; height: 5.5mm; border: 0.25mm solid #111; border-radius: 50%; }
    .origin-label { left: 34.4mm; top: 7.13mm; font-size: 1.9mm; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }
    .origin-name { left: 34.4mm; top: 10.3mm; font-size: 2.9mm; font-weight: 800; }
    .meta { top: 8.98mm; font-size: 2.4mm; }

    .base-label { font-size: 2.2mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }
    .base-val { font-size: 6.5mm; }
    .base-cur { font-size: 4mm; }
    .strike { position: absolute; left: -3.5%; width: 107%; top: -2.54mm; height: 0.55mm; background: #111; border-radius: 0.28mm; transform: rotate(-7deg); }

    .save { position: absolute; top: 21.54mm; height: 6.1mm; transform: rotate(-1.2deg); }
    .save-brush { position: absolute; left: 0; top: 0; height: 6.1mm; }
    .save-text { left: 2.5mm; top: 3.84mm; color: #fff; }
    .save-copy { font-size: 2mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }
    .save-val { font-size: 4.2mm; margin-left: 1mm; }
    .save-suffix { font-size: 1.8mm; font-weight: 600; margin-left: 1mm; }

    .divider { position: absolute; left: 77.8mm; top: 13.03mm; width: 0.3mm; height: 14.8mm; background: #111; }

    .our-label { font-size: 2.2mm; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }

    .unit { left: 0; width: 129.3mm; top: 31.2mm; font-size: 2.2mm; }
    .bars { position: absolute; left: 26.8mm; top: 32.62mm; height: 4.5mm; }
    .bars div { float: left; height: 4.5mm; }
    .ean { left: 26.9mm; top: 38.88mm; font-size: 2mm; font-weight: 600; letter-spacing: 0.04em; }
    .note3 { left: 28.1mm; width: 100mm; top: 34.91mm; font-size: 2.2mm; }
</style>

{var $compare = $basePrice > $finalPrice}
{var $digits = strlen(str_replace(' ', '', $finalPriceMajor))}
{* "Naše cena" group: label + integer (19mm) + ",90" / "Kč / 1 ks" column.
   Its width is estimated from the Dompdf font metrics; the price shrinks
   when it would not fit next to the comparison group (3+ digits). *}
{var $ourAvail = $compare ? 47 : 100}
{var $ps = min(1, ($ourAvail - 8.3) / ($digits * 0.58 * 19 + 1 + 14.8))}
{var $fsI = round(19 * $ps, 3)}
{var $fsD = round(8.5 * $ps, 3)}
{var $fsU = round(3.6 * $ps, 3)}
{var $groupW = 8.3 + ($digits * 0.58 * 19 + 1 + 14.8) * $ps}
{var $ourL = $compare ? 81.7 : 78.15 - $groupW / 2}
{var $saveValText = $savingText . ' ' . $currencySymbol}
{var $saveW = 2.5 + 11.8 + 1 + mb_strlen($saveValText) * 0.536 * 4.2 + ($isAkce30 ? 0 : 1 + 18.2) + 2.5}

<div class="fikko-vel2">
    <div class="logo-col">
        <img class="logo" src="{$logoDataUri|nocheck}" alt="Fikko market">
        <div class="logo-divider"></div>
        <div class="abs lh0 nu center brand" style="top:20.36mm">Fikko</div>
        <div class="abs lh0 nu center brand" style="top:26.44mm">Cena</div>
    </div>

    <div class="abs lh0 center name">{$labelName|truncate:58}</div>

    {if $country}
        <img n:if="$flagIconDataUri" class="flag" src="{$flagIconDataUri|nocheck}" alt="">
        <div class="abs lh0 origin-label">Země původu</div>
        <div class="abs lh0 origin-name">{$country->name}</div>
    {/if}
    <div n:if="$note1" class="abs lh0 nu4 center meta" style="left:28.05mm;width:100mm">{$note1}</div>
    <div n:if="$label && $label->is_more_species" class="abs lh0 nu4 right meta" style="left:29.3mm;width:100mm">Více druhů</div>

    {* AKCE_30 keeps this layout but shows the 30-day lowest price struck
       through instead of "Běžná cena", without the divider and the
       "oproti běžné ceně" suffix (CACH-LAM-CODE section 3). *}
    {if $compare}
        <table class="abs" style="left:0;width:74.4mm;top:15.33mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
            <tr>
                <td></td>
                <td style="width:1%;padding:0 1.5mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                    {if $isAkce30}
                        <div class="lh0 base-label">Nejnižší cena</div>
                        <div class="lh0 base-label rel" style="top:2.38mm">za 30 dní</div>
                    {else}
                        <div class="lh0 base-label">Běžná</div>
                        <div class="lh0 base-label rel" style="top:2.38mm">cena</div>
                    {/if}
                </td>
                <td style="width:1%;padding:0;vertical-align:top;white-space:nowrap">
                    <div class="lh0 nu base-val rel" style="top:2.64mm">{$isAkce30 ? $lowestPrice30Text : $basePriceText}&nbsp;<span class="base-cur">{$currencySymbol}</span><div n:if="$isAkce30" class="strike"></div></div>
                </td>
            </tr>
        </table>

        <div n:if="$saving > 0" class="save" style="left:{=round(74.4 - $saveW, 3)|noescape}mm;width:{=round($saveW, 3)|noescape}mm">
            <img class="save-brush" src="{$brushDataUri|nocheck}" style="width:{=round($saveW, 3)|noescape}mm" alt="">
            <div class="abs lh0 save-text"><span class="save-copy">Ušetříte</span><span class="nu save-val">{$saveValText}</span><span n:if="!$isAkce30" class="save-suffix">oproti běžné ceně</span></div>
        </div>

        <div n:if="!$isAkce30" class="divider"></div>
    {/if}

    <table class="abs" style="left:{=round($ourL, 3)|noescape}mm;top:19.3mm;border-collapse:collapse" cellpadding="0" cellspacing="0">
        <tr>
            <td style="padding:0 1.5mm 0 0;vertical-align:top;text-align:right;white-space:nowrap">
                <div class="lh0 our-label">Naše</div>
                <div class="lh0 our-label rel" style="top:2.64mm">cena</div>
            </td>
            <td style="padding:0;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsI|noescape}mm;position:relative;top:{=round(6.88 * $ps, 3)|noescape}mm">{$finalPriceMajor}</div>
            </td>
            <td style="padding:0 0 0 1mm;vertical-align:top;white-space:nowrap">
                <div class="lh0 nu" style="font-size:{$fsD|noescape}mm;position:relative;top:{=round(-0.53 * $ps, 3)|noescape}mm">{$finalPriceMinor}</div>
                <div class="lh0 nu" style="font-size:{$fsU|noescape}mm;position:relative;top:{=round(4.49 * $ps, 3)|noescape}mm">{$currencySymbol} / 1 ks</div>
            </td>
        </tr>
    </table>

    <div n:if="$unit" class="abs lh0 nu4 right unit">cena za {$unit->unitWeight}{$unit->unitShort} = {$unit->price|number:2,',',' '} {$currencySymbol}</div>

    <div n:if="$bars" class="bars">
        <div n:foreach="$bars as $bar" style="background:{$bar['color']|noescape};width:{$bar['width']|noescape}"></div>
    </div>
    <div class="abs lh0 ean">EAN: {$eanText}</div>
    <div n:if="$note3 || $note2" class="abs lh0 nu4 center note3">{$note3 ?: $note2}</div>
</div>
