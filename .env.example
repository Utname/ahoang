# Copy this file to .env and fill in real values for this environment, or set
# these as real process/container environment variables instead (preferred on
# most hosting — .env is only a fallback for setups that can't do that; see
# app/Bootstrap.php's loadEnvFile()). Never commit a filled-in .env.
#
# Local/dev configs (02-local.neon, fikkomarket.loc.neon, fikkomarket.local.neon)
# keep their own low-risk dev-only credentials directly in the .neon file, on
# purpose, since those are never real secrets — nothing below is needed to run
# this project locally.

# Set to exactly "production" to load config/production.neon instead of
# picking a config by domain — this is what a Railway (or similar container
# host) deploy should set; see app/Bootstrap.php for why domain-matching
# doesn't work well there. Leave unset for every other environment, including
# the existing fikkomarket.cz / fikkomarket.kolibrio.cz domain deployments,
# which still pick their config by domain as before.
APP_ENV=

# Production database user/password (config/fikkomarket*.cz.neon, and
# config/production.neon if APP_ENV=production but DB_USER/DB_PASSWORD are
# set explicitly instead of relying on Railway's MySQL plugin variables
# below).
DB_USER=
DB_PASSWORD=

# Only relevant for config/production.neon (APP_ENV=production). Railway's
# MySQL plugin injects these into every service in the same project
# automatically — you do NOT need to set these by hand on Railway. Only set
# them yourself for a non-Railway production host that doesn't provide them,
# in which case DB_USER/DB_PASSWORD above still take priority if also set.
MYSQLHOST=
MYSQLPORT=
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# SMTP account password (config/01-general.neon parameters.smtpMailer).
SMTP_PASSWORD=

# Shared secret required to trigger /cron/default (see
# app/SystemModule/Cron/Traits/BaseCronTrait.php). Generate with e.g.:
#   php -r "echo bin2hex(random_bytes(24));"
# Whatever system/service calls the cron URL on a schedule must pass the same
# value back as ?token=<value>. Leaving this unset means the cron endpoint
# always rejects requests (fails closed, not open).
CRON_SECRET=
